@page "/archive"
@implements IAsyncDisposable
@inject HttpClient Http

<PageTitle>Archive · Photo Identity</PageTitle>

<section class="hero archive-hero">
    <div>
        <p class="eyebrow">Permanent archive</p>
        <h1>Archive coverage</h1>
        <p>Add recursive folders under one stable source root, synchronize lightweight OneDrive observations, verify changed or first-time online-only sources under the bounded storage policy, and analyze exact immutable revisions with the governed CenterFace/SFace profile.</p>
    </div>
    <button class="button secondary" disabled="@Busy" @onclick="RefreshAsync">Refresh</button>
</section>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="notice error" role="alert">@Error</div>
}
@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="notice" role="status">@Message</div>
}

@if (Loading || Status is null)
{
    <section class="empty-state" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading archive status…</p>
    </section>
}
else
{
    <section class="archive-configuration" aria-labelledby="archive-configuration-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Coverage</p>
                <h2 id="archive-configuration-heading">@(Status.Configured ? Status.RootName ?? "Configured archive" : "Configure archive")</h2>
            </div>
            @if (Status.Configured)
            {
                <button class="button secondary" disabled="@Busy" @onclick="SyncAsync">Sync included folders</button>
            }
        </div>

        <div class="archive-form-grid">
            @if (!Status.Configured)
            {
                <div>
                    <label class="field-label" for="archive-root">Permanent archive root</label>
                    <input id="archive-root" @bind="RootPath" disabled="@Busy" placeholder="C:\…\Kamerabilder" />
                    <p class="field-help">This root becomes the permanent source identity for this catalogue.</p>
                </div>
            }
            <div>
                <label class="field-label" for="archive-folder">Folder to include</label>
                <input id="archive-folder" @bind="RelativeFolder" disabled="@Busy" placeholder="1970/01" />
                <p class="field-help">Use a root-relative folder. A parent such as <code>1970</code> automatically subsumes included month folders.</p>
            </div>
            <div class="archive-form-action">
                <button class="button primary" disabled="@(Busy || string.IsNullOrWhiteSpace(RelativeFolder) || (!Status.Configured && string.IsNullOrWhiteSpace(RootPath)))" @onclick="IncludeAsync">
                    Add folder
                </button>
            </div>
        </div>

        @if (Status.IncludedFolders.Count > 0)
        {
            <div class="coverage-chips" aria-label="Included archive folders">
                @foreach (string folder in Status.IncludedFolders)
                {
                    <span class="coverage-chip">@(string.IsNullOrEmpty(folder) ? "." : folder)</span>
                }
            </div>
        }
    </section>

    <section class="archive-summary" aria-label="Archive availability summary">
        <article>
            <span>Current images</span>
            <strong>@Status.Totals.CurrentImages</strong>
        </article>
        <article>
            <span>Local</span>
            <strong>@Status.Totals.LocalImages</strong>
        </article>
        <article class="@(Status.Totals.OnlineOnlyImages > 0 ? "attention" : null)">
            <span>Online-only</span>
            <strong>@Status.Totals.OnlineOnlyImages</strong>
        </article>
        <article class="@(Status.Totals.DownloadingImages > 0 ? "attention" : null)">
            <span>Downloading</span>
            <strong>@Status.Totals.DownloadingImages</strong>
        </article>
        <article class="@(Status.Totals.AvailabilityErrorImages + Status.Totals.UnavailableImages > 0 ? "attention" : null)">
            <span>Availability issues</span>
            <strong>@(Status.Totals.AvailabilityErrorImages + Status.Totals.UnavailableImages)</strong>
        </article>
        <article>
            <span>Analyzed</span>
            <strong>@AnalysisCount(Status.Totals.AnalysedImages)</strong>
        </article>
        <article>
            <span>Pending</span>
            <strong>@AnalysisCount(Status.Totals.PendingImages)</strong>
        </article>
        <article class="@(Status.Totals.NeedsSourceVerificationImages > 0 ? "attention" : null)">
<span>Needs verification</span>
<strong>@Status.Totals.NeedsSourceVerificationImages</strong>
        </article>
        <article class="@(Status.Totals.UnverifiedSourceImages > 0 ? "attention" : null)">
<span>First verification</span>
<strong>@Status.Totals.UnverifiedSourceImages</strong>
        </article>        <article class="@(Status.Totals.FailedImages > 0 ? "attention" : null)">
            <span>Failed</span>
            <strong>@AnalysisCount(Status.Totals.FailedImages)</strong>
        </article>
        <article>
            <span>Missing</span>
            <strong>@Status.Totals.MissingImages</strong>
        </article>
    </section>

    @if (Status.Totals.OnlineOnlyImages + Status.Totals.DownloadingImages > 0)
    {
        <div class="notice warning">
            OneDrive placeholders are catalogued without opening their content. Use Advance archive to request only the verification or analysis hydration that is needed; Photo Identity applies the configured storage budget and releases only content it hydrated.
        </div>
    }

    <section class="archive-analysis" aria-labelledby="archive-analysis-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Governed profile</p>
                <h2 id="archive-analysis-heading">Archive analysis</h2>
            </div>
            @if (Status.Advancement?.IsRunning == true)
            {
                <button class="button secondary" disabled="@Busy" @onclick="PauseAdvancementAsync">Pause archive</button>
            }
            else
            {
                <button class="button primary" disabled="@(Busy || !Status.Configured || !Status.AnalysisReady)" @onclick="AnalyzePendingAsync">Advance archive</button>
            }
        </div>

        <dl class="profile-details">
            <div><dt>Detector</dt><dd>@Status.DetectorModelId · confidence @Status.DetectorConfidence</dd></div>
            <div><dt>Embedder</dt><dd>@Status.EmbedderModelId</dd></div>
            <div><dt>Profile</dt><dd><code>@(Status.ProfileHash is null ? "unavailable" : HashPrefix(Status.ProfileHash))</code></dd></div>
            <div><dt>Archive advancement</dt><dd>@AdvancementLabel(Status.Advancement)</dd></div>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Status.Advancement?.Message))
        {
            <div class="notice">@Status.Advancement.Message</div>
        }

        @if (!Status.AnalysisReady)
        {
            <div class="notice warning">@Status.AnalysisMessage</div>
        }

        @if (Status.LatestRun is ArchiveRunStatusResponse run)
        {
            <div class="run-progress">
                <div>
                    <span>Latest run</span>
                    <code>@run.RunId</code>
                </div>
                <div>
                    <span>Status</span>
                    <strong>@run.Status</strong>
                </div>
                <div>
                    <span>Progress</span>
                    <strong>@(run.SucceededJobs + run.FailedJobs + run.CancelledJobs) / @run.TotalJobs</strong>
                </div>
                <div>
                    <span>Queued</span>
                    <strong>@run.QueuedJobs</strong>
                </div>
            </div>
        }
    </section>

    <section class="archive-folders" aria-labelledby="archive-folders-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Included coverage</p>
                <h2 id="archive-folders-heading">Folder status</h2>
            </div>
        </div>

        @if (Status.Folders.Count == 0)
        {
            <div class="empty-state compact">
                <p>No archive folders are included yet.</p>
            </div>
        }
        else
        {
            <div class="archive-table-wrap">
                <table class="archive-table">
                    <thead>
                        <tr>
                            <th>Folder</th>
                            <th>Current</th>
                            <th>Local</th>
                            <th>Online-only</th>
                            <th>Downloading</th>
                            <th>Analyzed</th>
                            <th>Pending</th>
                            <th>Failed</th>
                            <th>Needs verify</th>
                            <th>First verify</th>
                            <th>Missing</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ArchiveFolderStatusResponse folder in Status.Folders)
                        {
                            <tr>
                                <td><code>@(string.IsNullOrEmpty(folder.RelativeFolder) ? "." : folder.RelativeFolder)</code></td>
                                <td>@folder.CurrentImages</td>
                                <td>@folder.LocalImages</td>
                                <td class="@(folder.OnlineOnlyImages > 0 ? "failure-count" : null)">@folder.OnlineOnlyImages</td>
                                <td>@folder.DownloadingImages</td>
                                <td>@AnalysisCount(folder.AnalysedImages)</td>
                                <td>@AnalysisCount(folder.PendingImages)</td>
                                <td class="@(folder.FailedImages > 0 ? "failure-count" : null)">@AnalysisCount(folder.FailedImages)</td>
                                <td class="@(folder.NeedsSourceVerificationImages > 0 ? "failure-count" : null)">@folder.NeedsSourceVerificationImages</td>
                                <td class="@(folder.UnverifiedSourceImages > 0 ? "failure-count" : null)">@folder.UnverifiedSourceImages</td>
                                <td>@folder.MissingImages</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="archive-items" aria-labelledby="archive-items-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Image drill-down</p>
                <h2 id="archive-items-heading">Archive items</h2>
            </div>
            <span>@(ItemPage?.Total ?? 0) matching image@((ItemPage?.Total ?? 0) == 1 ? "" : "s")</span>
        </div>

        <div class="archive-item-filters">
            <div>
                <label class="field-label" for="archive-item-folder">Folder</label>
                <select id="archive-item-folder" @bind="ItemFolder" @bind:after="ApplyItemFiltersAsync" disabled="@(Busy || ItemLoading)">
                    <option value="">All included coverage</option>
                    @foreach (string folder in Status.IncludedFolders)
                    {
                        <option value="@folder">@(string.IsNullOrEmpty(folder) ? "." : folder)</option>
                    }
                </select>
            </div>
            <div>
                <label class="field-label" for="archive-item-state">State</label>
                <select id="archive-item-state" @bind="ItemState" @bind:after="ApplyItemFiltersAsync" disabled="@(Busy || ItemLoading)">
                    <option value="all">All states</option>
                    <option value="pending">Pending analysis</option>
                    <option value="failed">Processing failed</option>
                    <option value="needs-source-verification">Needs source verification</option>
                    <option value="unverified">First source verification</option>
                    <option value="unavailable">Not local</option>
                    <option value="missing">Missing</option>
                    <option value="analysed">Analyzed</option>
                </select>
            </div>
        </div>

        @if (ItemLoading)
        {
            <div class="empty-state compact"><p>Loading archive items…</p></div>
        }
        else if (ItemPage is null || ItemPage.Items.Count == 0)
        {
            <div class="empty-state compact"><p>No images match this archive scope.</p></div>
        }
        else
        {
            <div class="archive-table-wrap">
                <table class="archive-table archive-item-table">
                    <thead>
                        <tr>
                            <th>Relative path</th>
                            <th>Availability</th>
                            <th>Source verification</th>
                            <th>Analysis</th>
                            <th>Latest error</th>
                            <th>View</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ArchiveItemStatusResponse item in ItemPage.Items)
                        {
                            <tr>
                                <td><code>@item.RelativePath</code></td>
                                <td><span class="archive-state state-@CssToken(item.Availability)">@AvailabilityLabel(item.Availability)</span></td>
                                <td><span class="archive-state state-@CssToken(item.SourceVerificationState)">@SourceVerificationLabel(item.SourceVerificationState)</span></td>
                                <td><span class="archive-state state-@CssToken(item.AnalysisState)">@AnalysisStateLabel(item.AnalysisState)</span></td>
                                <td class="archive-item-error">@(string.IsNullOrWhiteSpace(item.LastError) ? "—" : item.LastError)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.RevisionId))
                                    {
                                        <a class="button secondary" href="@($"/photo/{item.RevisionId}")">View</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination">
                <button class="button secondary" disabled="@(ItemPage.Offset == 0 || ItemLoading)" @onclick="PreviousItemsAsync">Previous</button>
                <span>Showing @(ItemPage.Offset + 1)–@Math.Min(ItemPage.Offset + ItemPage.Items.Count, ItemPage.Total)</span>
                <button class="button secondary" disabled="@(ItemPage.Offset + ItemPage.Limit >= ItemPage.Total || ItemLoading)" @onclick="NextItemsAsync">Next</button>
            </div>
        }
    </section>
}

@code {
    private const int ItemPageSize = 50;

    private ArchiveStatusResponse? Status { get; set; }
    private ArchiveItemPageResponse? ItemPage { get; set; }
    private string RootPath { get; set; } = string.Empty;
    private string RelativeFolder { get; set; } = string.Empty;
    private string ItemFolder { get; set; } = string.Empty;
    private string ItemState { get; set; } = "all";
    private int ItemOffset { get; set; }
    private string? Error { get; set; }
    private string? Message { get; set; }
    private bool Loading { get; set; } = true;
    private bool ItemLoading { get; set; }
    private bool Busy { get; set; }
    private CancellationTokenSource? AdvancementPolling { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        StartAdvancementPollingIfNeeded();
    }

    private async Task RefreshAsync()
    {
        await LoadAsync();
        if (Status?.Configured == true)
        {
            await LoadItemsAsync();
        }
    }

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            Status = await Http.GetFromJsonAsync<ArchiveStatusResponse>("api/archive/status");
        }
        catch (Exception exception)
        {
            Error = $"Archive status could not be loaded: {exception.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task LoadItemsAsync()
    {
        if (Status?.Configured != true)
        {
            ItemPage = null;
            return;
        }

        ItemLoading = true;
        try
        {
            string query = $"state={Uri.EscapeDataString(ItemState)}&folder={Uri.EscapeDataString(ItemFolder)}&offset={ItemOffset}&limit={ItemPageSize}";
            ItemPage = await Http.GetFromJsonAsync<ArchiveItemPageResponse>($"api/archive/items?{query}");
        }
        catch (Exception exception)
        {
            Error = $"Archive items could not be loaded: {exception.Message}";
        }
        finally
        {
            ItemLoading = false;
        }
    }

    private async Task IncludeAsync()
    {
        Busy = true;
        Error = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "api/archive/include",
                new ArchiveIncludeRequest(Status?.Configured == true ? null : RootPath, RelativeFolder));
            Status = await ReadResponseAsync<ArchiveStatusResponse>(response);
            Message = $"Included '{RelativeFolder}'.";
            RelativeFolder = string.Empty;
            ItemOffset = 0;
            await LoadItemsAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task SyncAsync()
    {
        Busy = true;
        Error = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsync("api/archive/sync", content: null);
            ArchiveSyncResponse result = await ReadResponseAsync<ArchiveSyncResponse>(response);
            Status = result.Status;
            Message = $"Sync complete: {result.NewRevisions} new revision(s), {result.UnchangedFiles} unchanged local, {result.NeedsSourceVerification} needing re-verification, {result.UnverifiedSources} awaiting first verification, {result.OnlineOnlyFiles} online-only, {result.DownloadingFiles} downloading, {result.AvailabilityErrors + result.UnavailableFiles} availability issue(s), {result.MarkedMissing} marked missing.";
            ItemOffset = 0;
            await LoadItemsAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task AnalyzePendingAsync()
    {
        Busy = true;
        Error = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsync("api/archive/advance/start", content: null);
            Status = await ReadResponseAsync<ArchiveStatusResponse>(response);
            Message = "Archive advancement started. Synchronization, OneDrive waits, analysis, proxy generation and managed release will continue without additional clicks.";
            await LoadItemsAsync();
            StartAdvancementPollingIfNeeded();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task PauseAdvancementAsync()
    {
        Busy = true;
        Error = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsync("api/archive/advance/pause", content: null);
            Status = await ReadResponseAsync<ArchiveStatusResponse>(response);
            Message = "Archive advancement paused. Durable completed work is retained.";
            StopAdvancementPolling();
            await LoadItemsAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void StartAdvancementPollingIfNeeded()
    {
        if (Status?.Advancement?.IsRunning != true || AdvancementPolling is not null)
        {
            return;
        }

        AdvancementPolling = new CancellationTokenSource();
        _ = PollAdvancementAsync(AdvancementPolling.Token);
    }

    private async Task PollAdvancementAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                Status = await Http.GetFromJsonAsync<ArchiveStatusResponse>("api/archive/status", cancellationToken);
                if (Status?.Configured == true)
                {
                    await LoadItemsAsync();
                }
                await InvokeAsync(StateHasChanged);

                if (Status?.Advancement?.IsRunning != true)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Error = $"Archive progress polling stopped: {exception.Message}";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            AdvancementPolling?.Dispose();
            AdvancementPolling = null;
        }
    }

    private void StopAdvancementPolling() => AdvancementPolling?.Cancel();

    private async Task ApplyItemFiltersAsync()
    {
        ItemOffset = 0;
        await LoadItemsAsync();
    }

    private async Task PreviousItemsAsync()
    {
        ItemOffset = Math.Max(0, ItemOffset - ItemPageSize);
        await LoadItemsAsync();
    }

    private async Task NextItemsAsync()
    {
        ItemOffset += ItemPageSize;
        await LoadItemsAsync();
    }

    private async Task<T> ReadResponseAsync<T>(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return await response.Content.ReadFromJsonAsync<T>()
                ?? throw new InvalidOperationException("The archive API returned an empty response.");
        }

        ArchiveErrorResponse? error = null;
        try
        {
            error = await response.Content.ReadFromJsonAsync<ArchiveErrorResponse>();
        }
        catch
        {
            // Fall through to the HTTP status when the server response is not JSON.
        }

        throw new InvalidOperationException(error?.Error ?? $"Archive operation failed with HTTP {(int)response.StatusCode}.");
    }

    private string AnalysisCount(int value) => Status?.AnalysisReady == true ? value.ToString() : "—";

    private static string AvailabilityLabel(string availability) => availability switch
    {
        "local" => "Local",
        "online-only" => "Online-only",
        "downloading" => "Downloading",
        "unavailable" => "Unavailable",
        "error" => "Availability error",
        _ => availability,
    };

    private static string SourceVerificationLabel(string state) => state switch
    {
        "verified" => "Verified",
        "needs-source-verification" => "Needs verification",
        "unverified" => "First verification",
        _ => state,
    };
    private static string AnalysisStateLabel(string state) => state switch
    {
        "analysed" => "Analyzed",
        "pending" => "Pending",
        "failed" => "Failed",
        "unavailable" => "Not local",
        "needs-source-verification" => "Needs source verification",
        "unverified" => "First source verification",
        "missing" => "Missing",
        _ => state,
    };

    private static string CssToken(string value) => value.Replace("-", string.Empty, StringComparison.Ordinal);

    private static string HashPrefix(string hash) =>
        hash[..Math.Min(12, hash.Length)];

    private static string AdvancementLabel(ArchiveAdvancementStatusResponse? advancement) => advancement?.State switch
    {
        "queued" => "Queued",
        "syncing" => "Synchronizing",
        "running" => "Running",
        "waiting" => "Waiting for OneDrive",
        "blocked" => "Blocked",
        "paused" => "Paused",
        "complete" => "Complete",
        null => "Not started",
        _ => advancement.State,
    };

    public ValueTask DisposeAsync()
    {
        StopAdvancementPolling();
        return ValueTask.CompletedTask;
    }
}
