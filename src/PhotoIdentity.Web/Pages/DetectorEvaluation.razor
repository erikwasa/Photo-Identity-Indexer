@page "/detector-evaluation"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Detector evaluation · Photo Identity</PageTitle>

<section class="detector-evaluation-hero">
    <div>
        <p class="eyebrow">Photo-level detector review</p>
        <h1>Evaluate detections in context</h1>
        <p>
            Browse complete source photos in stable filename order, then create a private evaluation session from
            the completed manifest. Sessions keep detector judgements and missed-face ground truth separate from
            identity review.
        </p>
    </div>

    <aside class="detector-evaluation-note">
        <strong>Private ground truth</strong>
        <p>
            Session files are stored outside the catalogue in the configured detector-evaluation root. The browser
            receives photo names and boxes, but never source roots or session storage paths.
        </p>
    </aside>
</section>

<section class="detector-evaluation-controls" aria-label="Detector evaluation controls">
    <div>
        <label class="field-label" for="evaluation-run">Processing run</label>
        <select id="evaluation-run"
                @bind="SelectedRunId"
                @bind:after="ChangeRunAsync"
                disabled="@(Loading || Runs.Count == 0)">
            @foreach (DetectorEvaluationRunResponse run in Runs)
            {
                <option value="@run.Id">@RunLabel(run)</option>
            }
        </select>
    </div>

    @if (SelectedRun is DetectorEvaluationRunResponse selectedRun)
    {
        <div class="detector-run-summary">
            <span><strong>@selectedRun.PhotoCount</strong> photos</span>
            <span><strong>@selectedRun.DetectionCount</strong> detections</span>
            <span class="state-badge">@selectedRun.Status</span>
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="notice error" role="alert">@Error</div>
}

@if (!string.IsNullOrWhiteSpace(Success))
{
    <div class="notice success" role="status">@Success</div>
}

@if (Runs.Count > 0)
{
    <section class="detector-session-panel" aria-label="Detector evaluation sessions">
        <div class="detector-session-list">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Resume</p>
                    <h2>Evaluation sessions</h2>
                </div>
                <span>@Sessions.Count session@(Sessions.Count == 1 ? "" : "s")</span>
            </div>

            @if (Sessions.Count == 0)
            {
                <p class="detector-session-empty">No private evaluation session exists for this run yet.</p>
            }
            else
            {
                <div class="detector-session-links">
                    @foreach (DetectorEvaluationSessionSummaryResponse session in Sessions)
                    {
                        <article>
                            <div>
                                <strong>@session.Name</strong>
                                <span>
                                    @session.CompletedPhotoCount / @session.PhotoCount photos complete ·
                                    updated @session.UpdatedAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
                                </span>
                            </div>
                            <button class="button secondary" @onclick="() => OpenSession(session.Id)">Resume</button>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="detector-session-creator">
            <p class="eyebrow">Create</p>
            <h2>Import the private manifest</h2>
            <p>
                Export the Photo Review sheet as CSV UTF-8. Required columns are Sample ID, Image Name,
                Source Group, Primary Category and Countable Faces. The image names must exactly match this run.
            </p>

            <label class="field-label" for="session-name">Session name</label>
            <input id="session-name"
                   @bind="SessionName"
                   placeholder="M16 confidence 0.9 baseline"
                   disabled="@CreatingSession" />

            <label class="field-label manifest-label" for="manifest-file">Manifest CSV</label>
            <InputFile id="manifest-file"
                       OnChange="ReadManifestAsync"
                       accept=".csv,text/csv"
                       disabled="@CreatingSession" />

            @if (ManifestEntries.Count > 0)
            {
                <p class="manifest-summary">
                    <strong>@ManifestFileName</strong><br />
                    @ManifestEntries.Count manifest rows parsed.
                </p>
            }

            <button class="button primary"
                    disabled="@(CreatingSession || ManifestEntries.Count == 0 || string.IsNullOrWhiteSpace(SessionName))"
                    @onclick="CreateSessionAsync">
                @(CreatingSession ? "Creating…" : "Create evaluation session")
            </button>
        </div>
    </section>
}

@if (Loading)
{
    <section class="empty-state" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading detector evaluation photos…</p>
    </section>
}
else if (Runs.Count == 0)
{
    <section class="empty-state">
        <h2>No processing runs</h2>
        <p>Process an isolated evaluation set, then reopen this page.</p>
    </section>
}
else if (Photos.Count == 0)
{
    <section class="empty-state">
        <h2>No photos in this run</h2>
        <p>Select another processing run or inspect the batch status.</p>
    </section>
}
else
{
    <div class="detector-page-summary" role="status">
        <span>@PageLabel</span>
        <span>Read-only preview of persisted detector observations.</span>
    </div>

    <section class="detector-photo-list" aria-label="Photos with detector overlays">
        @foreach (DetectorEvaluationPhotoResponse photo in Photos)
        {
            <article class="detector-photo-card">
                <header>
                    <div>
                        <h2>@photo.PhotoName</h2>
                        <p>
                            @DimensionLabel(photo) · @photo.Detections.Count detection@(photo.Detections.Count == 1 ? "" : "s")
                        </p>
                    </div>
                    <span class="state-badge">@photo.JobStatus</span>
                </header>

                <div class="detector-photo-stage">
                    <img src="@photo.ContentUrl"
                         alt="Source photo @photo.PhotoName with detector overlays"
                         loading="lazy" />
                    @foreach (DetectorEvaluationDetectionResponse detection in photo.Detections)
                    {
                        <div class="detector-box"
                             style="@BoxStyle(detection.BoundingBox)"
                             title="Detection @detection.FaceNumber, confidence @ConfidenceLabel(detection.Confidence)">
                            <span>@detection.FaceNumber · @ConfidenceLabel(detection.Confidence)</span>
                        </div>
                    }
                </div>

                <footer>
                    <span>Revision <code>@photo.RevisionHashPrefix…</code></span>
                    <a href="@photo.ContentUrl" target="_blank" rel="noopener">Open original</a>
                </footer>
            </article>
        }
    </section>

    <nav class="pagination" aria-label="Detector evaluation pagination">
        <button class="button secondary"
                disabled="@(Loading || Offset == 0)"
                @onclick="PreviousPageAsync">
            Previous photos
        </button>
        <button class="button primary"
                disabled="@(Loading || Offset + Photos.Count >= Total)"
                @onclick="NextPageAsync">
            Next photos
        </button>
    </nav>
}

@code {
    private const int PageSize = 8;
    private const long MaximumManifestBytes = 5 * 1024 * 1024;

    private List<DetectorEvaluationRunResponse> Runs { get; } = [];
    private List<DetectorEvaluationPhotoResponse> Photos { get; } = [];
    private List<DetectorEvaluationSessionSummaryResponse> Sessions { get; } = [];
    private List<DetectorEvaluationManifestEntryRequest> ManifestEntries { get; } = [];
    private string SelectedRunId { get; set; } = string.Empty;
    private string SessionName { get; set; } = string.Empty;
    private string? ManifestFileName { get; set; }
    private int Offset { get; set; }
    private int Total { get; set; }
    private bool Loading { get; set; }
    private bool CreatingSession { get; set; }
    private string? Error { get; set; }
    private string? Success { get; set; }

    private DetectorEvaluationRunResponse? SelectedRun =>
        Runs.FirstOrDefault(run => string.Equals(run.Id, SelectedRunId, StringComparison.Ordinal));

    private string PageLabel => Total == 0
        ? "No photos"
        : $"Photos {Offset + 1}–{Math.Min(Offset + Photos.Count, Total)} of {Total}";

    protected override async Task OnInitializedAsync()
    {
        await LoadRunsAsync();
    }

    private async Task LoadRunsAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            DetectorEvaluationRunResponse[]? runs = await Http.GetFromJsonAsync<DetectorEvaluationRunResponse[]>(
                "/api/detector-evaluation/runs");
            Runs.Clear();
            if (runs is not null)
            {
                Runs.AddRange(runs);
            }

            DetectorEvaluationRunResponse? preferred = Runs.FirstOrDefault(
                run => string.Equals(run.Status, "completed", StringComparison.OrdinalIgnoreCase));
            SelectedRunId = preferred?.Id ?? Runs.FirstOrDefault()?.Id ?? string.Empty;
            Offset = 0;

            if (!string.IsNullOrWhiteSpace(SelectedRunId))
            {
                await LoadPhotosCoreAsync();
                await LoadSessionsCoreAsync();
            }
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task ChangeRunAsync()
    {
        Offset = 0;
        ManifestEntries.Clear();
        ManifestFileName = null;
        Success = null;
        await LoadPhotosAsync();
    }

    private async Task PreviousPageAsync()
    {
        Offset = Math.Max(0, Offset - PageSize);
        await LoadPhotosAsync(loadSessions: false);
    }

    private async Task NextPageAsync()
    {
        Offset += PageSize;
        await LoadPhotosAsync(loadSessions: false);
    }

    private async Task LoadPhotosAsync(bool loadSessions = true)
    {
        Loading = true;
        Error = null;
        try
        {
            await LoadPhotosCoreAsync();
            if (loadSessions)
            {
                await LoadSessionsCoreAsync();
            }
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task LoadPhotosCoreAsync()
    {
        string url = $"/api/detector-evaluation/photos?runId={Uri.EscapeDataString(SelectedRunId)}&offset={Offset}&limit={PageSize}";
        DetectorEvaluationPhotoPageResponse? page = await Http.GetFromJsonAsync<DetectorEvaluationPhotoPageResponse>(url);
        Photos.Clear();
        if (page is not null)
        {
            Photos.AddRange(page.Items);
            Total = page.Total;
        }
        else
        {
            Total = 0;
        }
    }

    private async Task LoadSessionsCoreAsync()
    {
        DetectorEvaluationSessionSummaryResponse[]? sessions =
            await Http.GetFromJsonAsync<DetectorEvaluationSessionSummaryResponse[]>(
                $"/api/detector-evaluation/sessions?runId={Uri.EscapeDataString(SelectedRunId)}");
        Sessions.Clear();
        if (sessions is not null)
        {
            Sessions.AddRange(sessions);
        }
    }

    private async Task ReadManifestAsync(InputFileChangeEventArgs args)
    {
        Error = null;
        Success = null;
        ManifestEntries.Clear();
        ManifestFileName = args.File.Name;
        try
        {
            await using Stream stream = args.File.OpenReadStream(MaximumManifestBytes);
            using StreamReader reader = new(stream);
            string csv = await reader.ReadToEndAsync();
            ManifestEntries.AddRange(DetectorEvaluationManifestCsv.Parse(csv));
            if (string.IsNullOrWhiteSpace(SessionName))
            {
                SessionName = Path.GetFileNameWithoutExtension(args.File.Name);
            }
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
    }

    private async Task CreateSessionAsync()
    {
        CreatingSession = true;
        Error = null;
        Success = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "/api/detector-evaluation/sessions",
                new CreateDetectorEvaluationSessionRequest(
                    SessionName,
                    SelectedRunId,
                    ManifestEntries.ToArray()));
            if (!response.IsSuccessStatusCode)
            {
                Error = await ReadErrorAsync(response);
                return;
            }

            DetectorEvaluationSessionSummaryResponse? created =
                await response.Content.ReadFromJsonAsync<DetectorEvaluationSessionSummaryResponse>();
            if (created is null)
            {
                Error = "The evaluation session was created but the response was empty.";
                return;
            }

            Navigation.NavigateTo($"/detector-evaluation/sessions/{created.Id}");
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            CreatingSession = false;
        }
    }

    private void OpenSession(string sessionId) =>
        Navigation.NavigateTo($"/detector-evaluation/sessions/{sessionId}");

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        string content = await response.Content.ReadAsStringAsync();
        try
        {
            using JsonDocument document = JsonDocument.Parse(content);
            if (document.RootElement.TryGetProperty("error", out JsonElement error))
            {
                return error.GetString() ?? response.ReasonPhrase ?? "The request failed.";
            }
        }
        catch (JsonException)
        {
        }

        return string.IsNullOrWhiteSpace(content)
            ? response.ReasonPhrase ?? "The request failed."
            : content;
    }

    private static string RunLabel(DetectorEvaluationRunResponse run) =>
        $"{run.StartedAtUtc.ToLocalTime():g} · {run.Status} · {run.PhotoCount} photos";

    private static string DimensionLabel(DetectorEvaluationPhotoResponse photo) =>
        photo.Width is int width && photo.Height is int height
            ? $"{width} × {height}"
            : photo.MediaType;

    private static string ConfidenceLabel(double confidence) =>
        confidence.ToString("P1", CultureInfo.InvariantCulture);

    private static string BoxStyle(DetectorEvaluationBoundingBoxResponse box) =>
        FormattableString.Invariant(
            $"left:{box.X * 100:0.####}%;top:{box.Y * 100:0.####}%;width:{box.Width * 100:0.####}%;height:{box.Height * 100:0.####}%;");
}
