@page "/quality-suggestions"

<PageTitle>Quality suggestions · Photo Identity</PageTitle>

<div class="quality-review-screen" tabindex="0" @ref="ReviewSurface" aria-keyshortcuts="1 2 3 ArrowLeft ArrowRight"
     @onkeydown="HandleKeyboardAsync" aria-label="Photo quality review workspace">
    <header class="quality-review-toolbar">
        <div class="quality-review-heading">
            <strong>Archive quality review</strong>
            <span class="quality-review-subtitle">1 Keep · 2 Dismiss · 3 Consider · ← / → Navigate</span>
        </div>
        <div class="quality-toolbar-actions">
            <label>Reason
                <select @bind="Reason" @bind:after="FiltersChangedAsync"
                        @onkeydown:stopPropagation="true" disabled="@Busy">
                    @foreach (QualityOption option in ReasonOptions)
                    {
                        <option value="@option.Code">@option.Name</option>
                    }
                </select>
            </label>
            <label>Status
                <select @bind="Filter" @bind:after="FiltersChangedAsync"
                        @onkeydown:stopPropagation="true" disabled="@Busy">
                    <option value="unreviewed">Not reviewed</option>
                    <option value="all">All suggestions</option>
                    <option value="consider-exclusion">Consider exclusion</option>
                </select>
            </label>
            <button type="button" class="button secondary" aria-expanded="@ShowScanSettings"
                    @onclick="ToggleScanSettings">@(ShowScanSettings ? "Hide scan options" : "Scan options")</button>
            <a class="quality-review-exit" href="/archive">Close review</a>
        </div>
    </header>

    @if (ShowScanSettings)
    {
        <section class="quality-scan-drawer" aria-label="Quality suggestion scan options">
            <div class="quality-scan-head">
                <strong>Scan existing local photo proxies</strong>
                <button type="button" class="button secondary" @onclick="ToggleScanSettings">Close</button>
            </div>
            <div class="quality-scan-options">
                <label>Batch size
                    <select @bind="BatchSize" @onkeydown:stopPropagation="true" disabled="@Busy">
                        <option value="100">100</option>
                        <option value="500">500</option>
                        <option value="1000">1,000</option>
                        <option value="5000">5,000</option>
                    </select>
                </label>
                <button type="button" class="button secondary"
                        disabled="@(Busy || Page?.ScanComplete == true)"
                        @onclick="ScanNextAsync">Scan next batch</button>
                <button type="button" class="button secondary"
                        disabled="@(Busy || Page?.ScanComplete == true)"
                        @onclick="ScanAllAsync">Scan all remaining</button>
                @if (ScanningAll)
                {
                    <button type="button" class="button secondary"
                            @onclick="CancelScanning">Stop after current batch</button>
                }
                <button type="button" class="button secondary"
                        disabled="@Busy" @onclick="RestartScanAsync">Start scan over</button>
            </div>
            <p class="quality-scan-summary">
                @((Page?.Scanned ?? 0).ToString("N0")) proxies scanned ·
                @(Page?.Suggested ?? 0) suggestions ·
                @(Page?.ScanComplete == true ? "Complete" : "More available") ·
                next position @(Page?.NextScanOffset ?? 0).
                Only existing local review proxies are read; originals and saved collections are unchanged.
            </p>
        </section>
    }

    <section class="quality-photo-stage" aria-label="Photo under review">
        @if (Loading)
        {
            <p>Loading suggestions…</p>
        }
        else if (Page is not null && !Page.Enabled)
        {
            <div class="quality-empty-review">
                <p>Archive cleanup review was disabled in an earlier version.</p>
                <button type="button" class="button secondary"
                        @onclick="EnableArchiveAsync">Enable Archive cleanup review</button>
            </div>
        }
        else if (Current is QualitySuggestionItem photo)
        {
            <img src="@photo.ProxyUrl" alt="Entire photo being reviewed for technical quality" />
        }
        else
        {
            <div class="quality-empty-review">
                <p>@(Page?.GeneratedAtUtc is null
                    ? "No suggestions scanned yet. Open Scan options to get started."
                    : "Nothing matches this reason/status filter. Change filters or scan the next batch.")</p>
                <button type="button" class="button secondary" @onclick="ToggleScanSettings">Scan options</button>
            </div>
        }
    </section>

    <footer class="quality-review-footer">
        <div class="quality-review-metadata">
            <span>@(Page?.Total ?? 0) matching · @(Page?.ReviewedInScope ?? 0) reviewed ·
                @(Page?.ConsiderExclusionInScope ?? 0) considered</span>
            <span>@(Page is null || Page.Total == 0 ? 0 : Offset + 1) / @(Page?.Total ?? 0)</span>
        </div>
        <div class="quality-review-reasons" aria-label="Reasons for suggestion">
            @if (Current is QualitySuggestionItem current)
            {
                @foreach (QualityReason reason in current.Reasons)
                {
                    <span class="coverage-chip">@reason.Label</span>
                }
                @if (current.Decision is not null)
                {
                    <span class="quality-choice">Saved: @DecisionLabel(current.Decision)</span>
                }
            }
        </div>
        <div class="quality-review-buttons">
            <button type="button" class="button secondary" disabled="@(Busy || Current is null)"
                    @onclick="() => KeepAsync(Current!.RevisionId)">1 · Keep</button>
            <button type="button" class="button secondary" disabled="@(Busy || Current is null)"
                    @onclick="() => DismissAsync(Current!.RevisionId)">2 · Dismiss</button>
            <button type="button" class="button secondary" disabled="@(Busy || Current is null)"
                    @onclick="() => ConsiderAsync(Current!.RevisionId)">3 · Consider</button>
            <span class="quality-button-divider" aria-hidden="true"></span>
            <button type="button" class="button secondary"
                    disabled="@(Busy || Offset == 0 || Page?.Total is null || Page.Total == 0)"
                    @onclick="PreviousAsync">← Previous</button>
            <button type="button" class="button secondary"
                    disabled="@(Busy || Page is null || Offset + 1 >= Page.Total)"
                    @onclick="NextAsync">Next →</button>
            <button type="button" class="button danger" disabled="@(Busy || Current is null)"
                    @onclick="OpenCurrentExclusion">Exclude photo…</button>
            @if (Current is QualitySuggestionItem currentPhoto)
            {
                <a class="quality-photo-link" href="@currentPhoto.PhotoUrl"
                   target="_blank" rel="noopener noreferrer">Open full photo</a>
            }
        </div>
    </footer>

    @if (PendingExclusion is not null)
    {
        <div class="quality-modal-backdrop">
            <section class="quality-exclusion-modal" role="dialog" aria-modal="true"
                     aria-labelledby="quality-purge-title"
                     aria-describedby="quality-purge-description">
                <h2 id="quality-purge-title">Exclude this photo from Photo Identity?</h2>
                <p id="quality-purge-description">This permanently purges this source copy's locally retained
                    review proxies, face links and metadata from Photo Identity. Its OneDrive original remains
                    untouched. This is not a reversible collection hide.</p>
                <p><strong>Only an explicit click on Confirm exclude &amp; purge performs this action.</strong></p>
                <div class="quality-modal-actions">
                    <button type="button" class="button secondary" disabled="@Busy" @ref="ModalCancelButton"
                            @onclick="CancelExclude">Cancel</button>
                    <button type="button" class="button danger" disabled="@Busy"
                            @onclick="ConfirmExcludeAsync">Confirm exclude &amp; purge</button>
                </div>
            </section>
        </div>
    }

    @if (Error is not null || Message is not null)
    {
        <div class="quality-review-notice" role="status">
            <span>@(Error ?? Message)</span>
            <button type="button" aria-label="Dismiss notification" @onclick="DismissNotice">×</button>
        </div>
    }
</div>

@code {
    private const string ArchiveScope = "archive-cleanup";
    private sealed record QualityOption(string Code, string Name);
    private sealed record QualityReason(string Code, string Label);
    private sealed record QualitySuggestionItem(
        string RevisionId, List<QualityReason> Reasons, string? Decision,
        string ProxyUrl, string PhotoUrl);
    private sealed record QualityPage(
        int Scanned, DateTimeOffset? GeneratedAtUtc, int Suggested,
        Dictionary<string, bool> EnabledScopes, string Scope, bool Enabled,
        string Reason, string Filter, int Total, int Offset,
        List<QualitySuggestionItem> Items, int ReviewedInScope,
        int ConsiderExclusionInScope, int NextScanOffset, bool ScanComplete);
    private sealed record ScanResult(
        int ProcessedThisBatch, int ScannedCurrentProxyCandidates,
        int Suggested, int NextScanOffset, bool ScanComplete);
    private static readonly QualityOption[] ReasonOptions =
    [
        new("all", "All candidate reasons"),
        new("candidate-low-sharpness", "Possible blur or missed focus"),
        new("candidate-severe-underexposure", "Severe underexposure"),
        new("candidate-severe-overexposure", "Severe overexposure"),
        new("candidate-shadow-clipping", "Shadow clipping"),
        new("candidate-highlight-clipping", "Highlight clipping"),
        new("candidate-low-contrast", "Low contrast"),
        new("candidate-low-effective-proxy-resolution", "Low resolution")
    ];

    private QualityPage? Page;
    private QualitySuggestionItem? Current => Page?.Items.FirstOrDefault();
    private string Reason = "all";
    private string Filter = "unreviewed";
    private string? Message;
    private string? Error;
    private string? PendingExclusion;
    private int Offset;
    private int BatchSize = 1000;
    private bool Busy;
    private bool Loading = true;
    private bool ScanningAll;
    private bool StopAfterBatch;
    private ElementReference ReviewSurface;
    private ElementReference ModalCancelButton;
    private bool ShowScanSettings;
    private bool HasRendered;
    private bool FocusModalOnRender;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Blazor handles keyboard events on its own focused review surface,
        // without a fragile page-specific JS module. Focus is kept within
        // the viewport and never scrolls the original document.
        HasRendered = true;
        if (FocusModalOnRender)
        {
            FocusModalOnRender = false;
            await ModalCancelButton.FocusAsync(preventScroll: true);
        }
        else if (firstRender)
        {
            await ReviewSurface.FocusAsync(preventScroll: true);
        }
    }

    private async Task HandleKeyboardAsync(KeyboardEventArgs args)
    {
        if (PendingExclusion is not null)
        {
            if (args.Key == "Escape" && !Busy)
                await CancelExclude();
            return;
        }
        if (args.AltKey || args.CtrlKey || args.MetaKey ||
            Busy || Loading || Current is null)
            return;
        switch (args.Key)
        {
            case "1": await DecideAsync(Current.RevisionId, "keep"); break;
            case "2": await DecideAsync(Current.RevisionId, "dismiss"); break;
            case "3": await DecideAsync(Current.RevisionId, "consider-exclusion"); break;
            case "ArrowLeft": await PreviousAsync(); break;
            case "ArrowRight": await NextAsync(); break;
        }
    }

    private void ToggleScanSettings() => ShowScanSettings = !ShowScanSettings;
    private void DismissNotice() { Error = null; Message = null; }

    private static string DecisionLabel(string? value) => value switch
    {
        "keep" => "Keep",
        "dismiss" => "Dismiss",
        "consider-exclusion" => "Consider exclusion",
        _ => "Not reviewed"
    };

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            string url = "api/quality-suggestions?scope=" + ArchiveScope
                + "&reason=" + Uri.EscapeDataString(Reason)
                + "&filter=" + Uri.EscapeDataString(Filter)
                + "&offset=" + Offset.ToString(System.Globalization.CultureInfo.InvariantCulture)
                + "&limit=1";
            Page = await Http.GetFromJsonAsync<QualityPage>(url)
                ?? throw new InvalidOperationException("Suggestion queue unavailable.");
            if (Page.Total > 0 && Offset >= Page.Total)
            {
                Offset = Math.Max(0, Page.Total - 1);
                Page = await Http.GetFromJsonAsync<QualityPage>(
                    "api/quality-suggestions?scope=" + ArchiveScope +
                    "&reason=" + Uri.EscapeDataString(Reason) +
                    "&filter=" + Uri.EscapeDataString(Filter) +
                    "&offset=" + Offset + "&limit=1");
            }
        }
        catch (Exception e) { Error = "Unable to load suggestions: " + e.Message; }
        finally { Loading = false; }
        // A select may still own focus after its value changes. Re-enable
        // 1/2/3 and arrow shortcuts automatically without requiring a click.
        if (HasRendered && PendingExclusion is null)
            await ReviewSurface.FocusAsync(preventScroll: true);
    }

    private Task FiltersChangedAsync()
    {
        Offset = 0;
        PendingExclusion = null;
        return LoadAsync();
    }

    private async Task<ScanResult> RunBatchAsync(string mode)
    {
        using HttpResponseMessage response = await Http.PostAsync(
            "api/quality-suggestions/scan?mode=" + mode + "&limit=" + BatchSize, null);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<ScanResult>()
            ?? throw new InvalidOperationException("Scan response missing.");
    }

    private async Task ScanNextAsync() => await ScanAsync("next");
    private async Task RestartScanAsync() => await ScanAsync("restart");
    private async Task ScanAsync(string mode)
    {
        Busy = true;
        Error = null;
        try
        {
            ScanResult result = await RunBatchAsync(mode);
            Message = $"Scanned {result.ScannedCurrentProxyCandidates:N0} current proxies, " +
                $"found {result.Suggested:N0} suggestions. " +
                (result.ScanComplete ? "Entire eligible archive scanned." : "More batches available.");
            Offset = 0;
            await LoadAsync();
        }
        catch (Exception e) { Error = "Scan failed: " + e.Message; }
        finally { Busy = false; }
    }

    private async Task ScanAllAsync()
    {
        Busy = true;
        ScanningAll = true;
        StopAfterBatch = false;
        Error = null;
        try
        {
            ScanResult result;
            do
            {
                result = await RunBatchAsync("next");
                Message = $"Scanned {result.ScannedCurrentProxyCandidates:N0} existing proxies. " +
                    $"{result.Suggested:N0} suggestions. " +
                    (result.ScanComplete ? "Complete." : "Scanning further batches…");
                await InvokeAsync(StateHasChanged);
            }
            while (!result.ScanComplete && !StopAfterBatch);
            Offset = 0;
            await LoadAsync();
        }
        catch (Exception e) { Error = "Full scan stopped: " + e.Message; }
        finally { Busy = false; ScanningAll = false; }
    }

    private void CancelScanning() => StopAfterBatch = true;

    private Task KeepAsync(string id) => DecideAsync(id, "keep");
    private Task DismissAsync(string id) => DecideAsync(id, "dismiss");
    private Task ConsiderAsync(string id) => DecideAsync(id, "consider-exclusion");

    private async Task DecideAsync(string revisionId, string decision)
    {
        if (Busy || PendingExclusion is not null) return;
        Busy = true;
        Error = null;
        try
        {
            using HttpResponseMessage response = await Http.PutAsJsonAsync(
                "api/quality-suggestions/review/" + Uri.EscapeDataString(revisionId),
                new { scope = ArchiveScope, decision });
            response.EnsureSuccessStatusCode();
            if (Filter == "all") Offset++;
            Message = "Decision saved. No photo excluded.";
            await LoadAsync();
        }
        catch (Exception e) { Error = "Could not save review: " + e.Message; }
        finally { Busy = false; }
    }

    private async Task PreviousAsync()
    {
        if (Busy) return;
        Offset = Math.Max(0, Offset - 1);
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        if (Busy) return;
        Offset++;
        await LoadAsync();
    }

    private async Task EnableArchiveAsync()
    {
        Busy = true;
        Error = null;
        try
        {
            using HttpResponseMessage response = await Http.PutAsJsonAsync(
                "api/quality-suggestions/context/" + ArchiveScope,
                new { enabled = true });
            response.EnsureSuccessStatusCode();
            await LoadAsync();
        }
        catch (Exception error) { Error = "Could not enable Archive review: " + error.Message; }
        finally { Busy = false; }
    }

    private void OpenCurrentExclusion()
    {
        if (!Busy && Current is not null)
        {
            ShowScanSettings = false;
            PendingExclusion = Current.RevisionId;
            FocusModalOnRender = true;
        }
    }

    private async Task CancelExclude()
    {
        PendingExclusion = null;
        await ReviewSurface.FocusAsync(preventScroll: true);
    }

    private async Task ConfirmExcludeAsync()
    {
        if (Busy || PendingExclusion is null) return;
        string revisionId = PendingExclusion;
        Busy = true;
        Error = null;
        try
        {
            // Reuse the existing native source-copy exclusion/purge API,
            // which performs revision/current-source verification and durable
            // exclusion. The extra explicit on-screen confirmation is required.
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "api/archive/exclusions/revision", new { revisionId });
            if (!response.IsSuccessStatusCode)
                throw new InvalidOperationException(
                    "Exclusion failed (HTTP " + (int)response.StatusCode + ").");
            PendingExclusion = null;
            try
            {
                using HttpResponseMessage withdraw = await Http.PostAsync(
                    "api/quality-suggestions/excluded/" +
                    Uri.EscapeDataString(revisionId), null);
                withdraw.EnsureSuccessStatusCode();
                Message = "Source copy excluded from Photo Identity; its OneDrive original remains untouched.";
            }
            catch (Exception)
            {
                // The irreversible native source-copy exclusion succeeded.
                // Do not show a generic failure or invite a second purge.
                Message = "Photo exclusion succeeded. The review queue could not be updated; " +
                    "refresh the page or scan again to clear the stale suggestion.";
            }
            await LoadAsync();
        }
        catch (Exception e) { Error = e.Message; }
        finally { Busy = false; }
    }

}
