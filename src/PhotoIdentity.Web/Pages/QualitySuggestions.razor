@page "/quality-suggestions"
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Quality suggestions · Photo Identity</PageTitle>

<section class="hero collection-hero">
    <div>
        <p class="eyebrow">Archive cleanup · manual review</p>
        <h1>Possible low-quality photos</h1>
        <p>One photo at a time. Use 1, 2 or 3 to record a decision, and ← / → to navigate.
           Nothing is automatically excluded.</p>
    </div>
</section>

@if (Error is not null)
{
    <div class="notice error" role="alert">@Error</div>
}
@if (Message is not null)
{
    <div class="notice" role="status">@Message</div>
}

<section class="collection-panel quality-scan-controls">
    <div class="section-heading">
        <div>
            <h2>Find suggestions</h2>
            <p>Choose the next batch, continue until the archive is scanned, or explicitly start again.</p>
        </div>
    </div>
    <div class="quality-controls">
        <label>Photos per batch
            <select @bind="BatchSize" disabled="@Busy">
                <option value="100">100</option>
                <option value="500">500</option>
                <option value="1000">1,000</option>
                <option value="5000">5,000</option>
            </select>
        </label>
        <button class="button secondary" disabled="@(Busy || Page?.ScanComplete == true)"
                @onclick="ScanNextAsync">Scan next batch</button>
        <button class="button secondary" disabled="@(Busy || Page?.ScanComplete == true)"
                @onclick="ScanAllAsync">Scan all remaining</button>
        @if (ScanningAll)
        {
            <button class="button secondary" @onclick="CancelScanning">Stop after current batch</button>
        }
        <button class="button secondary" disabled="@Busy" @onclick="RestartScanAsync">Start scan over</button>
    </div>
    <p class="small">
        Scanned @((Page?.Scanned ?? 0).ToString("N0")) existing proxies ·
        @(Page?.Suggested ?? 0) suggestions retained ·
        @(Page?.ScanComplete == true ? "Scan complete" : "More photos available") ·
        next archive position @(Page?.NextScanOffset ?? 0).
        Existing review decisions survive rescan.
    </p>
    <p class="small">Scanning uses existing local JPEG proxies only. It never downloads originals,
       changes collection contents or runs an IQA model. A large scan may take time;
       each request is bounded to the selected batch size.</p>
</section>

<section class="collection-panel quality-review-panel">
    <div class="quality-controls">
        <label>Technical reason
            <select @bind="Reason" @bind:after="FiltersChangedAsync" disabled="@Busy">
                @foreach (QualityOption option in ReasonOptions)
                {
                    <option value="@option.Code">@option.Name</option>
                }
            </select>
        </label>
        <label>Review status
            <select @bind="Filter" @bind:after="FiltersChangedAsync" disabled="@Busy">
                <option value="unreviewed">Not reviewed</option>
                <option value="all">All suggestions</option>
                <option value="consider-exclusion">Consider exclusion</option>
            </select>
        </label>
    </div>

    @if (Loading)
    {
        <div class="quality-empty">Loading suggestions…</div>
    }
    else if (Page is not null)
    {
        <div class="quality-review-progress">
            <span>@Page.Total matching · @Page.ReviewedInScope reviewed · @Page.ConsiderExclusionInScope considered</span>
            <span>@(Page.Total == 0 ? 0 : Offset + 1) / @Page.Total</span>
        </div>

        @if (Current is QualitySuggestionItem item)
        {
            <div class="quality-focus-image">
                <img src="@item.ProxyUrl" alt="Current quality suggestion photo from local review proxy"/>
            </div>
            <div class="quality-review-reasons">
                @foreach (QualityReason reason in item.Reasons)
                {
                    <span class="coverage-chip">@reason.Label</span>
                }
            </div>
            @if (item.Decision is not null)
            {
                <p class="small">Saved decision: @DecisionLabel(item.Decision)</p>
            }
            <div class="quality-primary-actions">
                <button class="button secondary" disabled="@Busy"
                        @onclick="() => KeepAsync(item.RevisionId)">1 · Keep</button>
                <button class="button secondary" disabled="@Busy"
                        @onclick="() => DismissAsync(item.RevisionId)">2 · Dismiss</button>
                <button class="button secondary" disabled="@Busy"
                        @onclick="() => ConsiderAsync(item.RevisionId)">3 · Consider exclusion</button>
            </div>
            <div class="quality-navigation">
                <button class="button secondary" disabled="@(Busy || Offset == 0)"
                        @onclick="PreviousAsync">← Previous</button>
                <button class="button secondary" disabled="@(Busy || Offset + 1 >= Page.Total)"
                        @onclick="NextAsync">Next →</button>
                <a href="@item.PhotoUrl" target="_blank" rel="noopener noreferrer">Open full photo</a>
                <button class="button danger" disabled="@Busy" @onclick="() => OpenExclude(item.RevisionId)">
                    Exclude from Photo Identity…
                </button>
            </div>
            @if (PendingExclusion == item.RevisionId)
            {
                <div class="notice warning quality-confirm" role="group" aria-label="Confirm durable photo exclusion">
                    <strong>Confirm exclusion of this source copy?</strong>
                    <p>Photo Identity will immediately block this photo and permanently purge its
                       locally retained proxies, face links and metadata. The OneDrive original
                       remains untouched. This is not a reversible collection hide.</p>
                    <div class="quality-controls">
                        <button class="button danger" disabled="@Busy" @onclick="ConfirmExcludeAsync">
                            Confirm exclude &amp; purge
                        </button>
                        <button class="button secondary" disabled="@Busy" @onclick="CancelExclude">Cancel</button>
                    </div>
                    <p class="small">There is deliberately no keyboard shortcut for the final purge confirmation.</p>
                </div>
            }
        }
        else
        {
            <div class="quality-empty">
                <p>@(Page.GeneratedAtUtc is null
                    ? "No scan has been run. Scan a batch above to find suggestions."
                    : "No photos match this filter. Try another reason or review status, or scan the next batch.")</p>
            </div>
        }
    }
</section>

<section class="collection-panel">
    <h2>Other curation goals</h2>
    <p>Collection and slideshow curation will share a separate similarity-comparison
       workflow, so these Archive cleanup controls only identify technically
       questionable photos. A future numerical quality signal can help compare
       alternatives, without automatically excluding anything from Photo Identity.</p>
</section>

@code {
    private const string ArchiveScope = "archive-cleanup";
    private sealed record QualityOption(string Code, string Name);
    private sealed record QualityReason(string Code, string Label);
    private sealed record QualitySuggestionItem(
        string RevisionId, List<QualityReason> Reasons, string? Decision,
        string ProxyUrl, string PhotoUrl);
    private sealed record QualityPage(
        int Scanned, DateTimeOffset? GeneratedAtUtc, int Suggested,
        Dictionary<string, bool> EnabledScopes, string Scope, bool Enabled,
        string Reason, string Filter, int Total, int Offset,
        List<QualitySuggestionItem> Items, int ReviewedInScope,
        int ConsiderExclusionInScope, int NextScanOffset, bool ScanComplete);
    private sealed record ScanResult(
        int ProcessedThisBatch, int ScannedCurrentProxyCandidates,
        int Suggested, int NextScanOffset, bool ScanComplete);
    private static readonly QualityOption[] ReasonOptions =
    [
        new("all", "All candidate reasons"),
        new("candidate-low-sharpness", "Possible blur or missed focus"),
        new("candidate-severe-underexposure", "Severe underexposure"),
        new("candidate-severe-overexposure", "Severe overexposure"),
        new("candidate-shadow-clipping", "Shadow clipping"),
        new("candidate-highlight-clipping", "Highlight clipping"),
        new("candidate-low-contrast", "Low contrast"),
        new("candidate-low-effective-proxy-resolution", "Low resolution")
    ];

    private QualityPage? Page;
    private QualitySuggestionItem? Current => Page?.Items.FirstOrDefault();
    private string Reason = "all";
    private string Filter = "unreviewed";
    private string? Message;
    private string? Error;
    private string? PendingExclusion;
    private int Offset;
    private int BatchSize = 1000;
    private bool Busy;
    private bool Loading = true;
    private bool ScanningAll;
    private bool StopAfterBatch;
    private IJSObjectReference? Keys;
    private DotNetObjectReference<QualitySuggestions>? SelfReference;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Keys = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/quality-review-keys.js");
        SelfReference = DotNetObjectReference.Create(this);
        await Keys.InvokeVoidAsync("attach", SelfReference);
    }

    [JSInvokable]
    public async Task OnReviewKeyAsync(string key)
    {
        if (Busy || Loading || PendingExclusion is not null || Current is null) return;
        switch (key)
        {
            case "1": await DecideAsync(Current.RevisionId, "keep"); break;
            case "2": await DecideAsync(Current.RevisionId, "dismiss"); break;
            case "3": await DecideAsync(Current.RevisionId, "consider-exclusion"); break;
            case "ArrowLeft": await PreviousAsync(); break;
            case "ArrowRight": await NextAsync(); break;
        }
    }

    private static string DecisionLabel(string? value) => value switch
    {
        "keep" => "Keep",
        "dismiss" => "Dismiss",
        "consider-exclusion" => "Consider exclusion",
        _ => "Not reviewed"
    };

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            string url = "api/quality-suggestions?scope=" + ArchiveScope
                + "&reason=" + Uri.EscapeDataString(Reason)
                + "&filter=" + Uri.EscapeDataString(Filter)
                + "&offset=" + Offset.ToString(System.Globalization.CultureInfo.InvariantCulture)
                + "&limit=1";
            Page = await Http.GetFromJsonAsync<QualityPage>(url)
                ?? throw new InvalidOperationException("Suggestion queue unavailable.");
            if (Page.Total > 0 && Offset >= Page.Total)
            {
                Offset = Math.Max(0, Page.Total - 1);
                Page = await Http.GetFromJsonAsync<QualityPage>(
                    "api/quality-suggestions?scope=" + ArchiveScope +
                    "&reason=" + Uri.EscapeDataString(Reason) +
                    "&filter=" + Uri.EscapeDataString(Filter) +
                    "&offset=" + Offset + "&limit=1");
            }
        }
        catch (Exception e) { Error = "Unable to load suggestions: " + e.Message; }
        finally { Loading = false; }
    }

    private Task FiltersChangedAsync()
    {
        Offset = 0;
        PendingExclusion = null;
        return LoadAsync();
    }

    private async Task<ScanResult> RunBatchAsync(string mode)
    {
        using HttpResponseMessage response = await Http.PostAsync(
            "api/quality-suggestions/scan?mode=" + mode + "&limit=" + BatchSize, null);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<ScanResult>()
            ?? throw new InvalidOperationException("Scan response missing.");
    }

    private async Task ScanNextAsync() => await ScanAsync("next");
    private async Task RestartScanAsync() => await ScanAsync("restart");
    private async Task ScanAsync(string mode)
    {
        Busy = true;
        Error = null;
        try
        {
            ScanResult result = await RunBatchAsync(mode);
            Message = $"Scanned {result.ScannedCurrentProxyCandidates:N0} current proxies, " +
                $"found {result.Suggested:N0} suggestions. " +
                (result.ScanComplete ? "Entire eligible archive scanned." : "More batches available.");
            Offset = 0;
            await LoadAsync();
        }
        catch (Exception e) { Error = "Scan failed: " + e.Message; }
        finally { Busy = false; }
    }

    private async Task ScanAllAsync()
    {
        Busy = true;
        ScanningAll = true;
        StopAfterBatch = false;
        Error = null;
        try
        {
            ScanResult result;
            do
            {
                result = await RunBatchAsync("next");
                Message = $"Scanned {result.ScannedCurrentProxyCandidates:N0} existing proxies. " +
                    $"{result.Suggested:N0} suggestions. " +
                    (result.ScanComplete ? "Complete." : "Scanning further batches…");
                await InvokeAsync(StateHasChanged);
            }
            while (!result.ScanComplete && !StopAfterBatch);
            Offset = 0;
            await LoadAsync();
        }
        catch (Exception e) { Error = "Full scan stopped: " + e.Message; }
        finally { Busy = false; ScanningAll = false; }
    }

    private void CancelScanning() => StopAfterBatch = true;

    private Task KeepAsync(string id) => DecideAsync(id, "keep");
    private Task DismissAsync(string id) => DecideAsync(id, "dismiss");
    private Task ConsiderAsync(string id) => DecideAsync(id, "consider-exclusion");

    private async Task DecideAsync(string revisionId, string decision)
    {
        if (Busy || PendingExclusion is not null) return;
        Busy = true;
        Error = null;
        try
        {
            using HttpResponseMessage response = await Http.PutAsJsonAsync(
                "api/quality-suggestions/review/" + Uri.EscapeDataString(revisionId),
                new { scope = ArchiveScope, decision });
            response.EnsureSuccessStatusCode();
            if (Filter == "all") Offset++;
            Message = "Decision saved. No photo excluded.";
            await LoadAsync();
        }
        catch (Exception e) { Error = "Could not save review: " + e.Message; }
        finally { Busy = false; }
    }

    private async Task PreviousAsync()
    {
        if (Busy) return;
        Offset = Math.Max(0, Offset - 1);
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        if (Busy) return;
        Offset++;
        await LoadAsync();
    }

    private void OpenExclude(string id) => PendingExclusion = id;
    private void CancelExclude() => PendingExclusion = null;

    private async Task ConfirmExcludeAsync()
    {
        if (Busy || PendingExclusion is null) return;
        string revisionId = PendingExclusion;
        Busy = true;
        Error = null;
        try
        {
            // Reuse the existing native source-copy exclusion/purge API,
            // which performs revision/current-source verification and durable
            // exclusion. The extra explicit on-screen confirmation is required.
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "api/archive/exclusions/revision", new { revisionId });
            if (!response.IsSuccessStatusCode)
                throw new InvalidOperationException(
                    "Exclusion failed (HTTP " + (int)response.StatusCode + ").");
            using HttpResponseMessage withdraw = await Http.PostAsync(
                "api/quality-suggestions/excluded/" +
                Uri.EscapeDataString(revisionId), null);
            withdraw.EnsureSuccessStatusCode();
            PendingExclusion = null;
            Message = "Source copy excluded from Photo Identity; its OneDrive original remains untouched.";
            await LoadAsync();
        }
        catch (Exception e) { Error = e.Message; }
        finally { Busy = false; }
    }

    public async ValueTask DisposeAsync()
    {
        if (Keys is not null)
        {
            try { await Keys.InvokeVoidAsync("detach"); }
            catch (JSDisconnectedException) { }
            await Keys.DisposeAsync();
        }
        SelfReference?.Dispose();
    }
}
