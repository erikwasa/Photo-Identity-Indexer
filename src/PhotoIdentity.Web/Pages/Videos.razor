@page "/videos"
@inject HttpClient Http

<PageTitle>Videos · Photo Identity</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">Opt-in catalogue</p>
        <h1>Videos</h1>
        <p>Indexed video posters and playback of already-retained local proxies. Playing or seeking never downloads an online-only original or starts processing.</p>
    </div>
    <div class="video-library-actions">
        <label class="video-library-filter">
            <input type="checkbox" @bind="PlayableOnly" @bind:after="RefreshAsync" disabled="@Loading" />
            Playable videos only
        </label>
        <a class="button secondary" href="/video-search">Search indexed videos</a>
        <button class="button secondary" @onclick="RefreshAsync" disabled="@Loading">Refresh</button>
    </div>
</section>

@if (Coverage is not null)
{
    <section class="video-library-coverage" aria-label="Current video coverage">
        <strong>@Coverage.TotalVideos</strong> catalogued ·
        <strong>@Coverage.PlayableVideos</strong> playable ·
        <strong>@Coverage.VideosWithPosters</strong> with registered posters ·
        <strong>@Coverage.PlayableMissingPosters</strong> playable without posters
    </section>
}

@if (Loading && Items.Count == 0)
{
    <section class="empty-state" aria-live="polite"><p>Loading indexed videos…</p></section>
}
else if (Error is not null)
{
    <section class="empty-state" role="status">
        <h2>Video library unavailable</h2>
        <p>@Error</p>
    </section>
}
else if (Items.Count == 0)
{
    <section class="empty-state" role="status">
        <h2>@(PlayableOnly ? "No playable video proxies" : "No videos indexed yet")</h2>
        <p>@(PlayableOnly ? "Switch off the playable-only filter to see the full catalogue. Browsing does not start video processing." : "This library only displays videos registered through the opt-in local video workflow.")</p>
    </section>
}
else
{
    <section class="video-library-grid" aria-label="Indexed videos">
        @foreach (VideoLibraryItemResponse video in Items)
        {
            bool playing = ActivePlaybackRevisionId == video.RevisionId;
            <article class="@(playing ? "video-library-card video-library-card--playing" : "video-library-card")" @key="video.RevisionId">
                <div class="@(playing ? "video-library-poster video-library-poster--playing" : "video-library-poster")">
                    @if (ActivePlaybackRevisionId == video.RevisionId)
                    {
                        <video class="video-library-player" controls playsinline preload="metadata"
                               aria-label="Video playback"
                               poster="@(video.HasPoster ? $"/api/videos/{video.RevisionId}/poster" : null)"
                               src="@($"/api/videos/{video.RevisionId}/play")"
                               @onerror="() => PlaybackFailed(video.RevisionId)">
                            Your browser cannot play this video.
                        </video>
                    }
                    else if (video.HasPoster)
                    {
                        <img loading="lazy" alt="Video still poster" src="@($"/api/videos/{video.RevisionId}/poster")" />
                    }
                    else
                    {
                        <span class="video-library-placeholder" aria-label="No verified still poster">No verified poster</span>
                    }
                    @if (ActivePlaybackRevisionId != video.RevisionId)
                    {
                        <span class="video-library-duration">@FormatDuration(video.DurationSeconds)</span>
                    }
                </div>
                <div class="video-library-card-body">
                    <strong>@(video.CaptureAtUtc is DateTimeOffset date ? date.ToString("yyyy-MM-dd") : "Date unknown")</strong>
                    <span>@FormatResolution(video.Width, video.Height, video.RotationDegrees)</span>
                    <span>@(video.InspectionStatus ?? "Not inspected")</span>
                    @if (video.HasPlayableProxy)
                    {
                        <button class="button secondary video-library-play-button"
                                @onclick="() => TogglePlayback(video.RevisionId)">
                            @(ActivePlaybackRevisionId == video.RevisionId ? "Close player" : "Open player")
                        </button>
                    }
                    else
                    {
                        <span>Playable proxy unavailable · prepare later in Video processing</span>
                    }
                    @if (PlaybackErrorRevisionId == video.RevisionId)
                    {
                        <p role="status">This proxy could not be played. It may have been removed or changed. No original was opened.</p>
                    }
                </div>
            </article>
        }
    </section>
    @if (HasMore)
    {
        <div class="video-library-more">
            <button class="button secondary" @onclick="LoadMoreAsync" disabled="@Loading">@(Loading ? "Loading…" : "Load more videos")</button>
        </div>
    }
}

@code {
    private readonly List<VideoLibraryItemResponse> Items = [];
    private string? ActivePlaybackRevisionId;
    private string? PlaybackErrorRevisionId;
    private bool Loading;
    private bool HasMore;
    private bool PlayableOnly;
    private VideoLibraryCoverageResponse? Coverage;
    private string? Error;
    private const int PageSize = 24;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        ActivePlaybackRevisionId = null;
        PlaybackErrorRevisionId = null;
        Items.Clear();
        HasMore = false;
        Error = null;
        await LoadMoreAsync();
        if (Error is null) await LoadCoverageAsync();
    }

    private async Task LoadCoverageAsync()
    {
        try
        {
            Coverage = await Http.GetFromJsonAsync<VideoLibraryCoverageResponse>(
                "/api/videos/coverage");
        }
        catch (Exception error) when (error is HttpRequestException or
                                     System.Text.Json.JsonException or
                                     InvalidDataException)
        {
            // A failed aggregate must not hide an otherwise usable library.
            Coverage = null;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (Loading) return;
        Loading = true;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync(
                $"/api/videos?offset={Items.Count}&limit={PageSize}&playableOnly={PlayableOnly.ToString().ToLowerInvariant()}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                Error = "Enable PhotoIdentity:VideoLibraryEnabled on the local server after completing video ingestion and poster verification.";
                return;
            }
            response.EnsureSuccessStatusCode();
            VideoLibraryResponse? page =
                await response.Content.ReadFromJsonAsync<VideoLibraryResponse>();
            if (page is null)
                throw new InvalidDataException("The video catalogue returned no page.");
            Items.AddRange(page.Items);
            HasMore = page.HasMore;
            Error = null;
        }
        catch (Exception error) when (error is HttpRequestException or
                                     InvalidDataException or System.Text.Json.JsonException)
        {
            Error = "The video catalogue could not be loaded. No originals or photo data were changed.";
        }
        finally { Loading = false; }
    }

    private void TogglePlayback(string revisionId)
    {
        ActivePlaybackRevisionId = ActivePlaybackRevisionId == revisionId ? null : revisionId;
        PlaybackErrorRevisionId = null;
    }

    private void PlaybackFailed(string revisionId)
    {
        ActivePlaybackRevisionId = null;
        PlaybackErrorRevisionId = revisionId;
    }

    private static string FormatDuration(decimal? seconds)
    {
        if (seconds is null || seconds < 0 || seconds > 86400)
            return "Duration unknown";
        TimeSpan duration = TimeSpan.FromSeconds((double)seconds.Value);
        return duration.TotalHours >= 1 ? duration.ToString(@"h\:mm\:ss") :
            duration.ToString(@"m\:ss");
    }

    private static string FormatResolution(int? width, int? height, int? rotation) =>
        width is int w && height is int h
            ? $"{w} × {h}" + (rotation is null or 0 ? "" : $" · {rotation}° rotation")
            : "Resolution unknown";
}
