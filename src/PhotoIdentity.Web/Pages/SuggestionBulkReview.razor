@page "/suggestion-bulk"
@inject NavigationManager Navigation

<PageTitle>Redirecting · Photo Identity</PageTitle>

<section class="empty-state" aria-live="polite">
    <div class="spinner" aria-hidden="true"></div>
    <p>Opening the unified Faces queue…</p>
</section>

@code {
    protected override void OnInitialized()
    {
        Uri current = Navigation.ToAbsoluteUri(Navigation.Uri);
        string query = current.Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            query = "?state=unreviewed&sort=suggested-person";
        }
        Navigation.NavigateTo($"/{query}", replace: true);
    }
}
