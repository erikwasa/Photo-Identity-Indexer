@page "/suggestion-bulk"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Bulk suggestions · Photo Identity</PageTitle>

<section class="hero bulk-suggestion-hero">
    <div>
        <p class="eyebrow">Preview-first grouped acceptance</p>
        <h1>Accept suggestion groups</h1>
        <p>Review rank-one matches grouped by suggested person. Select one group, preview the exact affected count, then explicitly commit both assignment and suggestion audit actions.</p>
    </div>
    <a class="button secondary" href="/suggestions">Individual suggestion review</a>
</section>

<section class="progress-filters" aria-labelledby="bulk-suggestion-scope-heading">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Exact model scope</p>
            <h2 id="bulk-suggestion-scope-heading">Suggestion groups</h2>
        </div>
    </div>

    <div class="filter-grid">
        <div>
            <label class="field-label" for="bulk-suggestion-run">Processing run</label>
            <select id="bulk-suggestion-run" @bind="SelectedRunIndex" @bind:after="ApplyRunAsync" disabled="@(Loading || Options.ProcessingRuns.Count == 0)">
                <option value="">All processing runs</option>
                @for (int index = 0; index < Options.ProcessingRuns.Count; index++)
                {
                    ReviewProcessingRunFilterResponse run = Options.ProcessingRuns[index];
                    <option value="@index">@RunLabel(run)</option>
                }
            </select>
        </div>

        <div>
            <label class="field-label" for="bulk-suggestion-model">Suggestion model revision</label>
            <select id="bulk-suggestion-model" @bind="SelectedModelIndex" @bind:after="ApplyModelAsync" disabled="@(Loading || Options.ModelRevisions.Count == 0)">
                @if (Options.ModelRevisions.Count == 0)
                {
                    <option value="">No ranked suggestions available</option>
                }
                else
                {
                    @for (int index = 0; index < Options.ModelRevisions.Count; index++)
                    {
                        ReviewModelRevisionFilterResponse model = Options.ModelRevisions[index];
                        <option value="@index">@ModelLabel(model)</option>
                    }
                }
            </select>
        </div>
    </div>

    @if (SelectedModel is ReviewModelRevisionFilterResponse activeModel)
    {
        <dl class="active-scope">
            @if (SelectedRun is ReviewProcessingRunFilterResponse activeRun)
            {
                <div><dt>Processing run</dt><dd><code>@activeRun.Id</code></dd></div>
            }
            <div><dt>Model ID</dt><dd>@activeModel.ModelId</dd></div>
            <div><dt>Exact model hash</dt><dd><code>@activeModel.ModelHash</code></dd></div>
        </dl>
    }
</section>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="notice error" role="alert">@Error</div>
}
@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="notice success" role="status">@Message</div>
}

@if (Loading)
{
    <section class="empty-state" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading grouped suggestions…</p>
    </section>
}
else if (SelectedModel is null)
{
    <section class="empty-state">
        <h2>No ranked suggestion model is available</h2>
        <p>Generate identity suggestions before using grouped acceptance.</p>
    </section>
}
else if (Groups.Count == 0)
{
    <section class="empty-state">
        <h2>No pending suggestion groups in this scope</h2>
        <p>Change the processing run or generate fresh ranked suggestions.</p>
    </section>
}
else
{
    <section class="bulk-suggestion-panel" aria-labelledby="bulk-suggestion-heading">
        <div class="bulk-suggestion-panel-heading">
            <div>
                <p class="eyebrow">One person at a time</p>
                <h2 id="bulk-suggestion-heading">Grouped acceptance</h2>
                <p>Groups contain rank-one pending suggestions from the exact model revision. Selection is limited to one suggested person before preview.</p>
            </div>
            <button class="button secondary" disabled="@(Busy || SelectedSuggestionIds.Count == 0)" @onclick="ClearSelection">Clear selection</button>
        </div>

        <div class="suggestion-group-picker" aria-label="Suggested-person groups on this page">
            @foreach (SuggestionGroup group in Groups)
            {
                <button class="suggestion-group-button @(SelectedPersonId == group.Person.Id ? "active" : "")"
                        disabled="@Busy"
                        @onclick="() => SelectGroup(group.Person.Id)">
                    <strong>@group.Person.DisplayName</strong>
                    <span>@group.Items.Count suggestion@(group.Items.Count == 1 ? "" : "s")</span>
                </button>
            }
        </div>

        @if (SelectedSuggestionIds.Count > 0 && SelectedGroup is SuggestionGroup selectedGroup)
        {
            <div class="bulk-suggestion-controls">
                <div>
                    <span class="field-label">Selected group</span>
                    <strong>@selectedGroup.Person.DisplayName · @SelectedSuggestionIds.Count face@(SelectedSuggestionIds.Count == 1 ? "" : "s")</strong>
                </div>
                <div>
                    <label class="field-label" for="bulk-suggestion-note">Audit note</label>
                    <input id="bulk-suggestion-note"
                           maxlength="1000"
                           placeholder="Optional note applied to every assignment and suggestion action"
                           @bind="Note"
                           @bind:event="oninput"
                           disabled="@Busy" />
                </div>
                <button class="button primary" disabled="@Busy" @onclick="PreviewAsync">
                    Preview @SelectedSuggestionIds.Count acceptance@(SelectedSuggestionIds.Count == 1 ? "" : "s")
                </button>
            </div>
        }

        @if (Preview is BulkSuggestionPreviewResponse preview)
        {
            <div class="bulk-suggestion-preview" role="status">
                <div>
                    <strong>@preview.AffectedCount face@(preview.AffectedCount == 1 ? "" : "s") will be assigned to @preview.Person.DisplayName</strong>
                    <p>Each affected face will receive a normal assignment action and a linked suggestion-acceptance action.</p>
                    @if (preview.SkippedCount > 0)
                    {
                        <p>@preview.SkippedCount selected suggestion@(preview.SkippedCount == 1 ? " is" : "s are") no longer eligible and will be skipped.</p>
                    }
                    <p><code>@preview.ModelId · @preview.ModelHash</code></p>
                </div>
                <button class="button primary"
                        disabled="@(Busy || preview.AffectedCount == 0)"
                        @onclick="CommitAsync">
                    Commit @preview.AffectedCount acceptance@(preview.AffectedCount == 1 ? "" : "s")
                </button>
            </div>
        }
    </section>

    <div class="gallery-summary" role="status">
        <span>@Groups.Sum(group => group.Items.Count) grouped suggestion@(Groups.Sum(group => group.Items.Count) == 1 ? "" : "s") on this page</span>
        @if (Page is not null)
        {
            <span>Showing source queue @(Page.Offset + 1)–@Math.Min(Page.Offset + Page.Items.Count, Page.Total) of @Page.Total</span>
        }
    </div>

    @foreach (SuggestionGroup group in Groups)
    {
        <section class="suggestion-person-group" aria-labelledby="group-@group.Person.Id">
            <div class="suggestion-person-group-heading">
                <div>
                    <p class="eyebrow">Rank-one suggested person</p>
                    <h2 id="group-@group.Person.Id">@group.Person.DisplayName</h2>
                    <span>@group.Items.Count face@(group.Items.Count == 1 ? "" : "s") on this page</span>
                </div>
                <button class="button secondary" disabled="@Busy" @onclick="() => SelectGroup(group.Person.Id)">
                    Select this group
                </button>
            </div>

            <div class="suggestion-bulk-grid">
                @foreach (ReviewFaceResponse face in group.Items)
                {
                    long suggestionId = face.TopSuggestion!.Id;
                    <SuggestionBulkCard Face="face"
                                        DetailsUrl="@BuildDetailsUrl(face.Id)"
                                        Selected="@SelectedSuggestionIds.Contains(suggestionId)"
                                        SelectionEnabled="@(SelectedPersonId is null || SelectedPersonId == group.Person.Id)"
                                        SelectionChanged="SetSelection" />
                }
            </div>
        </section>
    }

    @if (Page is not null)
    {
        <div class="pagination">
            <button class="button secondary" disabled="@(Page.Offset == 0 || Loading || Busy)" @onclick="PreviousPageAsync">Previous</button>
            <button class="button secondary" disabled="@(Page.Offset + Page.Limit >= Page.Total || Loading || Busy)" @onclick="NextPageAsync">Next</button>
        </div>
    }
}

@code {
    private const int PageSize = 200;
    private const string Actor = "local-reviewer";

    [Parameter, SupplyParameterFromQuery(Name = "offset")]
    public int Offset { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "processingRunId")]
    public string ProcessingRunId { get; set; } = "";

    [Parameter, SupplyParameterFromQuery(Name = "modelId")]
    public string ModelId { get; set; } = "";

    [Parameter, SupplyParameterFromQuery(Name = "modelHash")]
    public string ModelHash { get; set; } = "";

    private ReviewFilterOptionsResponse Options { get; set; } = new([], []);
    private ReviewFacePageResponse? Page { get; set; }
    private IReadOnlyList<SuggestionGroup> Groups { get; set; } = [];
    private HashSet<long> SelectedSuggestionIds { get; } = [];
    private BulkSuggestionPreviewResponse? Preview { get; set; }
    private string SelectedRunIndex { get; set; } = "";
    private string SelectedModelIndex { get; set; } = "";
    private string Note { get; set; } = "";
    private bool Loading { get; set; } = true;
    private bool Busy { get; set; }
    private string? Error { get; set; }
    private string? Message { get; set; }

    private ReviewProcessingRunFilterResponse? SelectedRun =>
        int.TryParse(SelectedRunIndex, out int runIndex) &&
        runIndex >= 0 &&
        runIndex < Options.ProcessingRuns.Count
            ? Options.ProcessingRuns[runIndex]
            : null;

    private ReviewModelRevisionFilterResponse? SelectedModel =>
        int.TryParse(SelectedModelIndex, out int modelIndex) &&
        modelIndex >= 0 &&
        modelIndex < Options.ModelRevisions.Count
            ? Options.ModelRevisions[modelIndex]
            : null;

    private string? SelectedPersonId => Groups
        .Where(group => group.Items.Any(face =>
            face.TopSuggestion is ReviewTopSuggestionResponse suggestion &&
            SelectedSuggestionIds.Contains(suggestion.Id)))
        .Select(group => group.Person.Id)
        .FirstOrDefault();

    private SuggestionGroup? SelectedGroup =>
        SelectedPersonId is string personId
            ? Groups.FirstOrDefault(group => group.Person.Id == personId)
            : null;

    protected override async Task OnInitializedAsync()
    {
        Offset = Math.Max(0, Offset);
        await LoadOptionsAsync();
        ResolveSelections();
        await LoadFacesAsync();
    }

    private async Task LoadOptionsAsync()
    {
        try
        {
            Options = await Http.GetFromJsonAsync<ReviewFilterOptionsResponse>("api/review/filters")
                ?? new ReviewFilterOptionsResponse([], []);
        }
        catch (Exception exception)
        {
            Error = $"Suggestion filter options could not be loaded: {exception.Message}";
        }
    }

    private void ResolveSelections()
    {
        int runIndex = Options.ProcessingRuns
            .Select((run, index) => (run, index))
            .Where(item => item.run.Id == ProcessingRunId)
            .Select(item => item.index)
            .DefaultIfEmpty(-1)
            .First();
        SelectedRunIndex = runIndex >= 0 ? runIndex.ToString() : "";
        ProcessingRunId = SelectedRun?.Id ?? "";

        int modelIndex = Options.ModelRevisions
            .Select((model, index) => (model, index))
            .Where(item => item.model.ModelId == ModelId && item.model.ModelHash == ModelHash)
            .Select(item => item.index)
            .DefaultIfEmpty(-1)
            .First();
        if (modelIndex < 0 && Options.ModelRevisions.Count > 0)
        {
            modelIndex = 0;
        }

        SelectedModelIndex = modelIndex >= 0 ? modelIndex.ToString() : "";
        ModelId = SelectedModel?.ModelId ?? "";
        ModelHash = SelectedModel?.ModelHash ?? "";
    }

    private async Task LoadFacesAsync()
    {
        if (SelectedModel is not ReviewModelRevisionFilterResponse model)
        {
            Page = null;
            Groups = [];
            Loading = false;
            return;
        }

        Loading = true;
        Error = null;
        try
        {
            List<string> query =
            [
                "state=unreviewed",
                $"offset={Offset}",
                $"limit={PageSize}",
                "sort=suggested-person",
                $"modelId={Uri.EscapeDataString(model.ModelId)}",
                $"modelHash={Uri.EscapeDataString(model.ModelHash)}",
            ];
            if (SelectedRun is ReviewProcessingRunFilterResponse run)
            {
                query.Add($"processingRunId={Uri.EscapeDataString(run.Id)}");
            }

            Page = await Http.GetFromJsonAsync<ReviewFacePageResponse>(
                $"api/review/suggestion-faces?{string.Join("&", query)}");
            if (Page is not null && Page.Items.Count == 0 && Offset > 0)
            {
                Offset = Math.Max(0, Offset - PageSize);
                await LoadFacesAsync();
                return;
            }

            Groups = Page?.Items
                .Where(face => face.TopSuggestion is not null)
                .GroupBy(face => face.TopSuggestion!.Person.Id, StringComparer.Ordinal)
                .Select(group => new SuggestionGroup(
                    group.First().TopSuggestion!.Person,
                    group.OrderByDescending(face => face.TopSuggestion!.ScoreMargin ?? double.MinValue)
                         .ThenByDescending(face => face.TopSuggestion!.Score)
                         .ThenBy(face => face.Id, StringComparer.Ordinal)
                         .ToArray()))
                .OrderBy(group => group.Person.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(group => group.Person.Id, StringComparer.Ordinal)
                .ToArray() ?? [];
            ClearSelection();
        }
        catch (Exception exception)
        {
            Error = $"Grouped suggestion review could not be loaded: {exception.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task ApplyRunAsync()
    {
        ProcessingRunId = SelectedRun?.Id ?? "";
        await ApplyFiltersAsync();
    }

    private async Task ApplyModelAsync()
    {
        ModelId = SelectedModel?.ModelId ?? "";
        ModelHash = SelectedModel?.ModelHash ?? "";
        await ApplyFiltersAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        Offset = 0;
        Message = null;
        await LoadFacesAsync();
    }

    private void SelectGroup(string personId)
    {
        SuggestionGroup? group = Groups.FirstOrDefault(value => value.Person.Id == personId);
        if (group is null)
        {
            return;
        }

        SelectedSuggestionIds.Clear();
        foreach (ReviewFaceResponse face in group.Items)
        {
            if (face.TopSuggestion is ReviewTopSuggestionResponse suggestion)
            {
                SelectedSuggestionIds.Add(suggestion.Id);
            }
        }

        InvalidatePreview();
    }

    private void SetSelection((long SuggestionId, bool Selected) change)
    {
        ReviewFaceResponse? face = Groups
            .SelectMany(group => group.Items)
            .FirstOrDefault(item => item.TopSuggestion?.Id == change.SuggestionId);
        if (face?.TopSuggestion is not ReviewTopSuggestionResponse suggestion)
        {
            return;
        }

        if (change.Selected)
        {
            string? selectedPersonId = SelectedPersonId;
            if (selectedPersonId is not null && selectedPersonId != suggestion.Person.Id)
            {
                SelectedSuggestionIds.Clear();
            }

            SelectedSuggestionIds.Add(change.SuggestionId);
        }
        else
        {
            SelectedSuggestionIds.Remove(change.SuggestionId);
        }

        InvalidatePreview();
    }

    private void ClearSelection()
    {
        SelectedSuggestionIds.Clear();
        Preview = null;
    }

    private void InvalidatePreview()
    {
        Preview = null;
        Message = null;
    }

    private async Task PreviewAsync()
    {
        if (SelectedModel is not ReviewModelRevisionFilterResponse model || SelectedSuggestionIds.Count == 0)
        {
            return;
        }

        Busy = true;
        Error = null;
        Message = null;
        try
        {
            BulkSuggestionPreviewRequest request = new(
                SelectedSuggestionIds.OrderBy(id => id).ToArray(),
                model.ModelId,
                model.ModelHash);
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "api/review/bulk-suggestions/preview",
                request);
            await RequireSuccessAsync(response);
            Preview = await response.Content.ReadFromJsonAsync<BulkSuggestionPreviewResponse>()
                ?? throw new InvalidOperationException("The grouped suggestion preview response was empty.");
        }
        catch (Exception exception)
        {
            Error = exception.Message;
            Preview = null;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task CommitAsync()
    {
        if (SelectedModel is not ReviewModelRevisionFilterResponse model ||
            Preview is not BulkSuggestionPreviewResponse preview ||
            preview.AffectedCount == 0)
        {
            return;
        }

        Busy = true;
        Error = null;
        Message = null;
        try
        {
            BulkSuggestionCommitRequest request = new(
                SelectedSuggestionIds.OrderBy(id => id).ToArray(),
                model.ModelId,
                model.ModelHash,
                preview.AffectedCount,
                preview.PreviewToken,
                Confirm: true,
                Actor,
                EmptyToNull(Note));
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "api/review/bulk-suggestions/commit",
                request);
            await RequireSuccessAsync(response);
            BulkSuggestionCommitResponse result = await response.Content.ReadFromJsonAsync<BulkSuggestionCommitResponse>()
                ?? throw new InvalidOperationException("The grouped suggestion commit response was empty.");
            string personName = result.Person.DisplayName;
            Note = "";
            await LoadFacesAsync();
            Message = $"Accepted {result.AffectedCount} suggestion{(result.AffectedCount == 1 ? "" : "s")} for {personName}.";
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private string BuildDetailsUrl(string faceId)
    {
        ReviewModelRevisionFilterResponse model = SelectedModel
            ?? throw new InvalidOperationException("A model revision is required.");
        List<string> scope =
        [
            "state=unreviewed",
            "sort=suggested-person",
            $"modelId={Uri.EscapeDataString(model.ModelId)}",
            $"modelHash={Uri.EscapeDataString(model.ModelHash)}",
        ];
        List<string> returnScope =
        [
            $"offset={Offset}",
            $"modelId={Uri.EscapeDataString(model.ModelId)}",
            $"modelHash={Uri.EscapeDataString(model.ModelHash)}",
        ];
        if (SelectedRun is ReviewProcessingRunFilterResponse run)
        {
            string runScope = $"processingRunId={Uri.EscapeDataString(run.Id)}";
            scope.Add(runScope);
            returnScope.Add(runScope);
        }

        string returnUrl = $"/suggestion-bulk?{string.Join("&", returnScope)}";
        return $"/suggestion-faces/{Uri.EscapeDataString(faceId)}?{string.Join("&", scope)}" +
               $"&returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private async Task PreviousPageAsync()
    {
        Offset = Math.Max(0, Offset - PageSize);
        await LoadFacesAsync();
    }

    private async Task NextPageAsync()
    {
        Offset += PageSize;
        await LoadFacesAsync();
    }

    private static string RunLabel(ReviewProcessingRunFilterResponse run) =>
        $"{run.StartedAtUtc.ToLocalTime():g} · {run.Status} · {run.FaceCount} face{(run.FaceCount == 1 ? "" : "s")}";

    private static string ModelLabel(ReviewModelRevisionFilterResponse model) =>
        $"{model.ModelId} · {model.ModelHash[..12]} · {model.FaceCount} face{(model.FaceCount == 1 ? "" : "s")}";

    private static string? EmptyToNull(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static async Task RequireSuccessAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return;
        }

        string detail = await response.Content.ReadAsStringAsync();
        throw new InvalidOperationException(
            string.IsNullOrWhiteSpace(detail)
                ? $"The grouped suggestion action failed with status {(int)response.StatusCode}."
                : detail);
    }

    private sealed record SuggestionGroup(
        ReviewPersonResponse Person,
        IReadOnlyList<ReviewFaceResponse> Items);
}
