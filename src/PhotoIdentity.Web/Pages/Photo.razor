@page "/photo/{RevisionId}"
@implements IAsyncDisposable
@inject HttpClient Http

<PageTitle>Photo · Photo Identity</PageTitle>

<section class="hero collection-hero">
    <div>
        <p class="eyebrow">Photo viewer</p>
        <h1>Photo</h1>
        <p>An already-local, revision-verified original is shown directly. If the original is online-only, the viewer uses the review proxy when available and never downloads the original implicitly.</p>
    </div>
    <a class="button secondary" href="@BackDestination">@BackLabel</a>
</section>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="notice error" role="alert">@Error</div>
}

<section class="collection-panel">
    @if (LoadingStatus && Original is null)
    {
        <div class="empty-state compact"><p>Checking photo availability…</p></div>
    }
    else if (PreviewUnavailable)
    {
        <div class="empty-state compact">
            @if (Original?.State == "ready")
            {
                <p>The authoritative original is local and revision-verified, but it could not be displayed in the photo viewer.</p>
                <p>Normal viewing did not request hydration. Refresh the page to retry.</p>
            }
            else
            {
                <p>No photo is currently available to display. A durable review proxy has not been generated yet and the authoritative original is not already local and revision-verified.</p>
                <p>Normal viewing will not download an online-only original. Use <strong>Load original</strong> below only when you explicitly want full-resolution access, or let archive processing generate the durable proxy.</p>
            }
        </div>
    }
    else
    {
        <div class="photo-viewer-frame">
            <img class="photo-viewer-image"
                 src="@ViewerUrl"
                 alt="Selected photo"
                 decoding="async"
                 @onerror="HandlePreviewError" />
        </div>
    }

    <section class="metadata-card photo-details-panel" aria-labelledby="photo-details-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Photo metadata</p>
                <h2 id="photo-details-heading">Details</h2>
            </div>
            @if (!LoadingDetails && Details is not null)
            {
                <span>@PeopleCountLabel</span>
            }
        </div>

        @if (LoadingDetails)
        {
            <div class="empty-state compact"><p>Loading photo details…</p></div>
        }
        else if (Details is not null)
        {
            <dl class="profile-details photo-detail-values">
                <div><dt>File name</dt><dd>@Details.FileName</dd></div>
            </dl>

            <div class="photo-people-section">
                <h3>People</h3>
                @if (Details.People.Count == 0)
                {
                    <p class="photo-detail-empty">No confirmed people are currently known to be in this photo.</p>
                }
                else
                {
                    <div class="photo-person-list" aria-label="Confirmed people in this photo">
                        @foreach (PhotoDetailsPersonResponse person in Details.People)
                        {
                            <span class="photo-person-chip" title="@ConfirmedFaceLabel(person.ConfirmedFaceCount)">@person.DisplayName</span>
                        }
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(DetailsError))
        {
            <div class="notice error photo-details-notice" role="alert">@DetailsError</div>
        }
    </section>

    <section class="metadata-card photo-tag-panel" aria-labelledby="photo-tags-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Photo metadata</p>
                <h2 id="photo-tags-heading">Tags</h2>
            </div>
            @if (!LoadingTags)
            {
                <span>@TagCountLabel</span>
            }
        </div>

        @if (LoadingTags)
        {
            <div class="empty-state compact"><p>Loading tags…</p></div>
        }
        else
        {
            @if (Tags.Count == 0)
            {
                <p class="photo-tag-empty">No manual tags have been added to this photo.</p>
            }
            else
            {
                <div class="photo-tag-list" aria-label="Manual photo tags">
                    @foreach (PhotoTagResponse tag in Tags)
                    {
                        <button type="button"
                                class="photo-tag-chip"
                                disabled="@TagBusy"
                                title="Remove @tag.Name"
                                aria-label="Remove tag @tag.Name"
                                @onclick="() => RemoveTagAsync(tag.Name)">
                            <span>@tag.Name</span>
                            <span aria-hidden="true">×</span>
                        </button>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(TagError))
            {
                <div class="notice error photo-tag-notice" role="alert">@TagError</div>
            }

            <label class="field-label photo-tag-label" for="photo-tag-input">Add a manual tag</label>
            <div class="inline-field photo-tag-entry">
                <input id="photo-tag-input"
                       type="text"
                       maxlength="80"
                       autocomplete="off"
                       placeholder="e.g. beach day"
                       disabled="@TagBusy"
                       @bind="TagInput"
                       @bind:event="oninput"
                       @onkeydown="HandleTagKeyDown" />
                <button type="button"
                        class="button primary"
                        disabled="@(TagBusy || string.IsNullOrWhiteSpace(TagInput))"
                        @onclick="AddTagAsync">
                    @(TagBusy ? "Saving…" : "Add tag")
                </button>
            </div>
            <p class="photo-tag-help">Tags are saved to this exact photo revision. Editing tags does not download or modify the original image.</p>
        }
    </section>

    <div class="section-heading">
        <div>
            <p class="eyebrow">Authoritative original</p>
            <h2>Full-resolution access</h2>
        </div>
        @if (Original is not null)
        {
            <span class="photo-original-state @OriginalStateClass(Original.State)">@OriginalStateLabel(Original.State)</span>
        }
    </div>

    @if (LoadingStatus)
    {
        <div class="empty-state compact"><p>Checking original availability…</p></div>
    }
    else if (Original is not null)
    {
        <dl class="profile-details">
            <div><dt>Managed by</dt><dd>@OriginalManagedByLabel(Original)</dd></div>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Original.Message))
        {
            <div class="notice">@Original.Message</div>
        }

        <div class="collection-inline-actions">
            @if (Original.CanRequestHydration)
            {
                <button type="button" class="button primary" disabled="@Busy" @onclick="HydrateAsync">
                    @(Busy ? "Requesting…" : "Load original")
                </button>
            }
            @if (Original.CanRelease)
            {
                <button type="button" class="button secondary" disabled="@Busy" @onclick="ReleaseAsync">
                    @(Busy ? "Requesting…" : "Release original")
                </button>
            }
            <button type="button" class="button secondary" disabled="@(Busy || LoadingStatus)" @onclick="LoadStatusAsync">
                Refresh original state
            </button>
        </div>
    }
</section>

@code {
    [Parameter]
    public string RevisionId { get; set; } = string.Empty;

    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private CollectionOriginalAccessResponse? Original { get; set; }
    private PhotoDetailsResponse? Details { get; set; }
    private IReadOnlyList<PhotoTagResponse> Tags { get; set; } = [];
    private bool LoadingStatus { get; set; }
    private bool LoadingDetails { get; set; }
    private bool LoadingTags { get; set; }
    private bool Busy { get; set; }
    private bool TagBusy { get; set; }
    private bool PreviewUnavailable { get; set; }
    private string TagInput { get; set; } = string.Empty;
    private string? Error { get; set; }
    private string? DetailsError { get; set; }
    private string? TagError { get; set; }
    private CancellationTokenSource? PollCancellation { get; set; }

    private string BackDestination => PhotoReturnContext.NormalizeLocalReturnUrl(ReturnUrl) ?? "/collections";
    private string BackLabel => PhotoReturnContext.IsSmartCollectionsReturn(BackDestination)
        ? "Back to smart collections"
        : "Back to collections";
    private string PreviewUrl => $"api/collections/photos/{Uri.EscapeDataString(RevisionId)}/viewer-preview";
    private string OriginalUrl => $"api/collections/photos/{Uri.EscapeDataString(RevisionId)}/original";
    private string ViewerUrl => Original?.CanView == true ? OriginalUrl : PreviewUrl;
    private string StatusUrl => $"api/collections/photos/{Uri.EscapeDataString(RevisionId)}/original/status";
    private string DetailsUrl => $"api/collections/photos/{Uri.EscapeDataString(RevisionId)}/details";
    private string TagsUrl => $"api/collections/photos/{Uri.EscapeDataString(RevisionId)}/tags";
    private string TagCountLabel => Tags.Count == 1 ? "1 manual tag" : $"{Tags.Count} manual tags";
    private string PeopleCountLabel => Details?.People.Count == 1 ? "1 confirmed person" : $"{Details?.People.Count ?? 0} confirmed people";

    protected override async Task OnParametersSetAsync()
    {
        StopPolling();
        PreviewUnavailable = false;
        TagInput = string.Empty;
        Details = null;
        await Task.WhenAll(LoadStatusAsync(), LoadDetailsAsync(), LoadTagsAsync());
        StartPollingIfNeeded();
    }

    private void HandlePreviewError()
    {
        PreviewUnavailable = true;
    }

    private async Task LoadStatusAsync()
    {
        LoadingStatus = true;
        Error = null;
        try
        {
            Original = await Http.GetFromJsonAsync<CollectionOriginalAccessResponse>(StatusUrl);
            PreviewUnavailable = false;
        }
        catch (Exception exception)
        {
            Error = $"Original status could not be loaded: {exception.Message}";
        }
        finally
        {
            LoadingStatus = false;
        }
    }

    private async Task LoadDetailsAsync()
    {
        LoadingDetails = true;
        DetailsError = null;
        try
        {
            Details = await Http.GetFromJsonAsync<PhotoDetailsResponse>(DetailsUrl);
        }
        catch (Exception exception)
        {
            Details = null;
            DetailsError = $"Photo details could not be loaded: {exception.Message}";
        }
        finally
        {
            LoadingDetails = false;
        }
    }

    private async Task LoadTagsAsync()
    {
        LoadingTags = true;
        TagError = null;
        try
        {
            Tags = await Http.GetFromJsonAsync<PhotoTagResponse[]>(TagsUrl) ?? [];
        }
        catch (Exception exception)
        {
            Tags = [];
            TagError = $"Tags could not be loaded: {exception.Message}";
        }
        finally
        {
            LoadingTags = false;
        }
    }

    private async Task AddTagAsync()
    {
        if (TagBusy || string.IsNullOrWhiteSpace(TagInput))
        {
            return;
        }

        string requestedName = TagInput;
        TagBusy = true;
        TagError = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                TagsUrl,
                new PhotoTagMutationRequest(requestedName));
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadTagErrorAsync(response, "Tag could not be added."));
            }

            Tags = await response.Content.ReadFromJsonAsync<PhotoTagResponse[]>() ?? [];
            TagInput = string.Empty;
        }
        catch (Exception exception)
        {
            TagError = exception.Message;
        }
        finally
        {
            TagBusy = false;
        }
    }

    private async Task RemoveTagAsync(string name)
    {
        if (TagBusy)
        {
            return;
        }

        TagBusy = true;
        TagError = null;
        try
        {
            using HttpResponseMessage response = await Http.DeleteAsync(
                $"{TagsUrl}?name={Uri.EscapeDataString(name)}");
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await ReadTagErrorAsync(response, "Tag could not be removed."));
            }

            Tags = await response.Content.ReadFromJsonAsync<PhotoTagResponse[]>() ?? [];
        }
        catch (Exception exception)
        {
            TagError = exception.Message;
        }
        finally
        {
            TagBusy = false;
        }
    }

    private async Task HandleTagKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddTagAsync();
        }
    }

    private static async Task<string> ReadTagErrorAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            PhotoTagErrorResponse? error = await response.Content.ReadFromJsonAsync<PhotoTagErrorResponse>();
            if (!string.IsNullOrWhiteSpace(error?.Error))
            {
                return error.Error;
            }
        }
        catch
        {
            // Fall through to the HTTP status.
        }

        return $"{fallback} HTTP {(int)response.StatusCode}.";
    }

    private async Task HydrateAsync()
    {
        await InvokeOriginalActionAsync($"api/collections/photos/{Uri.EscapeDataString(RevisionId)}/original/hydrate");
    }

    private async Task ReleaseAsync()
    {
        await InvokeOriginalActionAsync($"api/collections/photos/{Uri.EscapeDataString(RevisionId)}/original/release");
    }

    private async Task InvokeOriginalActionAsync(string url)
    {
        Busy = true;
        Error = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsync(url, content: null);
            if (!response.IsSuccessStatusCode)
            {
                ArchiveErrorResponse? error = null;
                try
                {
                    error = await response.Content.ReadFromJsonAsync<ArchiveErrorResponse>();
                }
                catch
                {
                    // Fall through to the HTTP status.
                }

                throw new InvalidOperationException(error?.Error ?? $"Original operation failed with HTTP {(int)response.StatusCode}.");
            }

            Original = await response.Content.ReadFromJsonAsync<CollectionOriginalAccessResponse>();
            PreviewUnavailable = false;
            StartPollingIfNeeded();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void StartPollingIfNeeded()
    {
        if (Original?.State is not ("downloading" or "releasing"))
        {
            StopPolling();
            return;
        }

        if (PollCancellation is not null)
        {
            return;
        }

        PollCancellation = new CancellationTokenSource();
        _ = PollOriginalStateAsync(PollCancellation.Token);
    }

    private async Task PollOriginalStateAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                CollectionOriginalAccessResponse? state = await Http.GetFromJsonAsync<CollectionOriginalAccessResponse>(
                    StatusUrl,
                    cancellationToken);
                if (state is null)
                {
                    return;
                }

                Original = state;
                if (state.State == "ready")
                {
                    PreviewUnavailable = false;
                }

                await InvokeAsync(StateHasChanged);
                if (state.State is not ("downloading" or "releasing"))
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Error = $"Original status polling stopped: {exception.Message}";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            PollCancellation?.Dispose();
            PollCancellation = null;
        }
    }

    private void StopPolling()
    {
        PollCancellation?.Cancel();
    }

    private static string ConfirmedFaceLabel(int count) =>
        count == 1 ? "1 confirmed face" : $"{count} confirmed faces";

    private static string OriginalManagedByLabel(CollectionOriginalAccessResponse original) =>
        original.ManagedHydration
            ? "Photo Identity"
            : original.IsPinned
                ? "OneDrive"
                : "No";

    private static string OriginalStateClass(string state) => state switch
    {
        "ready" => "ready",
        "online-only" => "online-only",
        "downloading" or "releasing" => "busy",
        _ => "attention",
    };

    private static string OriginalStateLabel(string state) => state switch
    {
        "ready" => "Ready",
        "online-only" => "Online-only",
        "downloading" => "Downloading",
        "releasing" => "Releasing",
        "hash-mismatch" => "Needs source verification",
        "unavailable" => "Unavailable",
        "error" => "Error",
        _ => state,
    };

    public ValueTask DisposeAsync()
    {
        StopPolling();
        return ValueTask.CompletedTask;
    }
}
