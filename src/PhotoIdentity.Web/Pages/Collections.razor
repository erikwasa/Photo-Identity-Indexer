@page "/collections"
@using System.Globalization
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Browse collections · Photo Identity</PageTitle>

<section class="hero collection-hero">
    <div>
        <p class="eyebrow">Collection workspace</p>
        <h1>Find photos by person</h1>
        <p>Choose one or more people and browse the matching photos from the private local catalogue.</p>
    </div>

    <aside class="collection-safety-card">
        <strong>Private by default</strong>
        <p>Photos are streamed through opaque local URLs. Source roots and filenames stay on the Windows host.</p>
    </aside>
</section>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="notice error" role="alert">@Error</div>
}

@if (LoadingOptions)
{
    <section class="empty-state" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading people and collection filters…</p>
    </section>
}
else if (People.Count == 0)
{
    <section class="empty-state">
        <h2>No people are available</h2>
        <p>Create and review people before building a collection.</p>
        <a class="button primary" href="/people">Maintain people</a>
    </section>
}
else
{
    <section class="collection-panel" aria-labelledby="collection-people-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">People</p>
                <h2 id="collection-people-heading">Choose collection members</h2>
            </div>
            <span>@SelectedPersonIds.Count selected</span>
        </div>

        <details class="collection-person-dropdown">
            <summary>
                <span class="collection-person-summary-label">People</span>
                <strong>@PersonSelectionSummary</strong>
                <span class="collection-person-chevron" aria-hidden="true">⌄</span>
            </summary>

            <div class="collection-person-menu">
                <label class="collection-person-search" for="collection-person-search">
                    <span class="field-label">Search people</span>
                    <input id="collection-person-search"
                           type="search"
                           placeholder="Type a name"
                           autocomplete="off"
                           @bind="PersonSearch"
                           @bind:event="oninput"
                           disabled="@LoadingResults" />
                </label>

                <div class="collection-inline-actions">
                    <button type="button"
                            class="button secondary"
                            disabled="@(LoadingResults || FilteredPeople.Count == 0)"
                            @onclick="SelectVisiblePeople">
                        Select filtered
                    </button>
                    <button type="button"
                            class="button secondary"
                            disabled="@(LoadingResults || SelectedPersonIds.Count == 0)"
                            @onclick="ClearPeople">
                        Clear selection
                    </button>
                </div>

                <div class="collection-person-picker" role="group" aria-label="People included in the collection query">
                    @if (FilteredPeople.Count == 0)
                    {
                        <p class="collection-person-empty">No people match this search.</p>
                    }
                    else
                    {
                        @foreach (ReviewPersonResponse person in FilteredPeople)
                        {
                            <label class="collection-person-option @(SelectedPersonIds.Contains(person.Id) ? "selected" : "")">
                                <input type="checkbox"
                                       checked="@SelectedPersonIds.Contains(person.Id)"
                                       disabled="@LoadingResults"
                                       @onchange="eventArgs => SetPersonSelection(person.Id, eventArgs)" />
                                <span>@PersonLabel(person)</span>
                            </label>
                        }
                    }
                </div>
            </div>
        </details>

        @if (SelectedPeople.Count > 0)
        {
            <div class="collection-selected-people" aria-label="Selected people">
                @foreach (ReviewPersonResponse person in SelectedPeople)
                {
                    <button type="button"
                            class="collection-person-chip"
                            disabled="@LoadingResults"
                            aria-label="@RemovePersonLabel(person)"
                            @onclick="() => RemovePerson(person.Id)">
                        <span>@PersonLabel(person)</span>
                        <span aria-hidden="true">×</span>
                    </button>
                }
            </div>
        }
    </section>

    <section class="collection-panel" aria-labelledby="collection-filter-heading">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Query policy</p>
                <h2 id="collection-filter-heading">Match and evidence</h2>
            </div>
            <span>@SelectedPersonIds.Count selected</span>
        </div>

        <div class="collection-filter-grid">
            <div>
                <label class="field-label" for="collection-match">People match</label>
                <select id="collection-match"
                        @bind="MatchMode"
                        @bind:after="ClearResults"
                        disabled="@LoadingResults">
                    <option value="all">All selected people</option>
                    <option value="any">Any selected person</option>
                </select>
            </div>

            <div>
                <label class="field-label" for="collection-review-state">Identity evidence</label>
                <select id="collection-review-state"
                        @bind="ReviewState"
                        @bind:after="ReviewStateChanged"
                        disabled="@LoadingResults">
                    <option value="assigned">Confirmed assignments only</option>
                    <option value="all">Confirmed + unreviewed suggestions</option>
                    <option value="unreviewed">Unreviewed suggestions only</option>
                </select>
            </div>

            <div>
                <label class="field-label" for="collection-confidence">Minimum face confidence</label>
                <input id="collection-confidence"
                       type="number"
                       inputmode="decimal"
                       min="0"
                       max="1"
                       step="0.01"
                       placeholder="Optional, 0–1"
                       @bind="MinimumConfidence"
                       @bind:after="ClearResults"
                       disabled="@LoadingResults" />
                <small class="collection-field-help">Filters by detector confidence, not identity-match confidence.</small>
            </div>

            <div>
                <label class="field-label" for="collection-model">Suggestion model revision</label>
                <select id="collection-model"
                        @bind="SelectedModelIndex"
                        @bind:after="ClearResults"
                        disabled="@(!UsesSuggestions || LoadingResults || Options.ModelRevisions.Count == 0)">
                    @if (Options.ModelRevisions.Count == 0)
                    {
                        <option value="">No ranked suggestions available</option>
                    }
                    else
                    {
                        @for (int index = 0; index < Options.ModelRevisions.Count; index++)
                        {
                            ReviewModelRevisionFilterResponse model = Options.ModelRevisions[index];
                            <option value="@index">@ModelLabel(model)</option>
                        }
                    }
                </select>
            </div>

            <div>
                <label class="field-label" for="collection-suggestion-score">Minimum suggestion score</label>
                <input id="collection-suggestion-score"
                       type="number"
                       inputmode="decimal"
                       min="-1"
                       max="1"
                       step="0.01"
                       @bind="MinimumSuggestionScore"
                       @bind:after="ClearResults"
                       disabled="@(!UsesSuggestions || LoadingResults)" />
            </div>
        </div>

        <div class="collection-policy-note">
            @if (UsesSuggestions)
            {
                <strong>Advisory results are enabled.</strong>
                <span>Only rank-one pending suggestions from the exact selected model revision and threshold can qualify.</span>
            }
            else
            {
                <strong>Confirmed-only mode.</strong>
                <span>No model or threshold is inferred.</span>
            }
        </div>

        <button type="button"
                class="button primary collection-run-button"
                disabled="@(LoadingResults || SelectedPersonIds.Count == 0)"
                @onclick="RunQueryAsync">
            @(LoadingResults ? "Building collection…" : "Build collection")
        </button>
    </section>

    @if (Results is CollectionPhotoPageResponse resultPage)
    {
        <section class="collection-results" aria-labelledby="collection-results-heading">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Photo results</p>
                    <h2 id="collection-results-heading">@(resultPage.Total) photo@(resultPage.Total == 1 ? "" : "s")</h2>
                </div>
                <span>@EvidenceLabel(resultPage.Query)</span>
            </div>

            @if (resultPage.Items.Count == 0)
            {
                <div class="empty-state compact">
                    <p>No photos matched the selected people and filters.</p>
                </div>
            }
            else
            {
                <div class="collection-grid">
                    @foreach (CollectionPhotoResponse photo in resultPage.Items)
                    {
                        <article class="collection-card">
                            <a class="collection-photo-link"
                               href="@($"/photo/{photo.RevisionId}")"
                               aria-label="@OpenPhotoLabel(photo)">
                                <img class="collection-photo"
                                     src="@photo.ThumbnailUrl"
                                     alt="@PhotoAltText(photo)"
                                     loading="lazy"
                                     decoding="async" />
                            </a>

                            <div class="collection-card-body">
                                <div class="collection-media-meta">
                                    <span>@MediaLabel(photo.MediaType)</span>
                                    @if (photo.Width is int width && photo.Height is int height)
                                    {
                                        <span>@width × @height</span>
                                    }
                                </div>

                                <ul class="collection-match-list">
                                    @foreach (CollectionPersonMatchResponse match in photo.People)
                                    {
                                        <li>
                                            <strong>@match.DisplayName</strong>
                                            <span>@EvidenceSummary(match)</span>
                                        </li>
                                    }
                                </ul>

                                <details class="collection-identifiers">
                                    <summary>Manifest identifiers</summary>
                                    <code>asset @photo.AssetId</code>
                                    <code>revision @photo.RevisionId</code>
                                </details>
                            </div>
                        </article>
                    }
                </div>

                <nav class="pagination" aria-label="Collection result pages">
                    <button type="button"
                            class="button secondary"
                            disabled="@(LoadingResults || resultPage.Offset == 0)"
                            @onclick="PreviousPageAsync">
                        Previous
                    </button>
                    <span>Showing @FirstResult–@LastResult</span>
                    <button type="button"
                            class="button secondary"
                            disabled="@(LoadingResults || resultPage.Offset + resultPage.Items.Count >= resultPage.Total)"
                            @onclick="NextPageAsync">
                        Next
                    </button>
                </nav>
            }
        </section>
    }
}

@code {
    private const int PageSize = 40;

    private IReadOnlyList<ReviewPersonResponse> People { get; set; } = [];
    private ReviewFilterOptionsResponse Options { get; set; } = new([], []);
    private HashSet<string> SelectedPersonIds { get; } = new(StringComparer.Ordinal);
    private CollectionPhotoPageResponse? Results { get; set; }
    private string PersonSearch { get; set; } = "";
    private string MatchMode { get; set; } = "all";
    private string ReviewState { get; set; } = "assigned";
    private string SelectedModelIndex { get; set; } = "";
    private string MinimumConfidence { get; set; } = "";
    private string MinimumSuggestionScore { get; set; } = "0.9";
    private string? AppliedQuery { get; set; }
    private bool LoadingOptions { get; set; } = true;
    private bool LoadingResults { get; set; }
    private string? Error { get; set; }

    private bool UsesSuggestions => ReviewState is "all" or "unreviewed";

    private IReadOnlyList<ReviewPersonResponse> FilteredPeople => People
        .Where(person =>
            string.IsNullOrWhiteSpace(PersonSearch) ||
            person.DisplayName.Contains(PersonSearch.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(person => person.IsFavorite)
        .ThenBy(person => person.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ThenBy(person => person.Id, StringComparer.Ordinal)
        .ToArray();

    private IReadOnlyList<ReviewPersonResponse> SelectedPeople => People
        .Where(person => SelectedPersonIds.Contains(person.Id))
        .OrderByDescending(person => person.IsFavorite)
        .ThenBy(person => person.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ThenBy(person => person.Id, StringComparer.Ordinal)
        .ToArray();

    private string PersonSelectionSummary => SelectedPersonIds.Count switch
    {
        0 => "Choose people",
        1 => "1 person selected",
        _ => $"{SelectedPersonIds.Count} people selected",
    };

    private ReviewModelRevisionFilterResponse? SelectedModel =>
        int.TryParse(SelectedModelIndex, NumberStyles.Integer, CultureInfo.InvariantCulture, out int index) &&
        index >= 0 && index < Options.ModelRevisions.Count
            ? Options.ModelRevisions[index]
            : null;

    private int FirstResult => Results is null || Results.Items.Count == 0 ? 0 : Results.Offset + 1;
    private int LastResult => Results is null ? 0 : Results.Offset + Results.Items.Count;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Task<ReviewPersonResponse[]?> peopleTask =
                Http.GetFromJsonAsync<ReviewPersonResponse[]>("api/review/people");
            Task<ReviewFilterOptionsResponse?> optionsTask =
                Http.GetFromJsonAsync<ReviewFilterOptionsResponse>("api/review/filters");
            await Task.WhenAll(peopleTask, optionsTask);

            People = (await peopleTask) ?? [];
            Options = (await optionsTask) ?? new([], []);
            if (Options.ModelRevisions.Count > 0)
            {
                SelectedModelIndex = "0";
            }
        }
        catch (Exception exception)
        {
            Error = $"Collection filters could not be loaded: {exception.Message}";
        }
        finally
        {
            LoadingOptions = false;
        }
    }

    private void SelectVisiblePeople()
    {
        foreach (ReviewPersonResponse person in FilteredPeople)
        {
            SelectedPersonIds.Add(person.Id);
        }

        ClearResults();
    }

    private void ClearPeople()
    {
        SelectedPersonIds.Clear();
        ClearResults();
    }

    private void RemovePerson(string personId)
    {
        SelectedPersonIds.Remove(personId);
        ClearResults();
    }

    private void SetPersonSelection(string personId, ChangeEventArgs eventArgs)
    {
        bool selected = eventArgs.Value is bool value && value;
        if (selected)
        {
            SelectedPersonIds.Add(personId);
        }
        else
        {
            SelectedPersonIds.Remove(personId);
        }

        ClearResults();
    }

    private void ReviewStateChanged()
    {
        Error = null;
        ClearResults();
    }

    private void ClearResults()
    {
        Results = null;
        AppliedQuery = null;
    }

    private async Task RunQueryAsync()
    {
        Error = null;
        Results = null;
        AppliedQuery = null;

        if (!TryBuildQuery(out string query))
        {
            return;
        }

        AppliedQuery = query;
        await LoadPageAsync(0);
    }

    private async Task PreviousPageAsync()
    {
        if (Results is not null)
        {
            await LoadPageAsync(Math.Max(0, Results.Offset - PageSize));
        }
    }

    private async Task NextPageAsync()
    {
        if (Results is not null)
        {
            await LoadPageAsync(Results.Offset + PageSize);
        }
    }

    private async Task LoadPageAsync(int offset)
    {
        if (string.IsNullOrWhiteSpace(AppliedQuery))
        {
            return;
        }

        LoadingResults = true;
        Error = null;
        try
        {
            using HttpResponseMessage response = await Http.GetAsync(
                $"api/collections/photos?{AppliedQuery}&offset={offset}&limit={PageSize}");
            if (!response.IsSuccessStatusCode)
            {
                Error = $"The collection query failed with status {(int)response.StatusCode}.";
                return;
            }

            Results = await response.Content.ReadFromJsonAsync<CollectionPhotoPageResponse>()
                ?? throw new InvalidOperationException("The collection response was empty.");
        }
        catch (Exception exception)
        {
            Error = $"The collection could not be loaded: {exception.Message}";
        }
        finally
        {
            LoadingResults = false;
        }
    }

    private bool TryBuildQuery(out string query)
    {
        query = "";
        if (SelectedPersonIds.Count == 0)
        {
            Error = "Choose at least one person.";
            return false;
        }

        if (!TryOptionalDouble(MinimumConfidence, 0, 1, "Minimum face confidence", out double? confidence))
        {
            return false;
        }

        List<string> parameters =
        [
            $"people={Uri.EscapeDataString(string.Join(',', SelectedPersonIds.OrderBy(value => value, StringComparer.Ordinal)))}",
            $"match={Uri.EscapeDataString(MatchMode)}",
            $"reviewState={Uri.EscapeDataString(ReviewState)}",
        ];

        if (confidence is double minimumConfidence)
        {
            parameters.Add($"minimumConfidence={minimumConfidence.ToString(CultureInfo.InvariantCulture)}");
        }

        if (UsesSuggestions)
        {
            if (SelectedModel is not ReviewModelRevisionFilterResponse model)
            {
                Error = "Choose an exact suggestion model revision.";
                return false;
            }

            if (!TryOptionalDouble(
                    MinimumSuggestionScore,
                    -1,
                    1,
                    "Minimum suggestion score",
                    out double? suggestionScore) ||
                suggestionScore is null)
            {
                Error ??= "Supply a minimum suggestion score.";
                return false;
            }

            parameters.Add("includeSuggestions=true");
            parameters.Add($"suggestionModelId={Uri.EscapeDataString(model.ModelId)}");
            parameters.Add($"suggestionModelHash={Uri.EscapeDataString(model.ModelHash)}");
            parameters.Add($"minimumSuggestionScore={suggestionScore.Value.ToString(CultureInfo.InvariantCulture)}");
        }

        query = string.Join('&', parameters);
        return true;
    }

    private bool TryOptionalDouble(
        string value,
        double minimum,
        double maximum,
        string label,
        out double? parsed)
    {
        parsed = null;
        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (!double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out double result) ||
            double.IsNaN(result) ||
            double.IsInfinity(result) ||
            result < minimum ||
            result > maximum)
        {
            Error = $"{label} must be between {minimum} and {maximum}.";
            return false;
        }

        parsed = result;
        return true;
    }

    private static string ModelLabel(ReviewModelRevisionFilterResponse model) =>
        $"{model.ModelId} · {model.ModelHash[..Math.Min(12, model.ModelHash.Length)]}";

    private static string PersonLabel(ReviewPersonResponse person) =>
        person.IsFavorite ? $"★ {person.DisplayName}" : person.DisplayName;

    private static string EvidenceSummary(CollectionPersonMatchResponse match)
    {
        List<string> evidence = [];
        if (match.ConfirmedFaceCount > 0)
        {
            evidence.Add($"{match.ConfirmedFaceCount} confirmed");
        }

        if (match.SuggestedFaceCount > 0)
        {
            string score = match.MaximumSuggestionScore is double value
                ? $", max {value:F3}"
                : "";
            evidence.Add($"{match.SuggestedFaceCount} suggested{score}");
        }

        return evidence.Count == 0 ? "No qualifying evidence" : string.Join(" · ", evidence);
    }

    private static string EvidenceLabel(CollectionQueryResponse query) => query.ReviewState switch
    {
        "assigned" => "Confirmed assignments",
        "unreviewed" => "Unreviewed suggestions",
        _ => "Confirmed + suggested",
    };

    private static string MediaLabel(string? mediaType) => mediaType?.ToLowerInvariant() switch
    {
        "image/jpeg" => "JPEG",
        "image/png" => "PNG",
        "image/webp" => "WebP",
        _ => "Photo",
    };

    private static string PhotoAltText(CollectionPhotoResponse photo) =>
        $"Photo matching {string.Join(", ", photo.People.Select(person => person.DisplayName))}";

    private static string OpenPhotoLabel(CollectionPhotoResponse photo) =>
        $"Open photo matching {string.Join(", ", photo.People.Select(person => person.DisplayName))}";

    private static string RemovePersonLabel(ReviewPersonResponse person) =>
        $"Remove {person.DisplayName} from the collection";
}
