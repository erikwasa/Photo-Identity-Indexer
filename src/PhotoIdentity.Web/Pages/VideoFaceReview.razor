@page "/video-face-review"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Video face review · Photo Identity</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmInternalNavigation" />

<section class="hero">
    <div>
        <p class="eyebrow">Video library · people review</p>
        <h1>Video face review</h1>
        <p>Review detected faces to identify people in a video. Choose a named suggestion, search your people catalogue, or mark a face unknown or incorrect. Reviewed faces are hidden by default and can be reopened.</p>
    </div>
    <a class="button secondary" href="/videos">Back to videos</a>
</section>

<section class="vfr-intro" aria-label="Private video review import">
    <h2>Load a private evidence package</h2>
    <p>Use the <code>presence-first-web-review.json</code> created by the explicit WI-0155 offline <code>-PresenceFirst</code> runner. This package contains personal face crops. Select it only in your trusted local Photo Identity browser; it is read in browser memory and is not sent to the server.</p>
    <label class="vfr-import">
        <span>Private review package (JSON)</span>
        <input id="vfr-bundle" type="file" accept=".json,application/json" />
    </label>
    <label id="vfr-legacy-map-label" class="vfr-import" hidden>
        <span>Legacy v2 only: private people map (JSON)</span>
        <input id="vfr-people-map" type="file" accept=".json,application/json" />
    </label>
    <p id="vfr-people-status" role="status" aria-live="polite">No private names loaded.</p>
    <input id="vfr-csv" type="file" accept=".csv,text/csv" hidden aria-label="Import saved review CSV" />
    <p id="vfr-load-status" role="status" aria-live="polite">No private evidence loaded.</p>
    <p>For a version 3 review package, names are read from the current Photo Identity database; no separate people-list file is imported in the browser. Each suggested person is a human review lead, never an automatic identification. Click a suggestion to confirm it for one face, or search the current catalogue. Historical aliases are bound to canonical IDs in the package; people added after that snapshot require refreshed evidence before confirmation. Crops remain native size with no upscaling. Export your review CSV before leaving. Identity decisions are not yet written to the production database.</p>
</section>

<div id="vfr-root" class="vfr-root"></div>

@code {
    private async Task ConfirmInternalNavigation(LocationChangingContext context)
    {
        if (await JS.InvokeAsync<bool>("photoIdentityVideoFaceReview.hasUnsavedChanges") &&
            !await JS.InvokeAsync<bool>("confirm",
                "Leave this page and discard unsaved private review decisions?"))
            context.PreventNavigation();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("photoIdentityVideoFaceReview.dispose"); }
        catch (JSDisconnectedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("photoIdentityVideoFaceReview.init");
    }
}
