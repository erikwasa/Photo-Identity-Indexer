@page "/detector-comparisons/{ComparisonId:guid}"
@using System.Globalization
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Detector comparison · Photo Identity</PageTitle>

@if (!string.IsNullOrWhiteSpace(Error)) { <div class="notice error" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Success)) { <div class="notice success comparison-save-success" role="status">@Success</div> }
@if (Loading)
{
    <section class="empty-state"><p>Loading detector comparison…</p></section>
}
else if (Comparison is null)
{
    <section class="empty-state"><h1>Comparison not found</h1><a href="/detector-comparisons">Back</a></section>
}
else
{
    <section class="comparison-detail-header">
        <div>
            <a href="/detector-comparisons">← All comparisons</a>
            <p class="eyebrow">Candidate comparison</p>
            <h1>@Comparison.Name</h1>
            <p>Baseline @Comparison.BaselineName · IoU @Comparison.IouThreshold.ToString("0.00", CultureInfo.InvariantCulture)</p>
        </div>
        <a class="button secondary" href="@($"/api/detector-evaluation/comparisons/{Comparison.Id}/export.csv")">Export summaries</a>
    </section>

    <section class="comparison-exceptions">
        <div class="section-heading">
            <div><p class="eyebrow">Manual review only</p><h2>Photos requiring a decision</h2></div>
            <span>@Comparison.ExceptionPhotos.Count</span>
        </div>
        @if (Comparison.ExceptionPhotos.Count == 0)
        {
            <div class="notice success">All candidate detections have been resolved. Record the qualitative gate assessment below.</div>
        }
        else if (CurrentPhoto is not null)
        {
            var photo = CurrentPhoto;
            var draft = Drafts[photo.CandidateRevisionId];
            <article class="comparison-review-workspace" @ref="WorkspaceElement" @key="photo.CandidateRevisionId">
                <nav class="comparison-photo-navigation" aria-label="Comparison photo navigation">
                    <button class="button secondary" disabled="@(Busy || CurrentPhotoIndex == 0)" @onclick="ShowPreviousPhoto">← Previous</button>
                    <div>
                        <strong>Photo @(CurrentPhotoIndex + 1) of @Comparison.ExceptionPhotos.Count</strong>
                        <span>@photo.PhotoName</span>
                    </div>
                    <button class="button secondary" disabled="@(Busy || CurrentPhotoIndex >= Comparison.ExceptionPhotos.Count - 1)" @onclick="ShowNextPhoto">Next →</button>
                </nav>

                <header class="comparison-workspace-header">
                    <div>
                        <h3>@photo.PhotoName</h3>
                        <p>@photo.AutomaticMatchCount automatically matched faces · @photo.CountableFaces reference faces · @photo.SourceGroup · @photo.PrimaryCategory</p>
                    </div>
                    <span class="state-badge @(IsDraftResolved(photo, draft) ? "resolved" : "needs-review")">@(IsDraftResolved(photo, draft) ? "Ready to save" : "Needs review")</span>
                </header>

                <div class="comparison-workspace-body">
                    <section class="comparison-image-column" aria-label="Comparison image">
                        <div class="comparison-image-toolbar" aria-label="Image zoom controls">
                            <div class="comparison-zoom-controls" role="group" aria-label="Zoom level">
                                <button type="button" class="@ZoomButtonClass(null)" disabled="@Busy" title="Fit and reset view" @onclick="() => SetZoomAsync(null)">Fit</button>
                                <button type="button" class="@ZoomButtonClass(1)" disabled="@Busy" @onclick="() => SetZoomAsync(1)">100%</button>
                                <button type="button" class="@ZoomButtonClass(2)" disabled="@Busy" @onclick="() => SetZoomAsync(2)">200%</button>
                                <button type="button" class="@ZoomButtonClass(4)" disabled="@Busy" @onclick="() => SetZoomAsync(4)">400%</button>
                                <button type="button" class="comparison-zoom-step" disabled="@(Busy || !ViewState.CanZoomOut)" aria-label="Zoom out" @onclick="ZoomOutAsync">−</button>
                                <button type="button" class="comparison-zoom-step" disabled="@(Busy || !ViewState.CanZoomIn)" aria-label="Zoom in" @onclick="ZoomInAsync">+</button>
                            </div>
                            <div class="comparison-view-controls">
                                <span>@ViewState.ZoomLabel</span>
                                <a href="@photo.ContentUrl" target="_blank" rel="noopener">Open original</a>
                            </div>
                        </div>

                        <div class="comparison-photo-viewport @(ViewState.ZoomScale is null ? "fit-mode" : "zoom-mode")" @ref="ViewportElement">
                            <div class="comparison-photo-stage" @ref="StageElement">
                                <img src="@photo.ContentUrl" @ref="ImageElement" @onload="HandleImageLoadedAsync" alt="@photo.PhotoName with reference and candidate face boxes" />
                                @foreach (var face in ExceptionGroundTruthFaces(photo))
                                {
                                    string referenceKey = ReferenceReviewKey(face.Id);
                                    string decisionId = ReferenceDecisionId(photo, face.Id);
                                    <button type="button"
                                            class="comparison-box ground-truth @ReviewActiveClass(referenceKey)"
                                            style="@BoxStyle(face.BoundingBox)"
                                            title="@ReferenceFaceLabel(photo, face.Id)"
                                            aria-label="Show @ReferenceFaceLabel(photo, face.Id) decision"
                                            aria-controls="@decisionId"
                                            @onclick="() => FocusDecisionAsync(referenceKey, decisionId)"
                                            @onmouseenter="() => SetActiveReviewKey(referenceKey)"
                                            @onmouseleave="() => ClearActiveReviewKey(referenceKey)"
                                            @onfocus="() => SetActiveReviewKey(referenceKey)"
                                            @onblur="() => ClearActiveReviewKey(referenceKey)">
                                        <span>R@(ReferenceFaceNumber(photo, face.Id))</span>
                                    </button>
                                }
                                @foreach (var candidate in ExceptionCandidates(photo))
                                {
                                    string candidateKey = CandidateReviewKey(candidate.Id);
                                    string decisionId = CandidateDecisionId(candidate);
                                    <button type="button"
                                            class="comparison-box candidate @ReviewActiveClass(candidateKey)"
                                            style="@BoxStyle(candidate.BoundingBox)"
                                            title="Candidate detection @candidate.FaceNumber"
                                            aria-label="Show candidate detection @candidate.FaceNumber decision"
                                            aria-controls="@decisionId"
                                            @onclick="() => FocusDecisionAsync(candidateKey, decisionId)"
                                            @onmouseenter="() => SetActiveReviewKey(candidateKey)"
                                            @onmouseleave="() => ClearActiveReviewKey(candidateKey)"
                                            @onfocus="() => SetActiveReviewKey(candidateKey)"
                                            @onblur="() => ClearActiveReviewKey(candidateKey)">
                                        <span>C@(candidate.FaceNumber)</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="comparison-overlay-legend" aria-label="Overlay legend">
                            <span><span class="comparison-legend-marker reference">R</span> Reference face</span>
                            <span><span class="comparison-legend-marker candidate">C</span> Candidate detection</span>
                            <span class="comparison-pan-hint">Zoomed images can be dragged or scrolled to pan.</span>
                        </div>
                    </section>

                    <aside class="comparison-decision-panel" @ref="DecisionPanelElement" aria-label="Decisions for current photo">
                        <p class="comparison-photo-explanation">The automatic count is already accepted. Resolve only the orange and green boxes shown in the image.</p>
                        <div class="comparison-component-list">
                            @foreach (var component in photo.ExceptionComponents)
                            {
                                <section class="comparison-component">
                                    <h4>@ComponentTitle(photo, component)</h4>
                                    <p class="comparison-component-help">@ComponentHelp(photo, component)</p>
                                    @if (IsAutomaticMissComponent(photo, component))
                                    {
                                        @foreach (var face in component.GroundTruthFaces)
                                        {
                                            string referenceKey = ReferenceReviewKey(face.Id);
                                            string decisionId = ReferenceDecisionId(photo, face.Id);
                                            <div id="@decisionId"
                                                 tabindex="0"
                                                 class="comparison-resolution-row automatic-miss-row @ReviewActiveClass(referenceKey)"
                                                 @onmouseenter="() => SetActiveReviewKey(referenceKey)"
                                                 @onmouseleave="() => ClearActiveReviewKey(referenceKey)"
                                                 @onfocus="() => SetActiveReviewKey(referenceKey)"
                                                 @onblur="() => ClearActiveReviewKey(referenceKey)">
                                                <span><strong>@ReferenceFaceLabel(photo, face.Id)</strong><small>@GroundTruthOriginLabel(face.Origin)</small></span>
                                                <span class="automatic-miss-status"><span aria-hidden="true">✓</span> Counted as detector miss automatically</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var candidate in component.CandidateDetections)
                                        {
                                            string candidateKey = CandidateReviewKey(candidate.Id);
                                            string decisionId = CandidateDecisionId(candidate);
                                            <label class="comparison-resolution-row @ReviewActiveClass(candidateKey)"
                                                   @onmouseenter="() => SetActiveReviewKey(candidateKey)"
                                                   @onmouseleave="() => ClearActiveReviewKey(candidateKey)">
                                                <span><strong>Candidate detection @candidate.FaceNumber</strong><small>Confidence @candidate.Confidence.ToString("0.000", CultureInfo.InvariantCulture)</small></span>
                                                <select id="@decisionId"
                                                        value="@CandidateAction(draft, candidate.Id)"
                                                        @onchange="args => SetCandidateAction(draft, candidate.Id, args.Value?.ToString())"
                                                        @onfocus="() => SetActiveReviewKey(candidateKey)"
                                                        @onblur="() => ClearActiveReviewKey(candidateKey)">
                                                    <option value="">Choose outcome…</option>
                                                    @foreach (var face in ExceptionGroundTruthFaces(photo))
                                                    {
                                                        <option value="@($"match:{face.Id}")">Match to @ReferenceFaceLabel(photo, face.Id)</option>
                                                    }
                                                    <option value="neutral">Neutral — legitimate detection outside countable scope</option>
                                                    <option value="false">False detection — not a countable face</option>
                                                    <option value="duplicate">Duplicate — same face detected again</option>
                                                </select>
                                            </label>
                                        }
                                        @foreach (var face in component.GroundTruthFaces)
                                        {
                                            string referenceKey = ReferenceReviewKey(face.Id);
                                            string decisionId = ReferenceDecisionId(photo, face.Id);
                                            <label class="comparison-resolution-row checkbox-row @ReviewActiveClass(referenceKey)"
                                                   @onmouseenter="() => SetActiveReviewKey(referenceKey)"
                                                   @onmouseleave="() => ClearActiveReviewKey(referenceKey)">
                                                <span><strong>@ReferenceFaceLabel(photo, face.Id)</strong><small>@GroundTruthOriginLabel(face.Origin)</small></span>
                                                <span>
                                                    <input id="@decisionId"
                                                           type="checkbox"
                                                           checked="@draft.MissedGroundTruthFaceIds.Contains(face.Id)"
                                                           disabled="@IsGroundTruthMatched(draft, face.Id)"
                                                           @onchange="args => SetMissed(draft, face.Id, args.Value is true)"
                                                           @onfocus="() => SetActiveReviewKey(referenceKey)"
                                                           @onblur="() => ClearActiveReviewKey(referenceKey)" />
                                                    Detector missed this reference face
                                                </span>
                                            </label>
                                        }
                                    }
                                </section>
                            }
                        </div>
                        <label class="comparison-notes">
                            <span>Optional correction notes</span>
                            <textarea @bind="draft.Notes" rows="2" placeholder="Add a neutral note only when it helps explain the decision"></textarea>
                        </label>
                    </aside>
                </div>

                <footer class="comparison-workspace-footer">
                    <span class="comparison-resolution-status @(IsDraftResolved(photo, draft) ? "complete" : "incomplete")">@ResolutionLabel(photo, draft)</span>
                    <div class="comparison-save-actions">
                        <button class="button secondary" disabled="@Busy" @onclick="() => SavePhotoAsync(photo, draft, false)">Save</button>
                        <button class="button primary" disabled="@(Busy || !IsDraftResolved(photo, draft))" @onclick="() => SavePhotoAsync(photo, draft, true)">Save and next</button>
                    </div>
                </footer>
            </article>
        }
    </section>

    <details class="comparison-details" open="@(Comparison.ExceptionPhotos.Count == 0)">
        <summary>Comparison metrics, gate assessment and review instructions</summary>
        <div class="comparison-details-content">
            <section class="comparison-metric-grid">
                @MetricCard("Overall recall", Comparison.Overall.Recall, Comparison.Overall.MatchedFaces, Comparison.Overall.CountableFaces)
                @MetricCard("Five-plus recall", Comparison.FivePlusFaces.Recall, Comparison.FivePlusFaces.MatchedFaces, Comparison.FivePlusFaces.CountableFaces)
                <article><span>False + duplicate</span><strong>@(Comparison.Overall.FalseDetections + Comparison.Overall.DuplicateDetections)</strong><small>limit @Comparison.M16Gate.FalseOrDuplicateLimit · @Comparison.Overall.NeutralDetections neutral excluded</small></article>
                <article class="@GateStatusClass(Comparison.M16Gate.Status)"><span>M16 gate</span><strong>@Comparison.M16Gate.Status.ToUpperInvariant()</strong><small>@GateDetail(Comparison.M16Gate)</small></article>
            </section>
            <section class="comparison-gate-card">
                <div><p class="eyebrow">M16 qualitative gate</p><h2>Material failure category</h2></div>
                <div class="comparison-gate-form">
                    <select @bind="MaterialCategoryValue"><option value="">Pending</option><option value="false">No material failure</option><option value="true">Material failure exists</option></select>
                    <textarea @bind="GateNotes" rows="2" placeholder="Gate notes"></textarea>
                    <button class="button primary" disabled="@Busy" @onclick="SaveGateAsync">Save gate assessment</button>
                </div>
            </section>
            <section class="comparison-summary-tables">@SummaryTable("Source groups", Comparison.SourceGroups)@SummaryTable("Categories", Comparison.Categories)</section>
            <section class="comparison-review-guide" aria-labelledby="comparison-review-guide-title">
                <p class="eyebrow">How to review</p>
                <h2 id="comparison-review-guide-title">Resolve only the boxes that could not be matched automatically</h2>
                <div class="comparison-guide-grid">
                    <p><strong>Candidate detection</strong> is a face box produced by the detector run being evaluated. Candidate boxes are orange and dashed.</p>
                    <p><strong>Reference face</strong> is a countable face retained from the reviewed baseline. Reference boxes are green.</p>
                    <p><strong>Automatically matched</strong> means the candidate and reference boxes formed a clear one-to-one match and need no action.</p>
                    <p><strong>Neutral</strong> means the candidate is a legitimate face detection that is outside the fixed countable-face scope. It resolves the candidate without increasing recall and without counting as false or duplicate.</p>
                    <p>When a photo has reference faces to review but no candidate review boxes, those faces are counted as detector misses automatically. Use the missed-face checkbox only when candidate boxes are present but none represents that reference face.</p>
                </div>
            </section>
        </div>
    </details>
}
