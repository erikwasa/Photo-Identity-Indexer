@page "/detector-comparisons/{ComparisonId:guid}"
@using System.Globalization
@inject HttpClient Http

<PageTitle>Detector comparison · Photo Identity</PageTitle>

@if (!string.IsNullOrWhiteSpace(Error)) { <div class="notice error" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Success)) { <div class="notice success" role="status">@Success</div> }
@if (Loading)
{
    <section class="empty-state"><p>Loading detector comparison…</p></section>
}
else if (Comparison is null)
{
    <section class="empty-state"><h1>Comparison not found</h1><a href="/detector-comparisons">Back</a></section>
}
else
{
    <section class="comparison-detail-header"><div><a href="/detector-comparisons">← All comparisons</a><p class="eyebrow">Candidate comparison</p><h1>@Comparison.Name</h1><p>Baseline @Comparison.BaselineName · IoU @Comparison.IouThreshold.ToString("0.00", CultureInfo.InvariantCulture)</p></div><a class="button secondary" href="@($"/api/detector-evaluation/comparisons/{Comparison.Id}/export.csv")">Export summaries</a></section>
    <section class="comparison-metric-grid">@MetricCard("Overall recall", Comparison.Overall.Recall, Comparison.Overall.MatchedFaces, Comparison.Overall.CountableFaces)@MetricCard("Five-plus recall", Comparison.FivePlusFaces.Recall, Comparison.FivePlusFaces.MatchedFaces, Comparison.FivePlusFaces.CountableFaces)<article><span>False + duplicate</span><strong>@(Comparison.Overall.FalseDetections + Comparison.Overall.DuplicateDetections)</strong><small>limit @Comparison.M16Gate.FalseOrDuplicateLimit</small></article><article><span>M16 gate</span><strong>@Comparison.M16Gate.Status.ToUpperInvariant()</strong><small>@GateDetail(Comparison.M16Gate)</small></article></section>
    <section class="comparison-gate-card"><div><p class="eyebrow">M16 qualitative gate</p><h2>Material failure category</h2></div><div class="comparison-gate-form"><select @bind="MaterialCategoryValue"><option value="">Pending</option><option value="false">No material failure</option><option value="true">Material failure exists</option></select><textarea @bind="GateNotes" rows="2" placeholder="Gate notes"></textarea><button class="button primary" disabled="@Busy" @onclick="SaveGateAsync">Save gate assessment</button></div></section>
    <section class="comparison-summary-tables">@SummaryTable("Source groups", Comparison.SourceGroups)@SummaryTable("Categories", Comparison.Categories)</section>
    <section class="comparison-exceptions"><div class="section-heading"><div><p class="eyebrow">Manual review only</p><h2>Unmatched, duplicate or ambiguous photos</h2></div><span>@Comparison.ExceptionPhotos.Count</span></div>
        @if (Comparison.ExceptionPhotos.Count == 0) { <div class="notice success">All candidate detections matched one-to-one. Record the qualitative gate.</div> }
        @foreach (var photo in Comparison.ExceptionPhotos)
        {
            var draft = Drafts[photo.CandidateRevisionId];
            <article class="comparison-photo-card"><header><div><h3>@photo.PhotoName</h3><p>@photo.AutomaticMatchCount automatic · @photo.CountableFaces countable · @photo.SourceGroup · @photo.PrimaryCategory</p></div><span class="state-badge">@(photo.IsResolved ? "Resolved" : "Needs review")</span></header>
                <div class="comparison-photo-stage"><img src="@photo.ContentUrl" alt="@photo.PhotoName" loading="lazy" />@foreach (var face in ExceptionGroundTruthFaces(photo)) { <div class="comparison-box ground-truth" style="@BoxStyle(face.BoundingBox)"><span>GT @ShortId(face.Id)</span></div> }@foreach (var candidate in ExceptionCandidates(photo)) { <div class="comparison-box candidate" style="@BoxStyle(candidate.BoundingBox)"><span>C@candidate.FaceNumber</span></div> }</div>
                @foreach (var component in photo.ExceptionComponents)
                {
                    <section class="comparison-component"><h4><span class="state-badge">@component.Kind</span> @component.Id</h4>
                        @foreach (var candidate in component.CandidateDetections) { <label class="comparison-resolution-row"><span>Candidate @candidate.FaceNumber · @candidate.Confidence.ToString("0.000", CultureInfo.InvariantCulture)</span><select value="@CandidateAction(draft, candidate.Id)" @onchange="args => SetCandidateAction(draft, candidate.Id, args.Value?.ToString())"><option value="">Unresolved</option>@foreach (var face in ExceptionGroundTruthFaces(photo)) { <option value="@($"match:{face.Id}")">Match GT @ShortId(face.Id)</option> }<option value="false">False detection</option><option value="duplicate">Duplicate detection</option></select></label> }
                        @foreach (var face in component.GroundTruthFaces) { <label class="comparison-resolution-row checkbox-row"><span>Ground truth @ShortId(face.Id) · @face.Origin</span><span><input type="checkbox" checked="@draft.MissedGroundTruthFaceIds.Contains(face.Id)" disabled="@IsGroundTruthMatched(draft, face.Id)" @onchange="args => SetMissed(draft, face.Id, args.Value is true)" /> Candidate missed this face</span></label> }
                    </section>
                }
                <textarea @bind="draft.Notes" rows="2" placeholder="Correction notes"></textarea><footer><span>@ResolutionLabel(photo, draft)</span><button class="button primary" disabled="@Busy" @onclick="() => SavePhotoAsync(photo, draft)">Save corrections</button></footer>
            </article>
        }
    </section>
}
