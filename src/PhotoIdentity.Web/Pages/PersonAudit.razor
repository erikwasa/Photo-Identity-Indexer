@page "/audit"
@using System.Globalization
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Audit assignments · Photo Identity</PageTitle>

<section class="hero audit-hero">
    <div>
        <p class="eyebrow">Identity verification</p>
        <h1>Audit assignments</h1>
        <p>Skim current assignments across the catalogue. Results are grouped by person, and automatic assignments put the weakest accepted margins first.</p>
    </div>
</section>

<section class="audit-controls" aria-label="Assignment audit filters">
    <div>
        <label class="field-label" for="audit-source">Assignment source</label>
        <select id="audit-source" @bind="SelectedSource" disabled="@Loading">
            <option value="automatic">Automatic</option>
            <option value="manual">Manual</option>
            <option value="all">All</option>
        </select>
    </div>

    <div>
        <label class="field-label" for="audit-from">From · local time</label>
        <input id="audit-from"
               type="datetime-local"
               @bind="FromLocal"
               @bind:format="yyyy-MM-ddTHH:mm"
               disabled="@Loading" />
    </div>

    <div>
        <label class="field-label" for="audit-to">To · local time</label>
        <input id="audit-to"
               type="datetime-local"
               @bind="ToLocal"
               @bind:format="yyyy-MM-ddTHH:mm"
               disabled="@Loading" />
    </div>

    <div>
        <label class="field-label" for="audit-model">Current suggestion comparison</label>
        <select id="audit-model" @bind="SelectedModelKey" disabled="@(Loading || ModelRevisions.Count == 0)">
            <option value="">No comparison</option>
            @foreach (ReviewModelRevisionFilterResponse model in ModelRevisions)
            {
                <option value="@ModelKey(model)">@model.ModelId · @HashPrefix(model.ModelHash)</option>
            }
        </select>
    </div>

    <button class="button primary audit-apply" @onclick="ApplyFilters" disabled="@Loading">
        Apply filters
    </button>
</section>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="notice error" role="alert">@Error</div>
}

@if (Loading && Items.Count == 0)
{
    <section class="empty-state" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading assignments…</p>
    </section>
}
else if (Items.Count == 0)
{
    <section class="empty-state">
        <h2>No assignments in this view</h2>
        <p>Adjust the assignment source or time range and try again.</p>
    </section>
}
else
{
    <section class="audit-summary" aria-label="Audit summary">
        <div>
            <strong>@Total</strong>
            <span>matching current assignment@(Total == 1 ? "" : "s")</span>
        </div>
        <div>
            <strong>@LoadedPersonCount</strong>
            <span>people represented in the loaded results</span>
        </div>
        <div>
            <strong>@Items.Count / @Total</strong>
            <span>assignments loaded</span>
        </div>
    </section>

    <div class="audit-groups">
        @foreach (IGrouping<string, AssignmentAuditFaceResponse> group in Groups)
        {
            AssignmentAuditFaceResponse first = group.First();
            <section class="audit-person-group" id="@PersonAnchor(first.AssignedPerson.Id)">
                <header class="audit-person-header">
                    <div>
                        <h2>@first.AssignedPerson.DisplayName</h2>
                        <span>@group.Count() loaded assignment@(group.Count() == 1 ? "" : "s")</span>
                    </div>
                    @if (WeakestMargin(group) is double weakestMargin)
                    {
                        <span class="person-margin">weakest margin @weakestMargin.ToString("0.0000")</span>
                    }
                </header>

                <div class="audit-grid" aria-label="Assignments for @first.AssignedPerson.DisplayName">
                    @foreach (AssignmentAuditFaceResponse face in group)
                    {
                        <article class="audit-card @(face.CurrentSuggestionDisagrees ? "has-disagreement" : "")">
                            <a class="audit-image-link"
                               href="@BuildDetailsUrl(face)"
                               aria-label="Open audit history for @face.PhotoName face @(face.FaceOrdinal + 1)">
                                <img src="@face.ImageUrl"
                                     alt="Assigned face from @face.PhotoName"
                                     loading="lazy" />
                            </a>

                            <div class="audit-card-body">
                                <div class="audit-card-heading">
                                    <div>
                                        <strong>@face.PhotoName</strong>
                                        <small>Face @(face.FaceOrdinal + 1)</small>
                                    </div>
                                    <span class="state-badge">@SourceLabel(face.AssignmentActor)</span>
                                </div>

                                <p class="assignment-meta">
                                    @face.AssignedAtUtc.ToLocalTime().ToString("g")
                                </p>

                                @if (face.AcceptedSuggestion is ReviewTopSuggestionResponse accepted)
                                {
                                    <div class="suggestion-note accepted">
                                        <strong>
                                            score @accepted.Score.ToString("0.0000")
                                            @if (accepted.ScoreMargin is double margin)
                                            {
                                                <text> · margin @margin.ToString("0.0000")</text>
                                            }
                                        </strong>
                                        <small>@accepted.ModelId · @HashPrefix(accepted.ModelHash)</small>
                                    </div>
                                }
                                else if (IsAutomaticActor(face.AssignmentActor))
                                {
                                    <div class="suggestion-note warning">
                                        Automatic assignment provenance could not be resolved.
                                    </div>
                                }

                                @if (face.CurrentSuggestionDisagrees && face.CurrentTopSuggestion is ReviewTopSuggestionResponse current)
                                {
                                    <div class="suggestion-note warning">
                                        <strong>Current top suggestion: @current.Person.DisplayName</strong>
                                        <span>
                                            score @current.Score.ToString("0.0000")
                                            @if (current.ScoreMargin is double currentMargin)
                                            {
                                                <text> · margin @currentMargin.ToString("0.0000")</text>
                                            }
                                        </span>
                                    </div>
                                }

                                <a class="details-link" href="@BuildDetailsUrl(face)">
                                    Audit history and correct assignment →
                                </a>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    @if (HasMore)
    {
        <div class="audit-load-more">
            <button class="button secondary" @onclick="LoadMoreAsync" disabled="@Loading">
                @(Loading ? "Loading…" : "Load more")
            </button>
        </div>
    }
}

@code {
    private const int PageSize = 120;
    private const int MaximumRestoredItems = 2400;

    [Parameter, SupplyParameterFromQuery(Name = "source")]
    public string Source { get; set; } = "automatic";

    [Parameter, SupplyParameterFromQuery(Name = "fromUtc")]
    public string? FromUtcValue { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "toUtc")]
    public string? ToUtcValue { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "modelId")]
    public string? ModelId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "modelHash")]
    public string? ModelHash { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "visible")]
    public int Visible { get; set; } = PageSize;

    private IReadOnlyList<ReviewModelRevisionFilterResponse> ModelRevisions { get; set; } = [];
    private List<AssignmentAuditFaceResponse> Items { get; } = [];
    private string SelectedSource { get; set; } = "automatic";
    private string SelectedModelKey { get; set; } = "";
    private DateTime? FromLocal { get; set; }
    private DateTime? ToLocal { get; set; }
    private int ServerOffset { get; set; }
    private int Total { get; set; }
    private bool Loading { get; set; }
    private string? Error { get; set; }

    private IEnumerable<IGrouping<string, AssignmentAuditFaceResponse>> Groups =>
        Items.GroupBy(item => item.AssignedPerson.Id);

    private int LoadedPersonCount => Items
        .Select(item => item.AssignedPerson.Id)
        .Distinct(StringComparer.Ordinal)
        .Count();

    private bool HasMore => ServerOffset < Total;

    private ReviewModelRevisionFilterResponse? SelectedModel =>
        ModelRevisions.FirstOrDefault(model => ModelKey(model) == SelectedModelKey);

    protected override async Task OnParametersSetAsync()
    {
        await LoadOptionsAsync();
        NormalizeParameters();
        await LoadInitialAsync();
    }

    private async Task LoadOptionsAsync()
    {
        if (ModelRevisions.Count > 0)
        {
            return;
        }

        ReviewFilterOptionsResponse options =
            await Http.GetFromJsonAsync<ReviewFilterOptionsResponse>("api/review/filters")
            ?? new ReviewFilterOptionsResponse([], []);
        ModelRevisions = options.ModelRevisions;
    }

    private void NormalizeParameters()
    {
        SelectedSource = Source is "all" or "automatic" or "manual"
            ? Source
            : "automatic";
        Source = SelectedSource;

        DateTimeOffset? fromUtc = ParseUtc(FromUtcValue);
        DateTimeOffset? toUtc = ParseUtc(ToUtcValue);
        FromUtcValue = fromUtc?.ToString("O");
        ToUtcValue = toUtc?.ToString("O");
        FromLocal = fromUtc?.ToLocalTime().DateTime;
        ToLocal = toUtc?.ToLocalTime().DateTime;

        ReviewModelRevisionFilterResponse? selectedModel =
            ModelRevisions.FirstOrDefault(model =>
                model.ModelId == ModelId && model.ModelHash == ModelHash);
        SelectedModelKey = selectedModel is null ? "" : ModelKey(selectedModel);
        ModelId = selectedModel?.ModelId;
        ModelHash = selectedModel?.ModelHash;
        Visible = Math.Clamp(Visible <= 0 ? PageSize : Visible, PageSize, MaximumRestoredItems);
    }

    private async Task LoadInitialAsync()
    {
        Items.Clear();
        ServerOffset = 0;
        Total = 0;
        Error = null;

        int target = Visible;
        do
        {
            if (!await LoadNextPageAsync())
            {
                break;
            }
        }
        while (Items.Count < target && HasMore);
    }

    private async Task LoadMoreAsync()
    {
        Error = null;
        await LoadNextPageAsync();
    }

    private async Task<bool> LoadNextPageAsync()
    {
        if (Loading)
        {
            return false;
        }

        Loading = true;
        try
        {
            AssignmentAuditPageResponse? page =
                await Http.GetFromJsonAsync<AssignmentAuditPageResponse>(BuildApiUrl(ServerOffset));
            if (page is null)
            {
                return false;
            }

            HashSet<string> known = Items
                .Select(item => item.Id)
                .ToHashSet(StringComparer.Ordinal);
            foreach (AssignmentAuditFaceResponse item in page.Items)
            {
                if (known.Add(item.Id))
                {
                    Items.Add(item);
                }
            }

            ServerOffset = page.Offset + page.Items.Count;
            Total = page.Total;
            return page.Items.Count > 0;
        }
        catch (Exception exception)
        {
            Error = $"Assignment audit could not be loaded: {exception.Message}";
            return false;
        }
        finally
        {
            Loading = false;
        }
    }

    private void ApplyFilters()
    {
        Error = null;
        DateTimeOffset? fromUtc = LocalToUtc(FromLocal);
        DateTimeOffset? toUtc = LocalToUtc(ToLocal);
        if (fromUtc is DateTimeOffset from &&
            toUtc is DateTimeOffset to &&
            from >= to)
        {
            Error = "From must be earlier than To.";
            return;
        }

        Source = SelectedSource;
        FromUtcValue = fromUtc?.ToString("O");
        ToUtcValue = toUtc?.ToString("O");
        ReviewModelRevisionFilterResponse? model = SelectedModel;
        ModelId = model?.ModelId;
        ModelHash = model?.ModelHash;
        Visible = PageSize;
        Navigation.NavigateTo(BuildPageUrl(Visible), replace: true);
    }

    private string BuildApiUrl(int offset)
    {
        List<string> query =
        [
            $"source={Uri.EscapeDataString(Source)}",
            $"offset={offset}",
            $"limit={PageSize}",
        ];
        AddScopeQuery(query);
        return $"api/review/assigned-faces/audit?{string.Join("&", query)}";
    }

    private string BuildPageUrl(int visible)
    {
        List<string> query =
        [
            $"source={Uri.EscapeDataString(Source)}",
            $"visible={Math.Clamp(visible, PageSize, MaximumRestoredItems)}",
        ];
        AddScopeQuery(query);
        return $"/audit?{string.Join("&", query)}";
    }

    private void AddScopeQuery(List<string> query)
    {
        if (!string.IsNullOrWhiteSpace(FromUtcValue))
        {
            query.Add($"fromUtc={Uri.EscapeDataString(FromUtcValue)}");
        }
        if (!string.IsNullOrWhiteSpace(ToUtcValue))
        {
            query.Add($"toUtc={Uri.EscapeDataString(ToUtcValue)}");
        }
        if (!string.IsNullOrWhiteSpace(ModelId) && !string.IsNullOrWhiteSpace(ModelHash))
        {
            query.Add($"modelId={Uri.EscapeDataString(ModelId)}");
            query.Add($"modelHash={Uri.EscapeDataString(ModelHash)}");
        }
    }

    private string BuildDetailsUrl(AssignmentAuditFaceResponse face)
    {
        string returnUrl = BuildPageUrl(Math.Max(PageSize, Items.Count)) +
                           $"#{PersonAnchor(face.AssignedPerson.Id)}";
        return $"/faces/{Uri.EscapeDataString(face.Id)}" +
               $"?state=all&returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private static DateTimeOffset? LocalToUtc(DateTime? value)
    {
        if (value is null)
        {
            return null;
        }

        DateTime local = DateTime.SpecifyKind(value.Value, DateTimeKind.Local);
        return new DateTimeOffset(local).ToUniversalTime();
    }

    private static DateTimeOffset? ParseUtc(string? value) =>
        DateTimeOffset.TryParse(
            value,
            CultureInfo.InvariantCulture,
            DateTimeStyles.RoundtripKind,
            out DateTimeOffset parsed)
            ? parsed.ToUniversalTime()
            : null;

    private static double? WeakestMargin(IEnumerable<AssignmentAuditFaceResponse> items)
    {
        double[] margins = items
            .Select(item => item.AcceptedSuggestion?.ScoreMargin)
            .Where(margin => margin.HasValue)
            .Select(margin => margin!.Value)
            .ToArray();
        return margins.Length == 0 ? null : margins.Min();
    }

    private static string SourceLabel(string actor) => actor switch
    {
        "identity-matcher:auto" => "AUTO",
        "identity-matcher:auto-multi-evidence" => "AUTO · multi",
        _ => "Manual",
    };

    private static bool IsAutomaticActor(string actor) =>
        actor is "identity-matcher:auto" or "identity-matcher:auto-multi-evidence";

    private static string PersonAnchor(string personId) => $"person-{personId}";

    private static string ModelKey(ReviewModelRevisionFilterResponse model) =>
        $"{model.ModelId}::{model.ModelHash}";

    private static string HashPrefix(string hash) =>
        hash[..Math.Min(12, hash.Length)];
}
