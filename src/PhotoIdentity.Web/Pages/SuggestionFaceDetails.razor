@page "/suggestion-faces/{Id}"
@inject NavigationManager Navigation

<PageTitle>Redirecting · Photo Identity</PageTitle>

<section class="empty-state" aria-live="polite">
    <div class="spinner" aria-hidden="true"></div>
    <p>Opening face details…</p>
</section>

@code {
    [Parameter]
    public string Id { get; set; } = "";

    protected override void OnInitialized()
    {
        Uri current = Navigation.ToAbsoluteUri(Navigation.Uri);
        string query = current.Query.TrimStart('?');
        List<string> parts = string.IsNullOrWhiteSpace(query)
            ? []
            : query.Split('&', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!parts.Any(part => part.StartsWith("suggestionQueue=", StringComparison.OrdinalIgnoreCase)))
        {
            parts.Add("suggestionQueue=true");
        }

        string suffix = parts.Count == 0 ? "" : $"?{string.Join("&", parts)}";
        Navigation.NavigateTo($"/faces/{Uri.EscapeDataString(Id ?? string.Empty)}{suffix}", replace: true);
    }
}
