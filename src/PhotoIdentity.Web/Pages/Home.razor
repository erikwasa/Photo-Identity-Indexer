@page "/"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Review faces · Photo Identity</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">Human review queue</p>
        <h1>Review detected faces</h1>
        <p>Assign a person, reject a false detection, or undo the latest decision. Every change is retained in the local audit history.</p>
    </div>

    <div class="person-creator">
        <label class="field-label" for="new-person">Create person</label>
        <div class="inline-field">
            <input id="new-person" placeholder="Display name" maxlength="200" @bind="NewPersonName" @bind:event="oninput" />
            <button class="button primary" disabled="@(string.IsNullOrWhiteSpace(NewPersonName) || CreatingPerson)" @onclick="CreatePersonAsync">
                Add
            </button>
        </div>
    </div>
</section>

<nav class="filter-tabs" aria-label="Review state">
    @foreach ((string Value, string Label) filter in Filters)
    {
        <button class="filter-tab @(State == filter.Value ? "active" : "")" @onclick="() => ChangeStateAsync(filter.Value)">
            @filter.Label
        </button>
    }
</nav>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="notice error" role="alert">@Error</div>
}
@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="notice success" role="status">@Message</div>
}

@if (Page is not null && Page.Items.Count > 0)
{
    <section class="bulk-review-panel" aria-labelledby="bulk-review-heading">
        <div class="bulk-review-heading">
            <div>
                <p class="eyebrow">Preview before commit</p>
                <h2 id="bulk-review-heading">Bulk review</h2>
                <p>Select unreviewed faces on this page. The server recalculates the exact affected set before any change is committed.</p>
            </div>
            <div class="bulk-selection-actions">
                <button class="button secondary"
                        disabled="@(BulkBusy || PageUnreviewedCount == 0)"
                        @onclick="SelectCurrentPage">
                    Select page
                </button>
                <button class="button secondary"
                        disabled="@(BulkBusy || SelectedCount == 0)"
                        @onclick="ClearSelection">
                    Clear
                </button>
            </div>
        </div>

        @if (SelectedCount == 0)
        {
            <p class="bulk-empty">No faces selected. Use the Select control on one or more unreviewed cards.</p>
        }
        else
        {
            <div class="bulk-review-controls">
                <div>
                    <label class="field-label" for="bulk-action">Action</label>
                    <select id="bulk-action" @bind="BulkAction" @bind:after="InvalidateBulkPreview" disabled="@BulkBusy">
                        <option value="assign">Assign to one person</option>
                        <option value="reject">Reject as false detections</option>
                    </select>
                </div>

                @if (BulkAction == "assign")
                {
                    <div>
                        <label class="field-label" for="bulk-person">Person</label>
                        <select id="bulk-person" @bind="BulkPersonId" @bind:after="InvalidateBulkPreview" disabled="@(BulkBusy || People.Count == 0)">
                            <option value="">Choose a person</option>
                            @foreach (ReviewPersonResponse person in People)
                            {
                                <option value="@person.Id">@person.DisplayName</option>
                            }
                        </select>
                    </div>
                }

                <div>
                    <label class="field-label" for="bulk-note">Audit note</label>
                    <input id="bulk-note"
                           maxlength="1000"
                           placeholder="Optional note applied to every action"
                           @bind="BulkNote"
                           @bind:event="oninput"
                           @bind:after="InvalidateBulkPreview"
                           disabled="@BulkBusy" />
                </div>

                <button class="button primary bulk-preview-button"
                        disabled="@(!CanPreview)"
                        @onclick="PreviewBulkAsync">
                    Preview @SelectedCount selected face@(SelectedCount == 1 ? "" : "s")
                </button>
            </div>

            @if (BulkPreview is not null)
            {
                <div class="bulk-preview @(BulkPreview.Action == "reject" ? "danger-preview" : "")" role="status">
                    <div>
                        <strong>@BulkPreview.AffectedCount face@(BulkPreview.AffectedCount == 1 ? "" : "s") will change</strong>
                        @if (BulkPreview.Action == "assign")
                        {
                            <p>They will be assigned to <strong>@BulkPreview.Person?.DisplayName</strong>.</p>
                        }
                        else
                        {
                            <p>They will be recorded as rejected face detections.</p>
                        }
                        @if (BulkPreview.SkippedCount > 0)
                        {
                            <p>@BulkPreview.SkippedCount selected face@(BulkPreview.SkippedCount == 1 ? " is" : "s are") already reviewed and will be skipped.</p>
                        }
                    </div>
                    <button class="button @(BulkPreview.Action == "reject" ? "danger" : "primary")"
                            disabled="@(BulkBusy || BulkPreview.AffectedCount == 0)"
                            @onclick="CommitBulkAsync">
                        Commit @BulkPreview.AffectedCount @BulkCommitNoun
                    </button>
                </div>
            }
        }
    </section>
}

@if (Loading)
{
    <section class="empty-state" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading the review queue…</p>
    </section>
}
else if (Page is null || Page.Items.Count == 0)
{
    <section class="empty-state">
        <h2>No faces in this view</h2>
        <p>Choose another review state or process additional photos.</p>
    </section>
}
else
{
    <div class="gallery-summary">
        <span>@Page.Total face@(Page.Total == 1 ? "" : "s")</span>
        <span>Showing @(Page.Offset + 1)–@Math.Min(Page.Offset + Page.Items.Count, Page.Total)</span>
    </div>

    <section class="face-grid" aria-label="Face review cards">
        @foreach (ReviewFaceResponse face in Page.Items)
        {
            <FaceCard Face="face"
                      People="People"
                      Selectable="@(face.State == "unreviewed")"
                      Selected="@SelectedFaceIds.Contains(face.Id)"
                      SelectionChanged="SetFaceSelection"
                      AssignRequested="AssignAsync"
                      RejectRequested="RejectAsync"
                      UndoRequested="UndoAsync" />
        }
    </section>

    <div class="pagination">
        <button class="button secondary" disabled="@(Page.Offset == 0 || Loading)" @onclick="PreviousPageAsync">Previous</button>
        <button class="button secondary" disabled="@(Page.Offset + Page.Limit >= Page.Total || Loading)" @onclick="NextPageAsync">Next</button>
    </div>
}

@code {
    private const int PageSize = 40;
    private const string Actor = "local-reviewer";

    private static readonly (string Value, string Label)[] Filters =
    [
        ("unreviewed", "Needs review"),
        ("assigned", "Assigned"),
        ("rejected", "Rejected"),
        ("all", "All"),
    ];

    private ReviewFacePageResponse? Page { get; set; }
    private IReadOnlyList<ReviewPersonResponse> People { get; set; } = [];
    private HashSet<string> SelectedFaceIds { get; } = new(StringComparer.Ordinal);
    private BulkReviewPreviewResponse? BulkPreview { get; set; }
    private string State { get; set; } = "unreviewed";
    private int Offset { get; set; }
    private string NewPersonName { get; set; } = "";
    private string BulkAction { get; set; } = "assign";
    private string BulkPersonId { get; set; } = "";
    private string BulkNote { get; set; } = "";
    private bool Loading { get; set; }
    private bool CreatingPerson { get; set; }
    private bool BulkBusy { get; set; }
    private string? Error { get; set; }
    private string? Message { get; set; }

    private int SelectedCount => SelectedFaceIds.Count;
    private int PageUnreviewedCount => Page?.Items.Count(face => face.State == "unreviewed") ?? 0;
    private bool CanPreview =>
        !BulkBusy &&
        SelectedCount > 0 &&
        (BulkAction == "reject" || !string.IsNullOrWhiteSpace(BulkPersonId));
    private string BulkCommitNoun => BulkPreview?.Action == "reject"
        ? (BulkPreview.AffectedCount == 1 ? "rejection" : "rejections")
        : (BulkPreview?.AffectedCount == 1 ? "assignment" : "assignments");

    protected override async Task OnInitializedAsync()
    {
        await LoadPeopleAsync();
        await LoadFacesAsync();
    }

    private async Task LoadPeopleAsync()
    {
        People = await Http.GetFromJsonAsync<ReviewPersonResponse[]>("api/review/people") ?? [];
        if (People.All(person => person.Id != BulkPersonId))
        {
            BulkPersonId = People.FirstOrDefault()?.Id ?? "";
        }
    }

    private async Task LoadFacesAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            Page = await Http.GetFromJsonAsync<ReviewFacePageResponse>(
                $"api/review/faces?state={Uri.EscapeDataString(State)}&offset={Offset}&limit={PageSize}");
            ResetBulkSelection();
        }
        catch (Exception exception)
        {
            Error = $"The review queue could not be loaded: {exception.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task ChangeStateAsync(string state)
    {
        State = state;
        Offset = 0;
        Message = null;
        await LoadFacesAsync();
    }

    private async Task CreatePersonAsync()
    {
        CreatingPerson = true;
        Error = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "api/review/people",
                new CreatePersonRequest(NewPersonName));
            await RequireSuccessAsync(response);
            ReviewPersonResponse? created = await response.Content.ReadFromJsonAsync<ReviewPersonResponse>();
            string createdName = NewPersonName.Trim();
            NewPersonName = "";
            await LoadPeopleAsync();
            if (created is not null)
            {
                BulkPersonId = created.Id;
            }
            Message = $"Created {createdName}.";
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            CreatingPerson = false;
        }
    }

    private void SetFaceSelection((string FaceId, bool Selected) change)
    {
        if (change.Selected)
        {
            SelectedFaceIds.Add(change.FaceId);
        }
        else
        {
            SelectedFaceIds.Remove(change.FaceId);
        }

        InvalidateBulkPreview();
    }

    private void SelectCurrentPage()
    {
        if (Page is null)
        {
            return;
        }

        foreach (ReviewFaceResponse face in Page.Items.Where(face => face.State == "unreviewed"))
        {
            SelectedFaceIds.Add(face.Id);
        }

        InvalidateBulkPreview();
    }

    private void ClearSelection()
    {
        SelectedFaceIds.Clear();
        InvalidateBulkPreview();
    }

    private void ResetBulkSelection()
    {
        SelectedFaceIds.Clear();
        BulkPreview = null;
    }

    private void InvalidateBulkPreview()
    {
        BulkPreview = null;
        Message = null;
    }

    private async Task PreviewBulkAsync()
    {
        if (!CanPreview)
        {
            return;
        }

        BulkBusy = true;
        Error = null;
        Message = null;
        try
        {
            BulkReviewPreviewRequest request = new(
                SelectedFaceIds.OrderBy(value => value, StringComparer.Ordinal).ToArray(),
                BulkAction,
                BulkAction == "assign" ? BulkPersonId : null);
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/review/bulk/preview", request);
            await RequireSuccessAsync(response);
            BulkPreview = await response.Content.ReadFromJsonAsync<BulkReviewPreviewResponse>()
                ?? throw new InvalidOperationException("The bulk preview response was empty.");
        }
        catch (Exception exception)
        {
            Error = exception.Message;
            BulkPreview = null;
        }
        finally
        {
            BulkBusy = false;
        }
    }

    private async Task CommitBulkAsync()
    {
        if (BulkPreview is not BulkReviewPreviewResponse preview || preview.AffectedCount == 0)
        {
            return;
        }

        BulkBusy = true;
        Error = null;
        Message = null;
        try
        {
            BulkReviewCommitRequest request = new(
                SelectedFaceIds.OrderBy(value => value, StringComparer.Ordinal).ToArray(),
                BulkAction,
                BulkAction == "assign" ? BulkPersonId : null,
                preview.AffectedCount,
                preview.PreviewToken,
                Confirm: true,
                Actor,
                EmptyToNull(BulkNote));
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/review/bulk/commit", request);
            await RequireSuccessAsync(response);
            BulkReviewCommitResponse result = await response.Content.ReadFromJsonAsync<BulkReviewCommitResponse>()
                ?? throw new InvalidOperationException("The bulk commit response was empty.");
            string noun = result.Action == "reject"
                ? (result.AffectedCount == 1 ? "face rejection" : "face rejections")
                : (result.AffectedCount == 1 ? "face assignment" : "face assignments");
            Message = $"Committed {result.AffectedCount} {noun}.";
            BulkNote = "";
            await LoadFacesAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            BulkBusy = false;
        }
    }

    private async Task AssignAsync((string FaceId, string PersonId) request)
    {
        await ApplyAsync(
            $"api/review/faces/{request.FaceId}/assign",
            new AssignFaceRequest(request.PersonId, Actor),
            "Face assignment saved.");
    }

    private async Task RejectAsync(string faceId)
    {
        await ApplyAsync(
            $"api/review/faces/{faceId}/reject",
            new ReviewFaceActionRequest(Actor),
            "Face rejected.");
    }

    private async Task UndoAsync(string faceId)
    {
        await ApplyAsync(
            $"api/review/faces/{faceId}/undo",
            new ReviewFaceActionRequest(Actor),
            "Latest review action undone.");
    }

    private async Task ApplyAsync<TRequest>(string url, TRequest request, string successMessage)
    {
        Error = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(url, request);
            await RequireSuccessAsync(response);
            Message = successMessage;
            await LoadFacesAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
    }

    private async Task PreviousPageAsync()
    {
        Offset = Math.Max(0, Offset - PageSize);
        await LoadFacesAsync();
    }

    private async Task NextPageAsync()
    {
        Offset += PageSize;
        await LoadFacesAsync();
    }

    private static string? EmptyToNull(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static async Task RequireSuccessAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return;
        }

        string detail = await response.Content.ReadAsStringAsync();
        throw new InvalidOperationException(
            string.IsNullOrWhiteSpace(detail)
                ? $"The review action failed with status {(int)response.StatusCode}."
                : detail);
    }
}
