@page "/"

<ReviewWorkspace QueryState="@QueryState"
                 QuerySort="@QuerySort"
                 QueryProcessingRunId="@QueryProcessingRunId"
                 QueryModelId="@QueryModelId"
                 QueryModelHash="@QueryModelHash"
                 QueryConfidenceGroup="@QueryConfidenceGroup"
                 QuerySuggestedPersonId="@QuerySuggestedPersonId"
                 QueryLoaded="@QueryLoaded" />

@code {
    [Parameter, SupplyParameterFromQuery(Name = "state")]
    public string? QueryState { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "sort")]
    public string? QuerySort { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "processingRunId")]
    public string? QueryProcessingRunId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "modelId")]
    public string? QueryModelId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "modelHash")]
    public string? QueryModelHash { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "confidenceGroup")]
    public string? QueryConfidenceGroup { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "suggestedPersonId")]
    public string? QuerySuggestedPersonId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "loaded")]
    public int QueryLoaded { get; set; }
}
