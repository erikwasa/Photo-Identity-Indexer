@page "/slideshow/{CollectionId:guid}"

<PageTitle>@PageTitleText</PageTitle>
<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<div class="slideshow-shell"
     style="@ProtectionTuningStyle"
     role="application"
     aria-label="@SlideshowAriaLabel"
     @onclick="OnSurfaceClickAsync"
     @onpointerdown="OnPointerDown"
     @onpointerup="OnPointerUpAsync"
     @onpointercancel="OnPointerCancel"
     @oncontextmenu:preventDefault="true"
     @ondragstart:preventDefault="true">

    @if (Settings.ProtectedSlideshow && !Protection.ParentControlsOpen)
    {
        <div class="slideshow-parent-zone slideshow-parent-zone-left"
             aria-hidden="true"
             @onclick:stopPropagation="true"
             @onpointerdown="args => OnParentPointerDown(SlideshowParentZone.Left, args)"
             @onpointerdown:stopPropagation="true"
             @onpointerup="args => OnParentPointerUp(SlideshowParentZone.Left, args)"
             @onpointerup:stopPropagation="true"
             @onpointercancel="args => OnParentPointerUp(SlideshowParentZone.Left, args)"
             @onpointercancel:stopPropagation="true"
             @onpointerleave="args => OnParentPointerUp(SlideshowParentZone.Left, args)"
             @onpointerleave:stopPropagation="true"></div>
        <div class="slideshow-parent-zone slideshow-parent-zone-right"
             aria-hidden="true"
             @onclick:stopPropagation="true"
             @onpointerdown="args => OnParentPointerDown(SlideshowParentZone.Right, args)"
             @onpointerdown:stopPropagation="true"
             @onpointerup="args => OnParentPointerUp(SlideshowParentZone.Right, args)"
             @onpointerup:stopPropagation="true"
             @onpointercancel="args => OnParentPointerUp(SlideshowParentZone.Right, args)"
             @onpointercancel:stopPropagation="true"
             @onpointerleave="args => OnParentPointerUp(SlideshowParentZone.Right, args)"
             @onpointerleave:stopPropagation="true"></div>
    }

    @if (!FullscreenActive)
    {
        <section class="slideshow-state-card slideshow-recovery-card"
                 role="status"
                 @onclick:stopPropagation="true">
            <h1>Slideshow paused</h1>
            <p>Fullscreen is not active. The slideshow is contained on this recovery surface until fullscreen is restored.</p>
            <div class="slideshow-state-actions">
                <button type="button" class="button primary" @onclick="RetryFullscreenAsync">Enter fullscreen</button>
                @if (!Settings.ProtectedSlideshow)
                {
                    <button type="button" class="button secondary" @onclick="ExitSlideshowAsync">Return to collection</button>
                }
            </div>
            @if (Settings.ProtectedSlideshow)
            {
                <p class="slideshow-parent-hint">Use the parent unlock gesture to access settings or exit.</p>
            }
        </section>
    }
    else if (Preparing)
    {
        <section class="slideshow-state-card" role="status" aria-live="polite">
            <div class="spinner" aria-hidden="true"></div>
            <h1>Preparing slideshow…</h1>
            <p>Creating a stable snapshot of @CollectionLabel.</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <section class="slideshow-state-card" role="alert" @onclick:stopPropagation="true">
            <h1>Slideshow unavailable</h1>
            <p>@Error</p>
            @if (!Settings.ProtectedSlideshow)
            {
                <button type="button" class="button secondary" @onclick="ExitSlideshowAsync">Return to collection</button>
            }
            else
            {
                <p class="slideshow-parent-hint">Use the parent unlock gesture to return to the collection.</p>
            }
        </section>
    }
    else if (Snapshot?.Total == 0)
    {
        <section class="slideshow-state-card" role="status">
            <h1>No photos are currently in this collection</h1>
        </section>
    }
    else if (CurrentImageUrl is not null)
    {
        <img @key="Playback.CurrentRevisionId"
             class="slideshow-image"
             src="@CurrentImageUrl"
             alt=""
             draggable="false"
             decoding="async"
             @onload="OnCurrentImageLoadedAsync"
             @onerror="OnCurrentImageError" />

        @if (!string.IsNullOrWhiteSpace(ImageError))
        {
            <div class="slideshow-image-error" role="alert">@ImageError</div>
        }
    }

    @if (ShowTimerProgress)
    {
        <div class="slideshow-progress" aria-hidden="true">
            <span style="@ProgressStyle"></span>
        </div>
    }

    @if (ShowAdultToolbar)
    {
        <div class="slideshow-toolbar"
             @onclick:stopPropagation="true"
             @onpointerdown:stopPropagation="true"
             @onpointerup:stopPropagation="true">
            <button type="button" class="slideshow-toolbar-button" @onclick="TogglePlay">
                @(Playback.IsPlaying ? "Pause" : "Play")
            </button>
            <button type="button" class="slideshow-toolbar-button" @onclick="ToggleSettings">
                Settings
            </button>
            <button type="button" class="slideshow-toolbar-button" @onclick="ExitSlideshowAsync">
                Exit
            </button>
        </div>
    }

    @if (Protection.ParentControlsOpen)
    {
        <div class="slideshow-parent-backdrop"
             @onclick:stopPropagation="true"
             @onpointerdown:stopPropagation="true"
             @onpointerup:stopPropagation="true">
            <section class="slideshow-parent-controls" aria-label="Parent slideshow controls">
                <div class="slideshow-settings-heading">
                    <div>
                        <p class="slideshow-parent-eyebrow">Parent controls</p>
                        <strong>@ParentControlsHeading</strong>
                    </div>
                    <button type="button" class="slideshow-toolbar-button" @onclick="CloseParentControls">
                        Close
                    </button>
                </div>

                @if (ProtectionWarnings.Count > 0)
                {
                    <div class="slideshow-protection-warning" role="alert">
                        <strong>Protection needs attention before handoff</strong>
                        <ul>
                            @foreach (string warning in ProtectionWarnings)
                            {
                                <li>@warning</li>
                            }
                        </ul>
                    </div>
                }

                <div class="slideshow-parent-actions">
                    <button type="button" class="slideshow-toolbar-button" @onclick="ToggleParentPlayback">
                        @(_resumeAfterParentControls ? "Pause" : "Play")
                    </button>
                    <button type="button" class="slideshow-toolbar-button" @onclick="ToggleSettings">
                        Settings
                    </button>
                    @if (!FullscreenActive)
                    {
                        <button type="button" class="slideshow-toolbar-button" @onclick="RetryFullscreenAsync">
                            Enter fullscreen
                        </button>
                    }
                </div>

                <button type="button"
                        class="slideshow-exit-hold"
                        @onpointerdown="BeginExitHold"
                        @onpointerup="CancelExitHold"
                        @onpointercancel="CancelExitHold"
                        @onpointerleave="CancelExitHold">
                    Hold to exit slideshow
                </button>
                <small>Hold for @ExitHoldSeconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) seconds.</small>
            </section>
        </div>
    }

    @if (SettingsOpen && (!Settings.ProtectedSlideshow || Protection.ParentControlsOpen))
    {
        <section class="slideshow-settings"
                 aria-label="Slideshow settings"
                 @onclick:stopPropagation="true"
                 @onpointerdown:stopPropagation="true"
                 @onpointerup:stopPropagation="true">
            <div class="slideshow-settings-heading">
                <strong>Slideshow settings</strong>
                <button type="button" class="slideshow-toolbar-button" @onclick="ToggleSettings">Close</button>
            </div>

            <label>
                <input type="checkbox" checked="@Settings.Autoplay" @onchange="ChangeAutoplayAsync" />
                <span>Autoplay</span>
            </label>

            <label class="slideshow-settings-field">
                <span>Image duration</span>
                <input type="number"
                       min="@SlideshowSettings.MinimumImageDurationSeconds"
                       max="@SlideshowSettings.MaximumImageDurationSeconds"
                       value="@Settings.ImageDurationSeconds"
                       @onchange="ChangeDurationAsync" />
                <span>seconds</span>
            </label>

            <label>
                <input type="checkbox" checked="@Settings.ShowTimerProgress" @onchange="ChangeProgressAsync" />
                <span>Show timer progress</span>
            </label>

            <label class="slideshow-settings-field">
                <span>After last photo</span>
                <select value="@Settings.AfterLastPhoto" @onchange="ChangeEndBehaviorAsync">
                    <option value="@SlideshowSettings.Loop">Loop</option>
                    <option value="@SlideshowSettings.Stop">Stop</option>
                    <option value="@SlideshowSettings.Exit">Exit slideshow</option>
                </select>
            </label>

            <label>
                <input type="checkbox" checked="@Settings.ProtectedSlideshow" @onchange="ChangeProtectedAsync" />
                <span>Protected slideshow</span>
            </label>

            <label>
                <input type="checkbox" checked="@Settings.PrepareOriginals" @onchange="ChangePrepareOriginalsAsync" />
                <span>Prepare originals</span>
            </label>

            @if (ProtectionStatusKnown)
            {
                <div class="slideshow-capability-summary">
                    <strong>Protection status</strong>
                    <span>Fullscreen: @CapabilityLabel(Capabilities.Fullscreen)</span>
                    <span>Orientation lock: @CapabilityLabel(Capabilities.OrientationLock)</span>
                    <span>Wake lock: @CapabilityLabel(Capabilities.WakeLock)</span>
                    <span>Secure context: @(Capabilities.SecureContext ? "yes" : "no")</span>
                </div>
            }
        </section>
    }
</div>
