@page "/creative-collections"
@using System.Net
@using System.Net.Http.Json
@using PhotoIdentity.Web.Contracts
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Creative Collections · Photo Identity</PageTitle>

<section class="smart-workspace" aria-labelledby="creative-collections-heading">
    <div class="smart-workspace-heading">
        <div>
            <p class="eyebrow">Creative Collections</p>
            <h2 id="creative-collections-heading">Named creative slideshows</h2>
            <p>Start from an exact Smart Collection or a ranked Visual/Caption search, then add nearby moment context.</p>
        </div>
        <a class="button secondary" href="/slideshow-collections">All collections</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice error" role="alert">@Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Notice))
    {
        <div class="notice" role="status">@Notice</div>
    }

    @if (Loading)
    {
        <div class="smart-loading" aria-live="polite">
            <div class="spinner" aria-hidden="true"></div>
            <span>Loading Creative Collections…</span>
        </div>
    }
    else
    {
        <div class="smart-layout">
            <aside class="smart-saved-list" aria-label="Saved Creative Collections">
                <div class="smart-subheading">
                    <strong>Saved Creative Collections</strong>
                    <span>@Recipes.Count</span>
                </div>
                <button type="button" class="button secondary" disabled="@Busy" @onclick="NewRecipe">
                    New Creative Collection
                </button>

                @if (Recipes.Count == 0)
                {
                    <p class="smart-muted">No Creative Collections yet.</p>
                }
                else
                {
                    @foreach (CreativeCollectionRecipeResponse recipe in Recipes
                        .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
                        .ThenBy(item => item.Id, StringComparer.Ordinal))
                    {
                        <article class="smart-saved-card @(SelectedRecipeId == recipe.Id ? "selected" : "")">
                            <button type="button"
                                    class="smart-open-button"
                                    disabled="@Busy"
                                    @onclick="() => SelectRecipe(recipe)">
                                <strong>@recipe.Name</strong>
                                <span>@SourceLabel(recipe)</span>
                                <span>@recipe.TargetCount photos · @recipe.ContextStrength context · Freshness @(recipe.NoveltyEnabled ? "on" : "off")</span>
                            </button>
                        </article>
                    }
                }
            </aside>

            <div class="smart-editor">
                <div class="smart-subheading">
                    <strong>@(SelectedRecipeId is null ? "New Creative Collection" : "Edit Creative Collection")</strong>
                    <span>@CurrentSourceLabel</span>
                </div>

                <label class="smart-field">
                    <span class="field-label">Creative Collection name</span>
                    <input type="text"
                           maxlength="120"
                           @bind="RecipeName"
                           @bind:after="ClearPreview"
                           disabled="@Busy" />
                </label>

                <label class="smart-field">
                    <span class="field-label">Anchor source</span>
                    <select @bind="AnchorKind"
                            @bind:after="AnchorKindChanged"
                            disabled="@(Busy || SelectedRecipeId is not null)">
                        @if (SmartCollections.Count > 0)
                        {
                            <option value="smart-collection">Smart Collection</option>
                        }
                        <option value="search">Visual / Caption search</option>
                    </select>
                </label>

                @if (AnchorKind == "smart-collection")
                {
                    <label class="smart-field">
                        <span class="field-label">Smart Collection</span>
                        <select @bind="SmartAnchorId" @bind:after="ClearPreview" disabled="@Busy">
                            @foreach (SmartCollectionDefinitionResponse collection in SmartCollections)
                            {
                                <option value="@collection.Id">@collection.Name</option>
                            }
                        </select>
                    </label>
                }
                else
                {
                    <label class="smart-field">
                        <span class="field-label">Search concept</span>
                        <input type="text"
                               maxlength="300"
                               placeholder="e.g. swimming at the beach"
                               @bind="SearchQuery"
                               @bind:after="ClearPreview"
                               disabled="@Busy" />
                    </label>

                    <div class="creative-controls">
                        <label class="smart-field">
                            <span class="field-label">Search evidence</span>
                            <select @bind="SearchMode" @bind:after="ClearPreview" disabled="@Busy">
                                <option value="combined">Visual + Captions</option>
                                <option value="semantic">Visual</option>
                                <option value="caption">Captions</option>
                            </select>
                        </label>

                        <label class="smart-field">
                            <span class="field-label">Smart scope</span>
                            <select @bind="SearchScopeId" @bind:after="ClearPreview" disabled="@Busy">
                                <option value="">All photos</option>
                                @foreach (SmartCollectionDefinitionResponse collection in SmartCollections)
                                {
                                    <option value="@collection.Id">@collection.Name</option>
                                }
                            </select>
                        </label>

                        <label class="smart-field">
                            <span class="field-label">Maximum search anchors</span>
                            <input type="number"
                                   min="1"
                                   max="250"
                                   inputmode="numeric"
                                   @bind="SearchAnchorLimit"
                                   @bind:after="ClearPreview"
                                   disabled="@Busy" />
                        </label>
                    </div>

                    <p class="smart-help">
                        Search anchors are ranked top-N matches. Future caption or visual-model evidence can change future materializations; an already-created slideshow snapshot stays fixed.
                    </p>
                }

                <div class="creative-controls">
                    <label class="smart-field">
                        <span class="field-label">Target photos</span>
                        <input type="number"
                               min="1"
                               max="1000"
                               inputmode="numeric"
                               @bind="TargetCount"
                               @bind:after="ClearPreview"
                               disabled="@Busy" />
                    </label>

                    <label class="smart-field">
                        <span class="field-label">Context</span>
                        <select @bind="ContextStrength" @bind:after="ClearPreview" disabled="@Busy">
                            <option value="focused">Focused</option>
                            <option value="balanced">Balanced</option>
                            <option value="broad">Broad</option>
                        </select>
                    </label>

                    <label class="smart-location-toggle">
                        <input type="checkbox"
                               @bind="NoveltyEnabled"
                               @bind:after="ClearPreview"
                               disabled="@Busy" />
                        <span>Favor photos not shown recently</span>
                    </label>
                </div>

                <p class="smart-help">
                    Direct anchors establish relevance. Nearby photos can be added only as moment context; they do not become recursive search anchors.
                </p>

                @if (Busy)
                {
                    <p role="status" aria-live="polite">Working… Preparing the Creative Collection.</p>
                }
                <div class="smart-actions">
                    <button type="button" class="button secondary" disabled="@Busy" @onclick="PreviewAsync">
                        @(Busy ? "Working…" : "Preview current recipe")
                    </button>
                    <button type="button" class="button secondary" disabled="@Busy" @onclick="SaveAsync">
                        Save Creative Collection
                    </button>
                    <button type="button" class="button primary" disabled="@Busy" @onclick="SaveAndStartAsync">
                        Save &amp; start slideshow
                    </button>
                    @if (SelectedRecipeId is not null)
                    {
                        <button type="button" class="button secondary" disabled="@Busy" @onclick="DeleteAsync">
                            Delete Creative Collection
                        </button>
                    }
                </div>

                @if (Preview is CreativeCollectionPreviewResponse preview)
                {
                    <div class="creative-summary" aria-label="Creative Collection preview counts">
                        <div class="creative-stat"><strong>@preview.DirectAnchorCount</strong><span>anchors</span></div>
                        <div class="creative-stat"><strong>+@preview.AddedContextCount</strong><span>context</span></div>
                        <div class="creative-stat"><strong>@preview.SelectedCount</strong><span>selected</span></div>
                        <div class="creative-stat"><strong>@preview.RepresentedMomentCount</strong><span>moments</span></div>
                    </div>

                    @if (preview.SearchAnchor is CreativeCollectionSearchAnchorPreviewResponse search)
                    {
                        <p class="smart-help">
                            Search: <strong>@search.Query</strong> · @SearchModeLabel(search.Mode) ·
                            @(string.IsNullOrWhiteSpace(search.ScopeCollectionName) ? "All photos" : search.ScopeCollectionName) ·
                            top @search.AnchorLimit.
                        </p>
                    }

                    @if (preview.NoAnchors)
                    {
                        <div class="empty-state compact">
                            <p>@(AnchorKind == "search"
                                ? "No ranked photos matched this search anchor."
                                : "No photos currently match the anchor Smart Collection.")</p>
                        </div>
                    }
                    else
                    {
                        <div class="creative-preview-grid" aria-label="Creative Collection selected photos">
                            @foreach (CreativeCollectionSelectedCandidateResponse photo in preview.SelectedCandidates.Take(60))
                            {
                                <article class="creative-preview-card">
                                    <img src="@photo.ThumbnailUrl"
                                         alt="Creative Collection selected photo"
                                         loading="lazy"
                                         decoding="async" />
                                    <div>
                                        <span class="creative-kind @(photo.Kind == "direct-anchor" ? "anchor" : "context")">
                                            @(photo.Kind == "direct-anchor" ? "Anchor" : "Context")
                                        </span>
                                        <strong>@(photo.TakenAtLocal?.ToString("yyyy-MM-dd") ?? "Date unavailable")</strong>
                                        @if (photo.Kind == "direct-anchor" && AnchorEvidence(photo.RevisionId) is string evidence)
                                        {
                                            <span>@evidence</span>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "collection")]
    public string? RequestedRecipeId { get; set; }

    private IReadOnlyList<SmartCollectionDefinitionResponse> SmartCollections { get; set; } = [];
    private IReadOnlyList<CreativeCollectionRecipeResponse> Recipes { get; set; } = [];
    private CreativeCollectionPreviewResponse? Preview { get; set; }
    private string? SelectedRecipeId { get; set; }
    private string AnchorKind { get; set; } = "smart-collection";
    private string? SmartAnchorId { get; set; }
    private string SearchQuery { get; set; } = string.Empty;
    private string SearchMode { get; set; } = "combined";
    private string SearchScopeId { get; set; } = string.Empty;
    private int SearchAnchorLimit { get; set; } = 80;
    private string RecipeName { get; set; } = string.Empty;
    private int TargetCount { get; set; } = 50;
    private string ContextStrength { get; set; } = "balanced";
    private bool NoveltyEnabled { get; set; }
    private bool Loading { get; set; } = true;
    private bool Busy { get; set; }
    private string? Error { get; set; }
    private string? Notice { get; set; }

    private string SmartAnchorName => SmartCollections
        .FirstOrDefault(collection => string.Equals(collection.Id, SmartAnchorId, StringComparison.Ordinal))?.Name
        ?? "Smart Collection";

    private string CurrentSourceLabel => AnchorKind == "search"
        ? string.IsNullOrWhiteSpace(SearchQuery)
            ? "Search anchor"
            : $"Search: {SearchQuery}"
        : $"Smart: {SmartAnchorName}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await ReloadAsync();
            CreativeCollectionRecipeResponse? requested = Recipes.FirstOrDefault(
                recipe => string.Equals(recipe.Id, RequestedRecipeId, StringComparison.OrdinalIgnoreCase));
            if (requested is not null)
            {
                SelectRecipe(requested);
            }
            else
            {
                NewRecipe();
            }
        }
        catch (Exception exception)
        {
            Error = $"Creative Collections could not be loaded: {exception.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        SmartCollectionDefinitionResponse[] smart =
            await Http.GetFromJsonAsync<SmartCollectionDefinitionResponse[]>("api/smart-collections") ?? [];
        CreativeCollectionRecipeResponse[] creative =
            await Http.GetFromJsonAsync<CreativeCollectionRecipeResponse[]>("api/creative-collections") ?? [];
        SmartCollections = smart
            .OrderBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(item => item.Id, StringComparer.Ordinal)
            .ToArray();
        Recipes = creative;
    }

    private void NewRecipe()
    {
        SelectedRecipeId = null;
        AnchorKind = SmartCollections.Count > 0 ? "smart-collection" : "search";
        SmartAnchorId = SmartCollections.FirstOrDefault()?.Id;
        SearchQuery = string.Empty;
        SearchMode = "combined";
        SearchScopeId = string.Empty;
        SearchAnchorLimit = 80;
        RecipeName = AnchorKind == "smart-collection"
            ? $"{SmartAnchorName} Creative"
            : "Search Creative";
        TrimRecipeName();
        TargetCount = 50;
        ContextStrength = "balanced";
        NoveltyEnabled = false;
        Preview = null;
        Error = null;
        Notice = null;
    }

    private void AnchorKindChanged()
    {
        if (AnchorKind == "smart-collection" && string.IsNullOrWhiteSpace(SmartAnchorId))
        {
            SmartAnchorId = SmartCollections.FirstOrDefault()?.Id;
        }

        RecipeName = AnchorKind == "smart-collection"
            ? $"{SmartAnchorName} Creative"
            : "Search Creative";
        TrimRecipeName();
        ClearPreview();
    }

    private void SelectRecipe(CreativeCollectionRecipeResponse recipe)
    {
        SelectedRecipeId = recipe.Id;
        AnchorKind = recipe.SearchAnchor is null ? "smart-collection" : "search";
        SmartAnchorId = recipe.AnchorCollectionId ?? SmartCollections.FirstOrDefault()?.Id;
        SearchQuery = recipe.SearchAnchor?.Query ?? string.Empty;
        SearchMode = recipe.SearchAnchor?.Mode ?? "combined";
        SearchScopeId = recipe.SearchAnchor?.SmartCollectionId ?? string.Empty;
        SearchAnchorLimit = recipe.SearchAnchor?.AnchorLimit ?? 80;
        RecipeName = recipe.Name;
        TargetCount = recipe.TargetCount;
        ContextStrength = recipe.ContextStrength;
        NoveltyEnabled = recipe.NoveltyEnabled;
        Preview = null;
        Error = null;
        Notice = null;
    }

    private bool Validate()
    {
        if (string.IsNullOrWhiteSpace(RecipeName))
        {
            Error = "Creative Collection name is required.";
            return false;
        }
        if (TargetCount is < 1 or > 1000)
        {
            Error = "Target photos must be between 1 and 1000.";
            return false;
        }
        if (ContextStrength is not ("focused" or "balanced" or "broad"))
        {
            Error = "Context must be Focused, Balanced or Broad.";
            return false;
        }

        if (AnchorKind == "smart-collection")
        {
            if (string.IsNullOrWhiteSpace(SmartAnchorId))
            {
                Error = "Choose a source Smart Collection.";
                return false;
            }
            return true;
        }

        if (AnchorKind != "search")
        {
            Error = "Choose a supported anchor source.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(SearchQuery))
        {
            Error = "Enter a search concept.";
            return false;
        }
        if (SearchMode is not ("combined" or "semantic" or "caption"))
        {
            Error = "Search evidence must be Visual, Captions or Visual + Captions.";
            return false;
        }
        if (SearchAnchorLimit is < 1 or > 250)
        {
            Error = "Maximum search anchors must be between 1 and 250.";
            return false;
        }
        return true;
    }

    private CreativeCollectionRecipeRequest BuildRequest()
    {
        CreativeCollectionSearchAnchorRequest? searchAnchor = AnchorKind == "search"
            ? new CreativeCollectionSearchAnchorRequest(
                SearchQuery.Trim(),
                SearchMode,
                string.IsNullOrWhiteSpace(SearchScopeId) ? null : SearchScopeId,
                SearchAnchorLimit)
            : null;
        return new CreativeCollectionRecipeRequest(
            TargetCount,
            ContextStrength,
            NoveltyEnabled,
            RecipeName.Trim(),
            searchAnchor);
    }

    private async Task PreviewAsync()
    {
        if (!Validate())
        {
            return;
        }

        Busy = true;
        Error = null;
        Notice = null;
        try
        {
            HttpResponseMessage response;
            if (AnchorKind == "search")
            {
                response = await Http.PostAsJsonAsync(
                    "api/creative-collections/preview",
                    BuildRequest());
            }
            else
            {
                string strength = Uri.EscapeDataString(ContextStrength);
                response = await Http.GetAsync(
                    $"api/smart-collections/{Uri.EscapeDataString(SmartAnchorId!)}/creative-preview?targetCount={TargetCount}&momentGapMinutes=30&contextStrength={strength}&novelty={NoveltyEnabled.ToString().ToLowerInvariant()}");
            }

            using (response)
            {
                if (!response.IsSuccessStatusCode)
                {
                    Error = await ReadErrorAsync(response, "The Creative Collection preview could not be generated.");
                    return;
                }
                Preview = await response.Content.ReadFromJsonAsync<CreativeCollectionPreviewResponse>();
            }
        }
        catch (Exception exception)
        {
            Error = $"The Creative Collection preview could not be generated: {exception.Message}";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task<CreativeCollectionRecipeResponse?> SaveCoreAsync()
    {
        if (!Validate())
        {
            return null;
        }

        CreativeCollectionRecipeRequest request = BuildRequest();
        using HttpResponseMessage response = SelectedRecipeId is not null
            ? await Http.PutAsJsonAsync(
                $"api/creative-collections/{Uri.EscapeDataString(SelectedRecipeId)}",
                request)
            : AnchorKind == "search"
                ? await Http.PostAsJsonAsync("api/creative-collections", request)
                : await Http.PostAsJsonAsync(
                    $"api/smart-collections/{Uri.EscapeDataString(SmartAnchorId!)}/creative-collections",
                    request);
        if (!response.IsSuccessStatusCode)
        {
            Error = await ReadErrorAsync(response, "The Creative Collection could not be saved.");
            return null;
        }

        CreativeCollectionRecipeResponse saved =
            await response.Content.ReadFromJsonAsync<CreativeCollectionRecipeResponse>()
            ?? throw new InvalidOperationException("The saved Creative Collection response was empty.");
        await ReloadAsync();
        SelectRecipe(saved);
        return saved;
    }

    private async Task SaveAsync()
    {
        Busy = true;
        Error = null;
        Notice = null;
        try
        {
            CreativeCollectionRecipeResponse? saved = await SaveCoreAsync();
            if (saved is not null)
            {
                Notice = $"Creative Collection '{saved.Name}' saved.";
            }
        }
        catch (Exception exception)
        {
            Error = $"The Creative Collection could not be saved: {exception.Message}";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task SaveAndStartAsync()
    {
        Busy = true;
        Error = null;
        Notice = null;
        try
        {
            CreativeCollectionRecipeResponse? saved = await SaveCoreAsync();
            if (saved is null)
            {
                return;
            }

            _ = await SlideshowLibraryLaunch.RequestFullscreenAndNavigateAsync(
                JS,
                Navigation,
                saved.Id,
                "/creative-collections",
                creative: true);
        }
        catch (Exception exception)
        {
            Error = $"The Creative Collection could not be started: {exception.Message}";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (SelectedRecipeId is null)
        {
            return;
        }

        Busy = true;
        Error = null;
        Notice = null;
        string deletedName = RecipeName;
        try
        {
            using HttpResponseMessage response = await Http.DeleteAsync(
                $"api/creative-collections/{Uri.EscapeDataString(SelectedRecipeId)}");
            if (response.StatusCode != HttpStatusCode.NoContent)
            {
                Error = await ReadErrorAsync(response, "The Creative Collection could not be deleted.");
                return;
            }

            await ReloadAsync();
            NewRecipe();
            Notice = $"Deleted {deletedName}.";
        }
        catch (Exception exception)
        {
            Error = $"The Creative Collection could not be deleted: {exception.Message}";
        }
        finally
        {
            Busy = false;
        }
    }

    private string SourceLabel(CreativeCollectionRecipeResponse recipe)
    {
        if (recipe.SearchAnchor is CreativeCollectionSearchAnchorResponse search)
        {
            string scope = string.IsNullOrWhiteSpace(search.SmartCollectionName)
                ? "all photos"
                : search.SmartCollectionName;
            return $"Search · {SearchModeLabel(search.Mode)} · {scope}";
        }

        return $"Smart · {recipe.AnchorCollectionName ?? "Unavailable"}";
    }

    private string? AnchorEvidence(string revisionId)
    {
        CreativeCollectionSearchAnchorHitResponse? hit = Preview?.SearchAnchors?
            .FirstOrDefault(item => string.Equals(item.RevisionId, revisionId, StringComparison.OrdinalIgnoreCase));
        return hit is null
            ? null
            : $"#{hit.Rank} · {string.Join(" + ", hit.Sources.Select(SourceLabel))}";
    }

    private static string SearchModeLabel(string mode) => mode switch
    {
        "semantic" => "Visual",
        "caption" => "Captions",
        _ => "Visual + Captions",
    };

    private static string SourceLabel(string source) => source switch
    {
        "semantic" => "Visual",
        "caption" => "Caption",
        _ => source,
    };

    private void TrimRecipeName()
    {
        if (RecipeName.Length > 120)
        {
            RecipeName = RecipeName[..120];
        }
    }

    private void ClearPreview() => Preview = null;

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            SmartCollectionErrorResponse? payload =
                await response.Content.ReadFromJsonAsync<SmartCollectionErrorResponse>();
            return string.IsNullOrWhiteSpace(payload?.Error) ? fallback : payload.Error;
        }
        catch
        {
            return fallback;
        }
    }
}
