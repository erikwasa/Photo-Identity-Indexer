@page "/people"
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Maintain people · Photo Identity</PageTitle>

<section class="hero people-hero">
    <div>
        <p class="eyebrow">Canonical identity maintenance</p>
        <h1>Maintain people</h1>
        <p>Rename and merge identities, choose representative portraits, control Smart Collection visibility, and maintain optional birth dates and family relationships for age-aware family stories.</p>
    </div>

    <form class="person-creator" @onsubmit="CreatePersonAsync" @onsubmit:preventDefault>
        <label class="field-label" for="new-person-maintenance">Create person</label>
        <div class="inline-field">
            <input id="new-person-maintenance"
                   placeholder="Display name"
                   maxlength="200"
                   autocomplete="off"
                   @bind="NewPersonName"
                   @bind:event="oninput" />
            <button type="submit"
                    class="button primary"
                    disabled="@(string.IsNullOrWhiteSpace(NewPersonName) || Busy)">
                Add
            </button>
        </div>
    </form>
</section>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="notice error" role="alert">@Error</div>
}
@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="notice success" role="status">@Message</div>
}

@if (Loading)
{
    <section class="empty-state" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading people and maintenance history…</p>
    </section>
}
else if (ActivePeople.Count == 0)
{
    <section class="empty-state">
        <h2>No active people</h2>
        <p>Create the first person before assigning or maintaining identities.</p>
    </section>
}
else
{
    <section class="people-summary" aria-label="Active people">
        @foreach (PersonMaintenancePersonResponse person in ActivePeople)
        {
            <article class="person-summary-card @(person.HiddenFromSmartCollections ? "hidden-from-smart-collections" : "visible-in-smart-collections")">
                <PersonRepresentativePortrait PersonId="@person.Id" DisplayName="@person.DisplayName" />
                <strong>@PersonCardLabel(person)</strong>
                @if (person.HiddenFromSmartCollections)
                {
                    <span class="state-badge" title="Hidden from Smart Collections">Hidden</span>
                }
                <span>@person.PhotoCount photo@(person.PhotoCount == 1 ? "" : "s")</span>
                <span>@person.SuggestionCount suggestion@(person.SuggestionCount == 1 ? "" : "s")</span>
                <button type="button"
                        class="button secondary"
                        disabled="@Busy"
                        aria-pressed="@person.IsFavorite"
                        @onclick="() => ToggleFavoriteAsync(person)">
                    @(person.IsFavorite ? "Remove favorite" : "Add favorite")
                </button>
                <button type="button"
                        class="button secondary"
                        disabled="@Busy"
                        aria-pressed="@person.HiddenFromSmartCollections"
                        aria-label="@(person.HiddenFromSmartCollections ? $"Show {person.DisplayName} in Smart Collections" : $"Hide {person.DisplayName} from Smart Collections")"
                        @onclick="() => ToggleSmartCollectionVisibilityAsync(person)">
                    @(person.HiddenFromSmartCollections ? "Show" : "Hide")
                </button>
            </article>
        }
    </section>

    <div class="maintenance-grid">
        <section class="maintenance-card">
            <p class="eyebrow">Reversible operation</p>
            <h2>Rename person</h2>
            <p>Every rename stores both names. Restore an earlier name by applying another audited rename.</p>

            <label class="field-label" for="person-to-maintain">Person</label>
            <select id="person-to-maintain" @bind="SelectedPersonId" @bind:after="SelectedPersonChanged">
                @foreach (PersonMaintenancePersonResponse person in ActivePeople)
                {
                    <option value="@person.Id">@PersonSelectLabel(person)</option>
                }
            </select>

            <label class="field-label spaced" for="rename-person">New display name</label>
            <input id="rename-person"
                   maxlength="200"
                   @bind="RenameDisplayName"
                   @bind:event="oninput" />

            <label class="field-label spaced" for="maintenance-note">Audit note</label>
            <input id="maintenance-note"
                   maxlength="1000"
                   placeholder="Optional reason"
                   @bind="Note"
                   @bind:event="oninput" />

            <button class="button primary full-width"
                    disabled="@(Busy || string.IsNullOrWhiteSpace(RenameDisplayName) || SelectedPerson is null || RenameDisplayName.Trim() == SelectedPerson.DisplayName)"
                    @onclick="RenameAsync">
                Save audited rename
            </button>
        </section>

        <section class="maintenance-card danger-zone">
            <p class="eyebrow">Irreversible operation</p>
            <h2>Merge duplicate people</h2>
            <p>Labels, reviewed assignments and suggestions move to the surviving person. Family metadata follows the survivor deterministically: existing survivor birth metadata wins and relationships are rewired without self-links or duplicates.</p>

            <label class="field-label" for="merge-target">Surviving person</label>
            <select id="merge-target" @bind="MergeTargetId" disabled="@(MergeTargets.Count == 0)">
                @foreach (PersonMaintenancePersonResponse person in MergeTargets)
                {
                    <option value="@person.Id">@PersonSelectLabel(person)</option>
                }
            </select>

            <label class="confirmation-row">
                <input type="checkbox" @bind="ConfirmMerge" />
                <span>I understand that merging <strong>@(SelectedPerson?.DisplayName ?? "this person")</strong> is irreversible.</span>
            </label>

            <button class="button danger full-width"
                    disabled="@(Busy || !ConfirmMerge || string.IsNullOrWhiteSpace(MergeTargetId) || MergeTargets.Count == 0)"
                    @onclick="MergeAsync">
                Merge into @MergeTargetName
            </button>
        </section>
    </div>

    <section class="audit-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Family story metadata</p>
                <h2>Birth date and relationships</h2>
            </div>
            <span>Manual metadata only</span>
        </div>

        <div class="maintenance-grid">
            <section class="maintenance-card">
                <label class="field-label" for="family-person">Person</label>
                <select id="family-person" value="@FamilyPersonId" @onchange="FamilyPersonChangedAsync">
                    @foreach (PersonMaintenancePersonResponse person in ActivePeople)
                    {
                        <option value="@person.Id">@PersonSelectLabel(person)</option>
                    }
                </select>

                <label class="field-label spaced" for="birth-precision">Known birth precision</label>
                <select id="birth-precision" @bind="BirthPrecision" @bind:after="BirthPrecisionChanged">
                    <option value="year">Year only</option>
                    <option value="month">Year and month</option>
                    <option value="day">Exact day</option>
                </select>

                <label class="field-label spaced" for="birth-year">Year</label>
                <input id="birth-year" type="number" min="1" max="9999" @bind="BirthYear" />

                @if (BirthPrecision is "month" or "day")
                {
                    <label class="field-label spaced" for="birth-month">Month</label>
                    <input id="birth-month" type="number" min="1" max="12" @bind="BirthMonth" />
                }

                @if (BirthPrecision == "day")
                {
                    <label class="field-label spaced" for="birth-day">Day</label>
                    <input id="birth-day" type="number" min="1" max="31" @bind="BirthDay" />
                }

                <div class="inline-field spaced">
                    <button class="button primary"
                            disabled="@(Busy || BirthYear is null)"
                            @onclick="SaveBirthAsync">
                        Save birth metadata
                    </button>
                    <button class="button secondary"
                            disabled="@(Busy || FamilyMetadata?.BirthDate is null)"
                            @onclick="ClearBirthAsync">
                        Clear
                    </button>
                </div>
            </section>

            <section class="maintenance-card">
                <h3>Add relationship</h3>
                <p>Choose the relationship from <strong>@FamilyPersonName</strong>'s perspective. The inverse relationship is shown automatically for the other person.</p>

                <label class="field-label" for="relationship-kind">Relationship</label>
                <select id="relationship-kind" @bind="RelationshipKind">
                    <option value="parent">Parent</option>
                    <option value="child">Child</option>
                    <option value="spouse">Spouse</option>
                    <option value="sibling">Sibling</option>
                    <option value="grandparent">Grandparent</option>
                    <option value="grandchild">Grandchild</option>
                </select>

                <label class="field-label spaced" for="relationship-person">Related person</label>
                <select id="relationship-person" @bind="RelationshipTargetId" disabled="@(FamilyRelationshipTargets.Count == 0)">
                    @foreach (PersonMaintenancePersonResponse person in FamilyRelationshipTargets)
                    {
                        <option value="@person.Id">@PersonSelectLabel(person)</option>
                    }
                </select>

                <button class="button primary full-width"
                        disabled="@(Busy || string.IsNullOrWhiteSpace(RelationshipTargetId) || FamilyRelationshipTargets.Count == 0)"
                        @onclick="AddRelationshipAsync">
                    Add relationship
                </button>

                @if (FamilyMetadata?.Relationships.Length > 0)
                {
                    <ul class="timeline">
                        @foreach (PersonFamilyRelationshipResponse relationship in FamilyMetadata.Relationships)
                        {
                            <li>
                                <div>
                                    <strong>@RelationshipLabel(relationship.Kind): @relationship.RelatedPersonDisplayName</strong>
                                    <button type="button"
                                            class="button secondary"
                                            disabled="@Busy"
                                            @onclick="() => RemoveRelationshipAsync(relationship.Id)">
                                        Remove
                                    </button>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>No family relationships recorded for this person.</p>
                }
            </section>
        </div>
    </section>

    <section class="audit-section person-history">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Append-only audit trail</p>
                <h2>Person maintenance history</h2>
            </div>
            <span>@History.Count action@(History.Count == 1 ? "" : "s")</span>
        </div>

        @if (History.Count == 0)
        {
            <div class="empty-state compact"><p>No person maintenance actions have been recorded.</p></div>
        }
        else
        {
            <ol class="timeline">
                @foreach (PersonMaintenanceActionResponse action in History)
                {
                    <li>
                        <div class="timeline-marker" aria-hidden="true"></div>
                        <div>
                            <div class="timeline-title">
                                <strong>@ActionLabel(action)</strong>
                                <span class="state-badge">@(action.Reversible ? "Reversible" : "Irreversible")</span>
                            </div>
                            <p>@action.Actor · @action.CreatedAtUtc.ToLocalTime().ToString("g")</p>
                            @if (!string.IsNullOrWhiteSpace(action.Note))
                            {
                                <blockquote>@action.Note</blockquote>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </section>
}

@code {
    private const string Actor = "local-reviewer";

    private IReadOnlyList<PersonMaintenancePersonResponse> ActivePeople { get; set; } = [];
    private IReadOnlyList<PersonMaintenanceActionResponse> History { get; set; } = [];
    private PersonFamilyMetadataResponse? FamilyMetadata { get; set; }
    private string SelectedPersonId { get; set; } = "";
    private string RenameDisplayName { get; set; } = "";
    private string MergeTargetId { get; set; } = "";
    private string NewPersonName { get; set; } = "";
    private string Note { get; set; } = "";
    private string FamilyPersonId { get; set; } = "";
    private string BirthPrecision { get; set; } = "year";
    private int? BirthYear { get; set; }
    private int? BirthMonth { get; set; }
    private int? BirthDay { get; set; }
    private string RelationshipKind { get; set; } = "parent";
    private string RelationshipTargetId { get; set; } = "";
    private bool ConfirmMerge { get; set; }
    private bool Loading { get; set; } = true;
    private bool Busy { get; set; }
    private string? Error { get; set; }
    private string? Message { get; set; }

    private PersonMaintenancePersonResponse? SelectedPerson =>
        ActivePeople.FirstOrDefault(person => person.Id == SelectedPersonId);

    private IReadOnlyList<PersonMaintenancePersonResponse> MergeTargets =>
        ActivePeople.Where(person => person.Id != SelectedPersonId).ToArray();

    private IReadOnlyList<PersonMaintenancePersonResponse> FamilyRelationshipTargets =>
        ActivePeople.Where(person => person.Id != FamilyPersonId).ToArray();

    private string MergeTargetName =>
        MergeTargets.FirstOrDefault(person => person.Id == MergeTargetId)?.DisplayName ?? "selected person";

    private string FamilyPersonName =>
        ActivePeople.FirstOrDefault(person => person.Id == FamilyPersonId)?.DisplayName ?? "this person";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            PersonMaintenancePersonResponse[] people = await Http.GetFromJsonAsync<PersonMaintenancePersonResponse[]>(
                "api/review/people/maintenance") ?? [];
            ActivePeople = people
                .OrderBy(person => person.HiddenFromSmartCollections)
                .ThenByDescending(person => person.IsFavorite)
                .ThenBy(person => person.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(person => person.Id, StringComparer.Ordinal)
                .ToArray();
            History = await Http.GetFromJsonAsync<PersonMaintenanceActionResponse[]>(
                "api/review/people/maintenance/history?limit=100") ?? [];
            ResetSelection();
            if (ActivePeople.All(person => person.Id != FamilyPersonId))
            {
                FamilyPersonId = ActivePeople.FirstOrDefault()?.Id ?? "";
            }

            await LoadFamilyAsync();
        }
        catch (Exception exception)
        {
            Error = $"Person maintenance could not be loaded: {exception.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private void ResetSelection()
    {
        if (ActivePeople.All(person => person.Id != SelectedPersonId))
        {
            SelectedPersonId = ActivePeople.FirstOrDefault()?.Id ?? "";
        }

        SelectedPersonChanged();
    }

    private void SelectedPersonChanged()
    {
        RenameDisplayName = SelectedPerson?.DisplayName ?? "";
        MergeTargetId = MergeTargets.FirstOrDefault()?.Id ?? "";
        ConfirmMerge = false;
    }

    private async Task FamilyPersonChangedAsync(ChangeEventArgs args)
    {
        FamilyPersonId = args.Value?.ToString() ?? "";
        await LoadFamilyAsync();
    }

    private async Task LoadFamilyAsync()
    {
        FamilyMetadata = null;
        BirthYear = null;
        BirthMonth = null;
        BirthDay = null;
        BirthPrecision = "year";
        RelationshipTargetId = FamilyRelationshipTargets.FirstOrDefault()?.Id ?? "";

        if (string.IsNullOrWhiteSpace(FamilyPersonId))
        {
            return;
        }

        using HttpResponseMessage response = await Http.GetAsync(
            $"api/review/people/{Uri.EscapeDataString(FamilyPersonId)}/family");
        await RequireSuccessAsync(response);
        FamilyMetadata = await response.Content.ReadFromJsonAsync<PersonFamilyMetadataResponse>();
        if (FamilyMetadata?.BirthDate is PersonBirthDateResponse birth)
        {
            BirthYear = birth.Year;
            BirthMonth = birth.Month;
            BirthDay = birth.Day;
            BirthPrecision = birth.Precision;
        }
    }

    private void BirthPrecisionChanged()
    {
        if (BirthPrecision == "year")
        {
            BirthMonth = null;
            BirthDay = null;
        }
        else if (BirthPrecision == "month")
        {
            BirthDay = null;
        }
    }

    private async Task SaveBirthAsync()
    {
        if (BirthYear is null)
        {
            return;
        }

        await ApplyFamilyAsync(
            () => Http.PutAsJsonAsync(
                $"api/review/people/{Uri.EscapeDataString(FamilyPersonId)}/birth",
                new SetPersonBirthDateRequest(BirthYear, BirthMonth, BirthDay, BirthPrecision, Actor)),
            $"Saved birth metadata for {FamilyPersonName}.");
    }

    private async Task ClearBirthAsync()
    {
        await ApplyFamilyAsync(
            () => Http.PutAsJsonAsync(
                $"api/review/people/{Uri.EscapeDataString(FamilyPersonId)}/birth",
                new SetPersonBirthDateRequest(null, null, null, null, Actor)),
            $"Cleared birth metadata for {FamilyPersonName}.");
    }

    private async Task AddRelationshipAsync()
    {
        string relatedName = ActivePeople.FirstOrDefault(person => person.Id == RelationshipTargetId)?.DisplayName ?? "person";
        await ApplyFamilyAsync(
            () => Http.PostAsJsonAsync(
                $"api/review/people/{Uri.EscapeDataString(FamilyPersonId)}/relationships",
                new AddPersonFamilyRelationshipRequest(RelationshipTargetId, RelationshipKind, Actor)),
            $"Added {RelationshipLabel(RelationshipKind).ToLowerInvariant()} relationship with {relatedName}.");
    }

    private async Task RemoveRelationshipAsync(long relationshipId)
    {
        await ApplyFamilyAsync(
            () => Http.DeleteAsync(
                $"api/review/people/{Uri.EscapeDataString(FamilyPersonId)}/relationships/{relationshipId}"),
            "Removed family relationship.");
    }

    private async Task ApplyFamilyAsync(
        Func<Task<HttpResponseMessage>> sendAsync,
        string successMessage)
    {
        Busy = true;
        Error = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await sendAsync();
            await RequireSuccessAsync(response);
            Message = successMessage;
            await LoadFamilyAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task CreatePersonAsync()
    {
        if (Busy || string.IsNullOrWhiteSpace(NewPersonName))
        {
            return;
        }

        string createdName = NewPersonName.Trim();
        await ApplyAsync(
            () => Http.PostAsJsonAsync("api/review/people", new CreatePersonRequest(createdName)),
            $"Created {createdName}.");
        if (string.IsNullOrWhiteSpace(Error))
        {
            NewPersonName = "";
        }
    }

    private async Task ToggleFavoriteAsync(PersonMaintenancePersonResponse person)
    {
        bool favorite = !person.IsFavorite;
        await ApplyAsync(
            () => Http.PutAsJsonAsync(
                $"api/review/people/{Uri.EscapeDataString(person.Id)}/favorite",
                new SetPersonFavoriteRequest(favorite)),
            favorite
                ? $"Added {person.DisplayName} to favorites."
                : $"Removed {person.DisplayName} from favorites.");
    }

    private async Task ToggleSmartCollectionVisibilityAsync(PersonMaintenancePersonResponse person)
    {
        bool hidden = !person.HiddenFromSmartCollections;
        await ApplyAsync(
            () => Http.PutAsJsonAsync(
                $"api/review/people/{Uri.EscapeDataString(person.Id)}/smart-collection-visibility",
                new SetPersonSmartCollectionVisibilityRequest(hidden)),
            hidden
                ? $"Hidden {person.DisplayName} from Smart Collection people selection."
                : $"Made {person.DisplayName} available in Smart Collection people selection.");
    }

    private async Task RenameAsync()
    {
        string personId = SelectedPersonId;
        string renamedTo = RenameDisplayName.Trim();
        await ApplyAsync(
            () => Http.PostAsJsonAsync(
                $"api/review/people/{Uri.EscapeDataString(personId)}/rename",
                new RenamePersonRequest(renamedTo, Actor, EmptyToNull(Note))),
            $"Renamed person to {renamedTo}.");
    }

    private async Task MergeAsync()
    {
        string sourceName = SelectedPerson?.DisplayName ?? "Person";
        string targetId = MergeTargetId;
        string targetName = MergeTargetName;
        await ApplyAsync(
            () => Http.PostAsJsonAsync(
                $"api/review/people/{Uri.EscapeDataString(SelectedPersonId)}/merge",
                new MergePersonRequest(targetId, ConfirmMerge, Actor, EmptyToNull(Note))),
            $"Merged {sourceName} into {targetName}.");
        SelectedPersonId = targetId;
        ResetSelection();
    }

    private async Task ApplyAsync(
        Func<Task<HttpResponseMessage>> sendAsync,
        string successMessage)
    {
        Busy = true;
        Error = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await sendAsync();
            await RequireSuccessAsync(response);
            Message = successMessage;
            Note = "";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private static string PersonCardLabel(PersonMaintenancePersonResponse person) =>
        person.IsFavorite ? $"★ {person.DisplayName}" : person.DisplayName;

    private static string PersonSelectLabel(PersonMaintenancePersonResponse person) =>
        person.IsFavorite ? $"{person.DisplayName} — Favorite" : person.DisplayName;

    private static string RelationshipLabel(string kind) => kind switch
    {
        "parent" => "Parent",
        "child" => "Child",
        "spouse" => "Spouse",
        "sibling" => "Sibling",
        "grandparent" => "Grandparent",
        "grandchild" => "Grandchild",
        _ => kind,
    };

    private static string ActionLabel(PersonMaintenanceActionResponse action) => action.Kind switch
    {
        "rename" => $"Renamed {action.PreviousDisplayName} to {action.NewDisplayName}",
        "merge" => $"Merged {action.PreviousDisplayName} into {action.NewDisplayName}",
        _ => action.Kind,
    };

    private static string? EmptyToNull(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static async Task RequireSuccessAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return;
        }

        string detail = await response.Content.ReadAsStringAsync();
        throw new InvalidOperationException(
            string.IsNullOrWhiteSpace(detail)
                ? $"The person maintenance action failed with status {(int)response.StatusCode}."
                : detail);
    }
}
