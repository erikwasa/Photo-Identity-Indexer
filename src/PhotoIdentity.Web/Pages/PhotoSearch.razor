@page "/search"
@using System.Net.Http.Json
@using PhotoIdentity.Web.Contracts
@inject HttpClient Http
@inject PhotoSearchSessionState SearchState

<PageTitle>Photo search · Photo Identity</PageTitle>

<section class="photo-search-header">
    <div>
        <p class="eyebrow">Semantic photo search</p>
        <h1>Search photos in natural language</h1>
        <p>
            Search visually for what a photo looks like, by generated caption text, or with both sources together.
            Selections stay in your working collection while you run more searches or inspect individual photos.
        </p>
    </div>
    @if (Status is not null)
    {
        <div class="photo-search-index-status" role="status">
            <strong>@Status.IndexedPhotoCount / @Status.CurrentPhotoCount</strong>
            <span>semantic vectors</span>
            <small>@Status.DisplayableCaptionCount displayable captions</small>
        </div>
    }
</section>

@if (Status is { SemanticModelAvailable: false })
{
    <section class="photo-search-notice" role="status">
        <strong>Caption search is available; semantic indexing is not active yet.</strong>
        <p>
            Install the pinned local CLIP assets with <code>.\models\Get-SemanticSearchClipModel.ps1</code>
            and restart the application. No model is downloaded automatically.
        </p>
    </section>
}

<section class="photo-search-controls" aria-label="Photo search controls">
    <label class="photo-search-query">
        <span>Describe the photo</span>
        <input @bind="Query"
               @bind:event="oninput"
               maxlength="300"
               placeholder="children playing outdoors"
               disabled="@Busy"
               @onkeydown="HandleQueryKeyDown" />
        <small>Use English for Visual search. Captions are searched in the language in which they were generated.</small>
    </label>

    <label class="photo-search-scope">
        <span>Smart Collection scope</span>
        <select @bind="SmartCollectionId" disabled="@Busy">
            <option value="">All photos</option>
            @foreach (SmartCollectionDefinitionResponse collection in SmartCollections)
            {
                <option value="@collection.Id">@collection.Name</option>
            }
        </select>
        <small>Optional. Smart Collection rules stay exact; search ranks only photos inside the selected collection.</small>
    </label>

    <label>
        <span>Evidence</span>
        <select @bind="Mode" disabled="@Busy">
            <option value="combined">Visual + captions</option>
            <option value="semantic">Visual only</option>
            <option value="caption">Captions only</option>
        </select>
    </label>

    <label>
        <span>Results</span>
        <select @bind="Limit" disabled="@Busy">
            <option value="40">40</option>
            <option value="80">80</option>
            <option value="120">120</option>
            <option value="200">200</option>
            <option value="400">400</option>
            <option value="800">800</option>
            <option value="1000">1000</option>
        </select>
    </label>

    <button type="button"
            class="button primary"
            disabled="@(Busy || string.IsNullOrWhiteSpace(Query))"
            @onclick="SearchAsync">
        @(Busy ? "Searching…" : "Search")
    </button>
</section>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="photo-search-error" role="alert">@Error</div>
}

@if (Results is not null)
{
    <section class="photo-search-summary">
        <div>
            <strong>@Results.Items.Length results</strong>
            <span>in @Results.SearchMilliseconds.ToString("0") ms</span>
            @if (Results.Scope is not null)
            {
                <span>· @Results.Scope.CollectionName (@Results.Scope.EligiblePhotoCount eligible)</span>
            }
            <span>· @SearchState.SelectedCount selected across searches</span>
        </div>
        <div class="photo-search-selection-actions">
            <button type="button" class="button secondary" @onclick="SelectAllCurrent">Select current results</button>
            <button type="button" class="button secondary" @onclick="ClearSelection">Clear collection</button>
        </div>
    </section>

    @if (Results.Items.Length == 0)
    {
        <section class="empty-state compact">
            @if (Results.Scope is { EligiblePhotoCount: 0 })
            {
                <p>The selected Smart Collection currently contains no eligible photos. Choose another scope or clear the scope to search the full library.</p>
            }
            else
            {
                <p>No photos matched this search yet. Try a simpler phrase, a different evidence mode, or a broader Smart Collection scope.</p>
            }
        </section>
    }
    else
    {
        <section class="photo-search-grid" aria-label="Photo search results">
            @for (int index = 0; index < Results.Items.Length; index++)
            {
                PhotoSearchResultResponse result = Results.Items[index];
                bool selected = SearchState.IsSelected(result.RevisionId);
                <article class="photo-search-card @(selected ? "selected" : null)">
                    <label class="photo-search-select">
                        <input type="checkbox"
                               checked="@selected"
                               @onchange="args => SetSelected(result.RevisionId, args)" />
                        <span>Select</span>
                    </label>
                    <a href="@result.PhotoUrl" aria-label="Open photo">
                        <img src="@result.ThumbnailUrl"
                             alt="Photo search result"
                             loading="lazy"
                             decoding="async" />
                    </a>
                    <div class="photo-search-card-body">
                        <div class="photo-search-badges">
                            @if (result.Sources.Contains("semantic", StringComparer.Ordinal))
                            {
                                <span class="photo-search-badge">Visual</span>
                            }
                            @if (result.Sources.Contains("caption", StringComparer.Ordinal))
                            {
                                <span class="photo-search-badge caption">Caption</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(result.Caption))
                        {
                            <p>@result.Caption</p>
                        }
                        else
                        {
                            <p class="photo-search-muted">Matched without a generated caption.</p>
                        }
                    </div>
                </article>
            }
        </section>
    }

    <section class="photo-search-save" aria-labelledby="photo-search-save-heading">
        <div>
            <p class="eyebrow">Working collection</p>
            <h2 id="photo-search-save-heading">Save or add @SearchState.SelectedCount selected photos</h2>
            <p>
                Your selection is kept while you run more searches and while you open a photo and return to search.
                Saving creates an explicit ordered slideshow list; adding to an existing slideshow keeps its current order and appends new photos.
            </p>
        </div>
        <label>
            <span>New collection name</span>
            <input @bind="CollectionName"
                   maxlength="120"
                   placeholder="Summer memories"
                   disabled="@Saving" />
        </label>
        <button type="button"
                class="button primary"
                disabled="@(Saving || SearchState.SelectedCount == 0 || string.IsNullOrWhiteSpace(CollectionName))"
                @onclick="SaveCollectionAsync">
            @(Saving ? "Saving…" : $"Save {SearchState.SelectedCount} as new collection")
        </button>

        @if (LoadingCollections)
        {
            <p class="photo-search-muted">Loading existing slideshow collections…</p>
        }
        else if (Collections.Count > 0)
        {
            <label>
                <span>Add to existing collection</span>
                <select @bind="ExistingCollectionId" disabled="@AddingToExisting">
                    @foreach (PhotoListCollectionResponse collection in Collections)
                    {
                        <option value="@collection.Id">@collection.Name (@collection.RevisionIds.Length)</option>
                    }
                </select>
            </label>
            <button type="button"
                    class="button secondary"
                    disabled="@(AddingToExisting || SearchState.SelectedCount == 0 || SelectedExistingCollection is null)"
                    @onclick="AddToExistingCollectionAsync">
                @(AddingToExisting ? "Adding…" : $"Add {SearchState.SelectedCount} selected")
            </button>
        }
        else
        {
            <p class="photo-search-muted">No existing slideshow collections yet.</p>
        }

        @if (!string.IsNullOrWhiteSpace(SaveMessage))
        {
            <p class="photo-search-save-message" role="status">
                @SaveMessage <a href="/slideshows">Open Slideshows</a>
            </p>
        }
        @if (!string.IsNullOrWhiteSpace(CollectionError))
        {
            <p class="photo-search-error" role="alert">@CollectionError</p>
        }
    </section>
}

<details class="photo-search-details">
    <summary>How search works</summary>
    <p>
        <strong>Visual</strong> compares your English description with the visual content of indexed photos. It can find a scene or object even when no caption contains the same words.
    </p>
    <p>
        <strong>Captions</strong> searches the generated text descriptions saved for photos. Caption search works best when you use the same language as the stored captions. <strong>Visual + captions</strong> combines both kinds of matches.
    </p>
</details>

@code {
    private string Query
    {
        get => SearchState.Query;
        set => SearchState.Query = value;
    }

    private string Mode
    {
        get => SearchState.Mode;
        set => SearchState.Mode = value;
    }

    private int Limit
    {
        get => SearchState.Limit;
        set => SearchState.Limit = value;
    }

    private string SmartCollectionId
    {
        get => SearchState.SmartCollectionId;
        set => SearchState.SmartCollectionId = value;
    }

    private string CollectionName
    {
        get => SearchState.CollectionName;
        set => SearchState.CollectionName = value;
    }

    private string? ExistingCollectionId
    {
        get => SearchState.ExistingCollectionId;
        set => SearchState.ExistingCollectionId = value;
    }

    private PhotoSearchResponse? Results
    {
        get => SearchState.Results;
        set => SearchState.Results = value;
    }

    private bool Busy { get; set; }
    private bool Saving { get; set; }
    private bool AddingToExisting { get; set; }
    private bool LoadingCollections { get; set; }
    private string? Error { get; set; }
    private string? SaveMessage { get; set; }
    private string? CollectionError { get; set; }
    private PhotoSearchStatusResponse? Status { get; set; }
    private IReadOnlyList<PhotoListCollectionResponse> Collections { get; set; } = [];
    private IReadOnlyList<SmartCollectionDefinitionResponse> SmartCollections { get; set; } = [];

    private PhotoListCollectionResponse? SelectedExistingCollection =>
        Collections.FirstOrDefault(collection => string.Equals(
            collection.Id,
            ExistingCollectionId,
            StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadStatusAsync(), LoadCollectionsAsync(), LoadSmartCollectionsAsync());
    }

    private async Task LoadStatusAsync()
    {
        try
        {
            Status = await Http.GetFromJsonAsync<PhotoSearchStatusResponse>("/api/photo-search/status");
        }
        catch
        {
            Status = null;
        }
    }

    private async Task LoadSmartCollectionsAsync()
    {
        try
        {
            SmartCollections = await Http.GetFromJsonAsync<SmartCollectionDefinitionResponse[]>(
                "/api/smart-collections") ?? [];
            if (!string.IsNullOrWhiteSpace(SmartCollectionId)
                && !SmartCollections.Any(collection => string.Equals(
                    collection.Id,
                    SmartCollectionId,
                    StringComparison.OrdinalIgnoreCase)))
            {
                SmartCollectionId = string.Empty;
            }
        }
        catch
        {
            SmartCollections = [];
        }
    }

    private async Task LoadCollectionsAsync(string? selectId = null)
    {
        LoadingCollections = true;
        CollectionError = null;
        try
        {
            Collections = await Http.GetFromJsonAsync<PhotoListCollectionResponse[]>(
                "/api/photo-list-collections") ?? [];
            string? requested = selectId ?? ExistingCollectionId;
            ExistingCollectionId = Collections.Any(collection => string.Equals(
                    collection.Id,
                    requested,
                    StringComparison.OrdinalIgnoreCase))
                ? requested
                : Collections.FirstOrDefault()?.Id;
        }
        catch (Exception exception)
        {
            Collections = [];
            CollectionError = $"Existing slideshow collections could not be loaded: {exception.Message}";
        }
        finally
        {
            LoadingCollections = false;
        }
    }

    private async Task SearchAsync()
    {
        if (Busy || string.IsNullOrWhiteSpace(Query))
        {
            return;
        }

        Busy = true;
        Error = null;
        SaveMessage = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "/api/photo-search/query",
                new PhotoSearchRequest(
                    Query.Trim(),
                    Mode,
                    Limit,
                    string.IsNullOrWhiteSpace(SmartCollectionId) ? null : SmartCollectionId));
            if (!response.IsSuccessStatusCode)
            {
                Error = await ReadErrorAsync(response, "Photo search failed.");
                return;
            }

            Results = await response.Content.ReadFromJsonAsync<PhotoSearchResponse>();
            if (Results is not null)
            {
                SearchState.SelectAll(Results.Items.Select(item => item.RevisionId));
            }
            await LoadStatusAsync();
        }
        catch (Exception exception)
        {
            Error = $"Photo search failed: {exception.Message}";
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task SaveCollectionAsync()
    {
        if (Saving || SearchState.SelectedCount == 0 || string.IsNullOrWhiteSpace(CollectionName))
        {
            return;
        }

        Saving = true;
        Error = null;
        SaveMessage = null;
        CollectionError = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "/api/photo-search/collections",
                new PhotoSearchSaveCollectionRequest(
                    CollectionName.Trim(),
                    SearchState.SelectedRevisionIds.ToArray()));
            if (!response.IsSuccessStatusCode)
            {
                Error = await ReadErrorAsync(response, "The slideshow collection could not be saved.");
                return;
            }

            PhotoListCollectionResponse? saved =
                await response.Content.ReadFromJsonAsync<PhotoListCollectionResponse>();
            SaveMessage = saved is null
                ? "Saved the selected search results."
                : $"Saved “{saved.Name}” with {saved.RevisionIds.Length} photos.";
            CollectionName = string.Empty;
            await LoadCollectionsAsync(saved?.Id);
        }
        catch (Exception exception)
        {
            Error = $"The slideshow collection could not be saved: {exception.Message}";
        }
        finally
        {
            Saving = false;
        }
    }

    private async Task AddToExistingCollectionAsync()
    {
        PhotoListCollectionResponse? collection = SelectedExistingCollection;
        if (collection is null || AddingToExisting || SearchState.SelectedCount == 0)
        {
            return;
        }

        string[] revisionIds = collection.RevisionIds
            .Concat(SearchState.SelectedRevisionIds)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        int addedCount = revisionIds.Length - collection.RevisionIds.Length;
        if (addedCount == 0)
        {
            SaveMessage = $"“{collection.Name}” already contains all selected photos.";
            return;
        }

        AddingToExisting = true;
        Error = null;
        SaveMessage = null;
        CollectionError = null;
        try
        {
            using HttpResponseMessage response = await Http.PutAsJsonAsync(
                $"/api/photo-list-collections/{Uri.EscapeDataString(collection.Id)}",
                new PhotoListCollectionRequest(collection.Name, revisionIds));
            if (!response.IsSuccessStatusCode)
            {
                CollectionError = await ReadErrorAsync(
                    response,
                    "The existing slideshow collection could not be updated.");
                return;
            }

            PhotoListCollectionResponse? updated =
                await response.Content.ReadFromJsonAsync<PhotoListCollectionResponse>();
            if (updated is null)
            {
                CollectionError = "The existing slideshow collection response was empty.";
                return;
            }

            Collections = Collections
                .Select(item => string.Equals(item.Id, updated.Id, StringComparison.OrdinalIgnoreCase)
                    ? updated
                    : item)
                .ToArray();
            ExistingCollectionId = updated.Id;
            SaveMessage = $"Added {addedCount} photo{(addedCount == 1 ? string.Empty : "s")} to “{updated.Name}”.";
        }
        catch (Exception exception)
        {
            CollectionError = $"The existing slideshow collection could not be updated: {exception.Message}";
        }
        finally
        {
            AddingToExisting = false;
        }
    }

    private async Task HandleQueryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private void SetSelected(string revisionId, ChangeEventArgs args)
    {
        bool selected = args.Value is bool value && value;
        SearchState.SetSelected(revisionId, selected);
    }

    private void SelectAllCurrent()
    {
        if (Results is null)
        {
            return;
        }
        SearchState.SelectAll(Results.Items.Select(result => result.RevisionId));
    }

    private void ClearSelection() => SearchState.ClearSelection();

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            ApiErrorResponse? error = await response.Content.ReadFromJsonAsync<ApiErrorResponse>();
            return string.IsNullOrWhiteSpace(error?.Error) ? fallback : error.Error;
        }
        catch
        {
            return fallback;
        }
    }

    private sealed record ApiErrorResponse(string Error);
}
