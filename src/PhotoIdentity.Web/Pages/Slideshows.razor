@page "/slideshows"
@layout ConsumerLayout

<PageTitle>Slideshows · Photo Identity</PageTitle>

<section class="slideshow-library-header">
    <div>
        <p class="eyebrow">Family slideshows</p>
        <h1>Choose a slideshow</h1>
        <p>Tap a slideshow and start watching.</p>
    </div>
</section>

<UnifiedSlideshowLibrary CatalogueLoading="@Loading"
                         CatalogueError="@Error"
                         RefreshRequested="RefreshAsync"
                         PreparationLookup="@PreparationFor"
                         BusyLookup="@IsBusy"
                         StartingLookup="@IsStarting" />

<details class="slideshow-library-settings">
    <summary>Playback preferences</summary>
    <div class="slideshow-library-settings-body">
        <SlideshowSettingsEditor Settings="@Settings"
                                 SettingsChanged="ChangeSettingsAsync" />
        <p class="slideshow-library-note">
            These browser-local preferences are reused whenever a slideshow starts.
        </p>
    </div>
</details>

@if (Collections.Count > 0)
{
    <details class="slideshow-library-settings">
        <summary>Parent preparation tools</summary>
        <div class="slideshow-library-settings-body">
            <p class="slideshow-library-note">
                Optional: prepare best-quality originals ahead of time. Ordinary playback follows the saved Prepare originals preference automatically.
            </p>

            @foreach (SlideshowLibraryEntry collection in Collections)
            {
                SlideshowOriginalPreparationResponse? preparation = PreparationFor(collection.Id);
                bool preparing = preparation?.State == "preparing";
                bool needsAttention = SlideshowPreparationExperience.NeedsParentAttention(preparation);
                bool starting = IsStarting(collection.Id);

                <div class="slideshow-library-preparation" role="status">
                    <strong>@collection.Name</strong>

                    @if (preparation?.State == "ready")
                    {
                        <span>@preparation.Ready / @preparation.Total originals are prepared.</span>
                    }
                    else if (preparation is { State: "preparing" })
                    {
                        <span>@preparation.Ready / @preparation.Total ready</span>
                        @if (preparation.CanRetry)
                        {
                            <div class="slideshow-library-warning" role="alert">
                                @if (preparation.Phase == "onedrive-unavailable")
                                {
                                    <strong>OneDrive is not available</strong>
                                    <span>@preparation.Message</span>
                                }
                                else
                                {
                                    <strong>OneDrive has not made progress</strong>
                                    <span>No progress for @preparation.NoProgressSeconds seconds.</span>
                                }
                            </div>
                        }
                    }
                    else if (needsAttention)
                    {
                        <span>@preparation!.Message</span>
                        @if (preparation.RequiredAdditionalBytes > 0)
                        {
                            <span>Required additional bytes: @preparation.RequiredAdditionalBytes</span>
                            <span>Available managed capacity: @preparation.AvailableManagedCapacity</span>
                        }
                    }
                    else
                    {
                        <span>No standalone preparation is running.</span>
                    }

                    <div class="slideshow-library-actions">
                        @if (preparation?.CanRetry == true)
                        {
                            <button type="button"
                                    class="button secondary"
                                    @onclick="() => RetryPreparationAsync(collection.Id)">
                                Retry preparation
                            </button>
                        }

                        @if (preparing || needsAttention)
                        {
                            <button type="button"
                                    class="button secondary"
                                    @onclick="() => CancelPreparationAsync(collection.Id)">
                                Cancel preparation
                            </button>
                        }
                        else if (!starting)
                        {
                            <button type="button"
                                    class="button secondary"
                                    @onclick="() => PrepareOriginalsAsync(collection)">
                                @(preparation?.State == "ready" ? "Prepare again" : "Prepare originals")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </details>
}

<section class="slideshow-library-boundary">
    <strong>Viewing only</strong>
    <p>To edit or delete collections, open Full app and choose Manage collections. This space is for viewing slideshows.</p>
</section>
