@page "/slideshows"
@layout ConsumerLayout

<PageTitle>Slideshows · Photo Identity</PageTitle>

<section class="slideshow-library-header">
    <div>
        <p class="eyebrow">Family slideshows</p>
        <h1>Choose a slideshow</h1>
        <p>Tap a collection and start watching.</p>
    </div>
</section>

@if (Loading)
{
    <section class="slideshow-library-state" role="status">
        <div class="spinner" aria-hidden="true"></div>
        <p>Finding your slideshows…</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(Error))
{
    <section class="slideshow-library-state" role="alert">
        <strong>Slideshows could not be loaded</strong>
        <p>@Error</p>
        <button type="button" class="button secondary" @onclick="LoadCollectionsAsync">Retry</button>
    </section>
}
else if (Collections.Count == 0)
{
    <section class="slideshow-library-state">
        <h2>No slideshows yet</h2>
        <p>Saved Smart Collections and manual slideshows will appear here when they are available.</p>
    </section>
}
else
{
    <section class="slideshow-library-grid" aria-label="Slideshows">
        @foreach (SlideshowLibraryEntry collection in Collections)
        {
            SlideshowOriginalPreparationResponse? preparation = PreparationFor(collection.Id);
            bool preparing = preparation?.State == "preparing";
            bool needsAttention = SlideshowPreparationExperience.NeedsParentAttention(preparation);
            bool starting = IsStarting(collection.Id);
            bool busy = preparing || needsAttention || starting;

            <article class="slideshow-library-card">
                <button type="button"
                        class="slideshow-library-primary"
                        disabled="@busy"
                        aria-label="@SlideshowLibraryPresentation.PlayAriaLabel(collection.Name)"
                        @onclick="() => StartSlideshowAsync(collection)">
                    <SlideshowLibraryCover CollectionId="@collection.Id"
                                           Manual="@collection.Manual"
                                           CoverRevisionId="@collection.CoverRevisionId" />
                    <span class="slideshow-library-card-shade" aria-hidden="true"></span>
                    <span class="slideshow-library-card-copy">
                        <span class="slideshow-library-card-title">@collection.Name</span>
                        @if (collection.Manual)
                        {
                            <span class="slideshow-library-card-kind">Manual · @((collection.CoverRevisionId is null) ? "empty" : "explicit photos")</span>
                        }
                        <span class="slideshow-library-card-cue">
                            <span class="slideshow-library-play-mark" aria-hidden="true">▶</span>
                            @if (starting)
                            {
                                <span>Starting…</span>
                            }
                            else if (needsAttention)
                            {
                                <span>Parent attention needed</span>
                            }
                            else if (preparing)
                            {
                                <span>Getting originals ready…</span>
                            }
                            else
                            {
                                <span>Play slideshow</span>
                            }
                        </span>
                    </span>
                </button>
                @if (collection.Manual)
                {
                    <a class="slideshow-library-review"
                       href="@($"/manual-collections/{collection.Id}")">
                        Review photos
                    </a>
                }
            </article>
        }
    </section>
}

<details class="slideshow-library-settings">
    <summary>Playback preferences</summary>
    <div class="slideshow-library-settings-body">
        <SlideshowSettingsEditor Settings="@Settings"
                                 SettingsChanged="ChangeSettingsAsync" />
        <p class="slideshow-library-note">
            These browser-local preferences are reused whenever a slideshow starts.
        </p>
    </div>
</details>

@if (Collections.Count > 0)
{
    <details class="slideshow-library-settings">
        <summary>Parent preparation tools</summary>
        <div class="slideshow-library-settings-body">
            <p class="slideshow-library-note">
                Optional: prepare best-quality originals ahead of time. Ordinary playback follows the saved Prepare originals preference automatically.
            </p>

            @foreach (SlideshowLibraryEntry collection in Collections)
            {
                SlideshowOriginalPreparationResponse? preparation = PreparationFor(collection.Id);
                bool preparing = preparation?.State == "preparing";
                bool needsAttention = SlideshowPreparationExperience.NeedsParentAttention(preparation);
                bool starting = IsStarting(collection.Id);

                <div class="slideshow-library-preparation" role="status">
                    <strong>@collection.Name</strong>

                    @if (preparation?.State == "ready")
                    {
                        <span>@preparation.Ready / @preparation.Total originals are prepared.</span>
                    }
                    else if (preparation is { State: "preparing" })
                    {
                        <span>@preparation.Ready / @preparation.Total ready</span>
                        @if (preparation.NoProgressWarning)
                        {
                            <div class="slideshow-library-warning" role="alert">
                                <strong>OneDrive has not made progress</strong>
                                <span>No progress for @preparation.NoProgressSeconds seconds.</span>
                            </div>
                        }
                    }
                    else if (needsAttention)
                    {
                        <span>@preparation!.Message</span>
                        @if (preparation.RequiredAdditionalBytes > 0)
                        {
                            <span>Required additional bytes: @preparation.RequiredAdditionalBytes</span>
                            <span>Available managed capacity: @preparation.AvailableManagedCapacity</span>
                        }
                    }
                    else
                    {
                        <span>No standalone preparation is running.</span>
                    }

                    <div class="slideshow-library-actions">
                        @if (preparation?.NoProgressWarning == true && preparation.CanRetry)
                        {
                            <button type="button"
                                    class="button secondary"
                                    @onclick="() => RetryPreparationAsync(collection.Id)">
                                Retry preparation
                            </button>
                        }

                        @if (preparing || needsAttention)
                        {
                            <button type="button"
                                    class="button secondary"
                                    @onclick="() => CancelPreparationAsync(collection.Id)">
                                Cancel preparation
                            </button>
                        }
                        else if (!starting)
                        {
                            <button type="button"
                                    class="button secondary"
                                    @onclick="() => PrepareOriginalsAsync(collection)">
                                @(preparation?.State == "ready" ? "Prepare again" : "Prepare originals")
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </details>
}

<section class="slideshow-library-boundary">
    <strong>Viewing only</strong>
    <p>Slideshow playback does not edit Smart Collections or photo metadata. Manual slideshow membership is edited only through its Review photos view or a photo's Manual slideshow control.</p>
</section>
