@page "/faces/{Id}"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Face details · Photo Identity</PageTitle>

@if (Loading)
{
    <section class="empty-state">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading face details…</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(Error))
{
    <section class="empty-state">
        <h1>Face details unavailable</h1>
        <p>@Error</p>
        <a class="button primary" href="@SafeReturnUrl">Return to queue</a>
    </section>
}
else if (Details is not null)
{
    <a class="back-link" href="@SafeReturnUrl">← Back to review queue</a>

    @if (Details.Navigation is ReviewFaceNavigationResponse queue)
    {
        <nav class="review-navigation" aria-label="Review queue navigation">
            @if (queue.PreviousFaceId is string previousFaceId)
            {
                <a class="button secondary" href="@BuildFaceUrl(previousFaceId)">← Previous</a>
            }
            else
            {
                <span class="button secondary disabled" aria-disabled="true">← Previous</span>
            }

            <span class="review-position">@queue.Position of @queue.Total</span>

            @if (queue.NextFaceId is string nextFaceId)
            {
                <a class="button secondary" href="@BuildFaceUrl(nextFaceId)">Next →</a>
            }
            else
            {
                <span class="button secondary disabled" aria-disabled="true">Next →</span>
            }
        </nav>
    }

    <section class="details-header">
        <div>
            <p class="eyebrow">Photo details</p>
            <h1>@Details.Face.PhotoName · face @(Details.Face.FaceOrdinal + 1)</h1>
            <p>The browser receives a face image endpoint and privacy-limited metadata, never the source root or crop storage path.</p>
        </div>
        <span class="state-badge large">@StateLabel</span>
    </section>

    <div class="details-grid">
        <section class="details-image-panel">
            <img class="details-image" src="@Details.Face.ImageUrl" alt="Detected face from @Details.Face.PhotoName" />
        </section>

        <section class="metadata-card">
            <h2>Metadata</h2>
            <dl>
                <div><dt>Review state</dt><dd>@StateLabel</dd></div>
                <div><dt>Assigned person</dt><dd>@(Details.Face.Person?.DisplayName ?? "—")</dd></div>
                <div><dt>Detector confidence</dt><dd>@ConfidenceLabel</dd></div>
                <div><dt>Media type</dt><dd>@Details.MediaType</dd></div>
                <div><dt>Photo dimensions</dt><dd>@DimensionLabel</dd></div>
                <div><dt>Revision fingerprint</dt><dd><code>@Details.RevisionHashPrefix…</code></dd></div>
                <div><dt>Occurrence ID</dt><dd><code>@Details.Face.Id</code></dd></div>
            </dl>
        </section>
    </div>

    @if (!string.IsNullOrWhiteSpace(ActionError))
    {
        <div class="notice error review-notice" role="alert">@ActionError</div>
    }
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="notice success review-notice" role="status">@Message</div>
    }

    <section class="audit-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Advisory model output</p>
                <h2>Ranked identity suggestions</h2>
                <p class="suggestion-guidance">Scores never create a label. Accepting a suggestion is an explicit human assignment. Rejected face-person pairs remain excluded when suggestions are regenerated.</p>
            </div>
            <span>@Suggestions.Count suggestion@(Suggestions.Count == 1 ? "" : "s")</span>
        </div>

        @if (Suggestions.Count == 0)
        {
            <div class="empty-state compact"><p>No ranked suggestions are available for this face.</p></div>
        }
        else
        {
            <ol class="timeline">
                @foreach (ReviewIdentitySuggestionResponse suggestion in Suggestions)
                {
                    <li>
                        <div class="timeline-marker" aria-hidden="true"></div>
                        <div class="suggestion-content">
                            <div class="timeline-title">
                                <strong>Rank @suggestion.Rank · @suggestion.Person.DisplayName</strong>
                                <span class="state-badge">@SuggestionStatusLabel(suggestion.Status)</span>
                            </div>
                            <p>Score @suggestion.Score.ToString("F4") · Margin @MarginLabel(suggestion.ScoreMargin)</p>
                            <p>Model <code>@suggestion.ModelId</code></p>
                            <p>Exact revision <code class="model-revision">@suggestion.ModelHash</code></p>
                            <p>Generated @suggestion.GeneratedAtUtc.ToLocalTime().ToString("g")</p>

                            @if (suggestion.LatestAction is not null)
                            {
                                <div class="suggestion-decision">
                                    <strong>@SuggestionActionLabel(suggestion.LatestAction)</strong>
                                    <p>@suggestion.LatestAction.Actor · @suggestion.LatestAction.CreatedAtUtc.ToLocalTime().ToString("g")</p>
                                    @if (!string.IsNullOrWhiteSpace(suggestion.LatestAction.Note))
                                    {
                                        <blockquote>@suggestion.LatestAction.Note</blockquote>
                                    }
                                </div>
                            }

                            @if (string.Equals(suggestion.Status, "pending", StringComparison.Ordinal))
                            {
                                <div class="suggestion-actions">
                                    @if (ConfirmingRejectSuggestionId == suggestion.Id)
                                    {
                                        <button class="button danger"
                                                disabled="@(ActingSuggestionId is not null)"
                                                @onclick="() => RejectSuggestionAsync(suggestion.Id)">
                                            Confirm rejection
                                        </button>
                                        <button class="button secondary"
                                                disabled="@(ActingSuggestionId is not null)"
                                                @onclick="CancelRejectConfirmation">
                                            Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="button primary"
                                                disabled="@(!CanReviewSuggestions)"
                                                @onclick="() => AcceptSuggestionAsync(suggestion.Id, suggestion.Person.DisplayName)">
                                            Accept as @suggestion.Person.DisplayName
                                        </button>
                                        <button class="button danger"
                                                disabled="@(!CanReviewSuggestions)"
                                                @onclick="() => ConfirmReject(suggestion.Id)">
                                            Reject match
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </section>

    <section class="audit-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Audit trail</p>
                <h2>Review history</h2>
            </div>
            <span>@Details.Actions.Count action@(Details.Actions.Count == 1 ? "" : "s")</span>
        </div>

        @if (Details.Actions.Count == 0)
        {
            <div class="empty-state compact"><p>No review actions have been recorded.</p></div>
        }
        else
        {
            <ol class="timeline">
                @foreach (ReviewActionResponse action in Details.Actions)
                {
                    <li class="@(action.Reversed ? "reversed" : "")">
                        <div class="timeline-marker" aria-hidden="true"></div>
                        <div>
                            <div class="timeline-title">
                                <strong>@ActionLabel(action)</strong>
                                @if (action.Reversed)
                                {
                                    <span class="state-badge">Reversed</span>
                                }
                            </div>
                            <p>@action.Actor · @action.CreatedAtUtc.ToLocalTime().ToString("g")</p>
                            @if (!string.IsNullOrWhiteSpace(action.Note))
                            {
                                <blockquote>@action.Note</blockquote>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </section>
}

@code {
    private const string Actor = "local-reviewer";
    private const string DefaultSort = "created-desc";

    [Parameter]
    public string Id { get; set; } = "";

    [Parameter, SupplyParameterFromQuery(Name = "state")]
    public string QueueState { get; set; } = "all";

    [Parameter, SupplyParameterFromQuery(Name = "processingRunId")]
    public string? ProcessingRunId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "modelId")]
    public string? ModelId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "modelHash")]
    public string? ModelHash { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "sort")]
    public string Sort { get; set; } = DefaultSort;

    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private ReviewFaceDetailsResponse? Details { get; set; }
    private IReadOnlyList<ReviewIdentitySuggestionResponse> Suggestions { get; set; } = [];
    private bool Loading { get; set; } = true;
    private long? ActingSuggestionId { get; set; }
    private long? ConfirmingRejectSuggestionId { get; set; }
    private string? Error { get; set; }
    private string? ActionError { get; set; }
    private string? Message { get; set; }

    private bool CanReviewSuggestions =>
        ActingSuggestionId is null && string.Equals(Details?.Face.State, "unreviewed", StringComparison.Ordinal);

    private string SafeReturnUrl => IsSafeRelativeUrl(ReturnUrl) ? ReturnUrl! : "/";

    private string StateLabel => Details?.Face.State switch
    {
        "assigned" => "Assigned",
        "rejected" => "Rejected",
        _ => "Needs review",
    };

    private string ConfidenceLabel => Details?.Face.Confidence is double confidence
        ? confidence.ToString("P1")
        : "—";

    private string DimensionLabel => Details?.PhotoWidth is int width && Details.PhotoHeight is int height
        ? $"{width} × {height}"
        : "—";

    protected override async Task OnParametersSetAsync()
    {
        Loading = true;
        Error = null;
        ActionError = null;
        Message = null;
        ConfirmingRejectSuggestionId = null;
        Suggestions = [];
        try
        {
            await RefreshAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        string escapedId = Uri.EscapeDataString(Id);
        Details = await Http.GetFromJsonAsync<ReviewFaceDetailsResponse>(
            $"api/review/faces/{escapedId}?{BuildScopeQuery()}");
        if (Details is null)
        {
            throw new InvalidOperationException("The face occurrence was not found.");
        }

        Suggestions = await Http.GetFromJsonAsync<ReviewIdentitySuggestionResponse[]>(
            $"api/review/faces/{escapedId}/suggestions") ?? [];
    }

    private async Task AcceptSuggestionAsync(long suggestionId, string displayName)
    {
        await ApplySuggestionDecisionAsync(
            suggestionId,
            "accept",
            $"Assigned this face to {displayName}.");
    }

    private void ConfirmReject(long suggestionId)
    {
        ActionError = null;
        Message = null;
        ConfirmingRejectSuggestionId = suggestionId;
    }

    private void CancelRejectConfirmation()
    {
        ConfirmingRejectSuggestionId = null;
    }

    private async Task RejectSuggestionAsync(long suggestionId)
    {
        await ApplySuggestionDecisionAsync(
            suggestionId,
            "reject",
            "Rejected face-person pair saved and excluded from future matcher regeneration.");
    }

    private async Task ApplySuggestionDecisionAsync(
        long suggestionId,
        string decision,
        string successMessage)
    {
        ActingSuggestionId = suggestionId;
        ActionError = null;
        Message = null;
        string? nextFaceId = Details?.Navigation?.NextFaceId;
        try
        {
            string escapedId = Uri.EscapeDataString(Id);
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/review/faces/{escapedId}/suggestions/{suggestionId}/{decision}",
                new ReviewSuggestionActionRequest(Actor));
            await RequireSuccessAsync(response);

            if (string.Equals(decision, "accept", StringComparison.Ordinal))
            {
                string destination = nextFaceId is null ? SafeReturnUrl : BuildFaceUrl(nextFaceId);
                Navigation.NavigateTo(destination, replace: true);
                return;
            }

            await RefreshAsync();
            Message = successMessage;
        }
        catch (Exception exception)
        {
            ActionError = exception.Message;
        }
        finally
        {
            ActingSuggestionId = null;
            ConfirmingRejectSuggestionId = null;
        }
    }

    private string BuildFaceUrl(string faceId) =>
        $"/faces/{Uri.EscapeDataString(faceId)}?{BuildScopeQuery()}&returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    private string BuildScopeQuery()
    {
        List<string> query =
        [
            $"state={Uri.EscapeDataString(QueueState)}",
            $"sort={Uri.EscapeDataString(Sort)}",
        ];
        if (!string.IsNullOrWhiteSpace(ProcessingRunId))
        {
            query.Add($"processingRunId={Uri.EscapeDataString(ProcessingRunId)}");
        }
        if (!string.IsNullOrWhiteSpace(ModelId))
        {
            query.Add($"modelId={Uri.EscapeDataString(ModelId)}");
        }
        if (!string.IsNullOrWhiteSpace(ModelHash))
        {
            query.Add($"modelHash={Uri.EscapeDataString(ModelHash)}");
        }
        return string.Join("&", query);
    }

    private static bool IsSafeRelativeUrl(string? value) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.StartsWith("/", StringComparison.Ordinal) &&
        !value.StartsWith("//", StringComparison.Ordinal);

    private static async Task RequireSuccessAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return;
        }

        string detail = await response.Content.ReadAsStringAsync();
        throw new InvalidOperationException(
            string.IsNullOrWhiteSpace(detail)
                ? $"The suggestion review failed with status {(int)response.StatusCode}."
                : detail);
    }

    private static string ActionLabel(ReviewActionResponse action) => action.Kind switch
    {
        "assign" when action.Person is not null => $"Assigned to {action.Person.DisplayName}",
        "reject" => "Rejected face",
        "undo" when action.ReversesActionId is long id => $"Undid action #{id}",
        _ => action.Kind,
    };

    private static string SuggestionActionLabel(ReviewSuggestionActionResponse action) => action.Kind switch
    {
        "accept" => "Accepted suggestion",
        "reject" => "Rejected match",
        _ => action.Kind,
    };

    private static string SuggestionStatusLabel(string status) => status switch
    {
        "pending" => "Pending review",
        "rejected" => "Rejected",
        "accepted" => "Accepted",
        _ => status,
    };

    private static string MarginLabel(double? margin) => margin is double value
        ? value.ToString("F4")
        : "—";
}