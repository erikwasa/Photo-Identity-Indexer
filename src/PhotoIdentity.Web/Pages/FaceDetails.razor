@page "/faces/{Id}"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Face details · Photo Identity</PageTitle>

@if (Loading)
{
    <section class="empty-state">
        <div class="spinner" aria-hidden="true"></div>
        <p>Loading face details…</p>
    </section>
}
else if (!string.IsNullOrWhiteSpace(Error))
{
    <section class="empty-state">
        <h1>Face details unavailable</h1>
        <p>@Error</p>
        <a class="button primary" href="@SafeReturnUrl">Return to queue</a>
    </section>
}
else if (Details is not null)
{
    <a class="back-link" href="@SafeReturnUrl">← Back to review queue</a>

    @if (Details.Navigation is ReviewFaceNavigationResponse queue)
    {
        <nav class="review-navigation" aria-label="Review queue navigation">
            @if (queue.PreviousFaceId is string previousFaceId)
            {
                <a class="button secondary" href="@BuildFaceUrl(previousFaceId)">← Previous</a>
            }
            else
            {
                <span class="button secondary disabled" aria-disabled="true">← Previous</span>
            }

            <span class="review-position">@queue.Position of @queue.Total</span>

            @if (queue.NextFaceId is string nextFaceId)
            {
                <a class="button secondary" href="@BuildFaceUrl(nextFaceId)">Next →</a>
            }
            else
            {
                <span class="button secondary disabled" aria-disabled="true">Next →</span>
            }
        </nav>
    }

    <section class="details-header">
        <div>
            <p class="eyebrow">Photo details</p>
            <h1>Face details</h1>
            <p>Assign a named person, mark a real face as an unknown person, or reject a false detection. Browser responses remain privacy-limited.</p>
        </div>
        <span class="state-badge large">@StateLabel</span>
    </section>

    <div class="details-grid">
        <section class="details-image-panel">
            <img class="details-image" src="@Details.Face.ImageUrl" alt="Detected face" />
        </section>

        <section class="metadata-card">
            <h2>Metadata</h2>
            <dl>
                <div><dt>Review state</dt><dd>@StateLabel</dd></div>
                <div><dt>Assigned person</dt><dd>@(Details.Face.Person?.DisplayName ?? "—")</dd></div>
                <div><dt>Detector confidence</dt><dd>@ConfidenceLabel</dd></div>
                <div><dt>Photo</dt><dd class="breakable">@Details.Face.PhotoName</dd></div>
                <div><dt>Media type</dt><dd>@Details.MediaType</dd></div>
                <div><dt>Photo dimensions</dt><dd>@DimensionLabel</dd></div>
                <div><dt>Revision fingerprint</dt><dd><code>@Details.RevisionHashPrefix…</code></dd></div>
                <div><dt>Occurrence ID</dt><dd><code>@Details.Face.Id</code></dd></div>
            </dl>

            @if (UsesSuggestionNavigation)
            {
                <details class="model-provenance-details">
                    <summary>Active model: @NormalizedModelId · @HashPrefix(NormalizedModelHash)</summary>
                    <code>@NormalizedModelHash</code>
                </details>
            }
        </section>
    </div>

    @if (!string.IsNullOrWhiteSpace(ActionError))
    {
        <div class="notice error review-notice" role="alert">@ActionError</div>
    }
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="notice success review-notice" role="status">@Message</div>
    }

    <section class="audit-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Face decision</p>
                <h2>Unknown person or false detection</h2>
                <p class="suggestion-guidance">Unknown means this is a real face but the identity is not known. False detection means the detector did not find a real face. Both decisions are reversible and remain in the audit history.</p>
            </div>
        </div>

        <div class="card-actions">
            <button class="button secondary"
                    disabled="@(ActionBusy || Details.Face.State == "unknown")"
                    @onclick="MarkUnknownAsync">
                Unknown person
            </button>
            <button class="button danger"
                    disabled="@(ActionBusy || Details.Face.State == "rejected")"
                    @onclick="RejectFaceAsync">
                False detection
            </button>
            <button class="button secondary"
                    disabled="@(ActionBusy || Details.Face.State == "unreviewed")"
                    @onclick="UndoFaceDecisionAsync">
                Undo latest face decision
            </button>
        </div>
    </section>

    <section class="audit-section identity-assignment-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Explicit correction</p>
                <h2>Assign any person</h2>
                <p class="suggestion-guidance">Use this when the correct person is absent from the ranked suggestions or when an Unknown decision can now be resolved. Favorites stay at the top and can be changed here without affecting identity evidence. A successful queue assignment advances to the next face.</p>
            </div>
        </div>

        <div class="identity-assignment-grid">
            <div>
                <label class="field-label" for="details-person">Named person</label>
                <select id="details-person"
                        @bind="SelectedPersonId"
                        disabled="@(ActionBusy || People.Count == 0)">
                    <option value="">Choose a person</option>
                    @foreach (ReviewPersonResponse person in People)
                    {
                        <option value="@person.Id">@PersonLabel(person)</option>
                    }
                </select>
                @if (SelectedPerson is ReviewPersonResponse selectedPerson)
                {
                    <button class="button secondary full-width"
                            disabled="@ActionBusy"
                            aria-pressed="@selectedPerson.IsFavorite"
                            @onclick="ToggleSelectedFavoriteAsync">
                        @(selectedPerson.IsFavorite ? "Remove selected favorite" : "Add selected person to favorites")
                    </button>
                }
                <button class="button primary full-width"
                        disabled="@(ActionBusy || string.IsNullOrWhiteSpace(SelectedPersonId))"
                        @onclick="AssignSelectedPersonAsync">
                    Assign selected person
                </button>
            </div>

            <form class="details-person-creator" @onsubmit="CreateAndAssignPersonAsync" @onsubmit:preventDefault>
                <label class="field-label" for="details-new-person">Create and assign person</label>
                <input id="details-new-person"
                       placeholder="Display name"
                       maxlength="200"
                       autocomplete="off"
                       @bind="NewPersonName"
                       @bind:event="oninput" />
                <button type="submit"
                        class="button secondary full-width"
                        disabled="@(ActionBusy || string.IsNullOrWhiteSpace(NewPersonName))">
                    Create and assign
                </button>
            </form>
        </div>
    </section>

    <section class="audit-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Advisory model output</p>
                <h2>Ranked identity suggestions</h2>
                <p class="suggestion-guidance">Scores never create a label. Accepting or rejecting a person match requires the face itself to be unreviewed; undo an Unknown or false-detection decision first if you want to review suggestions.</p>
            </div>
            <span>@Suggestions.Count suggestion@(Suggestions.Count == 1 ? "" : "s")</span>
        </div>

        @if (Suggestions.Count == 0)
        {
            <div class="empty-state compact"><p>No ranked suggestions are available for this face.</p></div>
        }
        else
        {
            <ol class="timeline">
                @foreach (ReviewIdentitySuggestionResponse suggestion in Suggestions)
                {
                    <li>
                        <div class="timeline-marker" aria-hidden="true"></div>
                        <div class="suggestion-content">
                            <div class="timeline-title">
                                <strong>Rank @suggestion.Rank · @suggestion.Person.DisplayName</strong>
                                <span class="state-badge">@SuggestionStatusLabel(suggestion.Status)</span>
                            </div>
                            <p>Score @suggestion.Score.ToString("F4") · Margin @MarginLabel(suggestion.ScoreMargin)</p>
                            <details class="model-provenance-details compact-provenance">
                                <summary>@suggestion.ModelId · @HashPrefix(suggestion.ModelHash)</summary>
                                <code>@suggestion.ModelHash</code>
                            </details>
                            <p>Generated @suggestion.GeneratedAtUtc.ToLocalTime().ToString("g")</p>

                            @if (suggestion.LatestAction is not null)
                            {
                                <div class="suggestion-decision">
                                    <strong>@SuggestionActionLabel(suggestion.LatestAction)</strong>
                                    <p>@suggestion.LatestAction.Actor · @suggestion.LatestAction.CreatedAtUtc.ToLocalTime().ToString("g")</p>
                                    @if (!string.IsNullOrWhiteSpace(suggestion.LatestAction.Note))
                                    {
                                        <blockquote>@suggestion.LatestAction.Note</blockquote>
                                    }
                                </div>
                            }

                            @if (string.Equals(suggestion.Status, "pending", StringComparison.Ordinal))
                            {
                                <div class="suggestion-actions">
                                    @if (ConfirmingRejectSuggestionId == suggestion.Id)
                                    {
                                        <button class="button danger"
                                                disabled="@ActionBusy"
                                                @onclick="() => RejectSuggestionAsync(suggestion.Id)">
                                            Confirm rejection
                                        </button>
                                        <button class="button secondary"
                                                disabled="@ActionBusy"
                                                @onclick="CancelRejectConfirmation">
                                            Cancel
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="button primary"
                                                disabled="@(!CanReviewSuggestions)"
                                                @onclick="() => AcceptSuggestionAsync(suggestion.Id, suggestion.Person.DisplayName)">
                                            Accept as @suggestion.Person.DisplayName
                                        </button>
                                        <button class="button danger"
                                                disabled="@(!CanReviewSuggestions)"
                                                @onclick="() => ConfirmReject(suggestion.Id)">
                                            Reject match
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </section>

    <section class="audit-section">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Audit trail</p>
                <h2>Review history</h2>
            </div>
            <span>@Details.Actions.Count action@(Details.Actions.Count == 1 ? "" : "s")</span>
        </div>

        @if (Details.Actions.Count == 0)
        {
            <div class="empty-state compact"><p>No review actions have been recorded.</p></div>
        }
        else
        {
            <ol class="timeline">
                @foreach (ReviewActionResponse action in Details.Actions)
                {
                    <li class="@(action.Reversed ? "reversed" : "")">
                        <div class="timeline-marker" aria-hidden="true"></div>
                        <div>
                            <div class="timeline-title">
                                <strong>@ActionLabel(action)</strong>
                                @if (action.Reversed)
                                {
                                    <span class="state-badge">Reversed</span>
                                }
                            </div>
                            <p>@action.Actor · @action.CreatedAtUtc.ToLocalTime().ToString("g")</p>
                            @if (!string.IsNullOrWhiteSpace(action.Note))
                            {
                                <blockquote>@action.Note</blockquote>
                            }
                        </div>
                    </li>
                }
            </ol>
        }
    </section>
}

@code {
    private const string Actor = "local-reviewer";
    private const string DefaultSort = "created-desc";

    [Parameter]
    public string Id { get; set; } = "";

    [Parameter, SupplyParameterFromQuery(Name = "state")]
    public string? QueueState { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "processingRunId")]
    public string? ProcessingRunId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "modelId")]
    public string? ModelId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "modelHash")]
    public string? ModelHash { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "sort")]
    public string? Sort { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "suggestionQueue")]
    public bool SuggestionQueue { get; set; }

    private ReviewFaceDetailsResponse? Details { get; set; }
    private IReadOnlyList<ReviewIdentitySuggestionResponse> Suggestions { get; set; } = [];
    private IReadOnlyList<ReviewPersonResponse> People { get; set; } = [];
    private string SelectedPersonId { get; set; } = "";
    private string NewPersonName { get; set; } = "";
    private bool Loading { get; set; } = true;
    private bool ActionBusy { get; set; }
    private long? ConfirmingRejectSuggestionId { get; set; }
    private string? Error { get; set; }
    private string? ActionError { get; set; }
    private string? Message { get; set; }

    private string NormalizedQueueState => QueueState is "unreviewed" or "assigned" or "unknown" or "rejected" or "all"
        ? QueueState
        : "all";
    private string NormalizedSort => string.IsNullOrWhiteSpace(Sort) ? DefaultSort : Sort.Trim();
    private string NormalizedProcessingRunId => ProcessingRunId?.Trim() ?? "";
    private string NormalizedModelId => ModelId?.Trim() ?? "";
    private string NormalizedModelHash => ModelHash?.Trim() ?? "";
    private bool UsesSuggestionNavigation =>
        SuggestionQueue &&
        !string.IsNullOrWhiteSpace(NormalizedModelId) &&
        !string.IsNullOrWhiteSpace(NormalizedModelHash);
    private bool CanReviewSuggestions =>
        !ActionBusy && string.Equals(Details?.Face.State, "unreviewed", StringComparison.Ordinal);
    private string SafeReturnUrl => IsSafeRelativeUrl(ReturnUrl) ? ReturnUrl! : "/";
    private ReviewPersonResponse? SelectedPerson =>
        People.FirstOrDefault(person => person.Id == SelectedPersonId);

    private string StateLabel => Details?.Face.State switch
    {
        "assigned" => "Assigned",
        "unknown" => "Unknown person",
        "rejected" => "False detection",
        _ => "Needs review",
    };

    private string ConfidenceLabel => Details?.Face.Confidence is double confidence
        ? confidence.ToString("P1")
        : "—";

    private string DimensionLabel => Details?.PhotoWidth is int width && Details.PhotoHeight is int height
        ? $"{width} × {height}"
        : "—";

    protected override async Task OnParametersSetAsync()
    {
        Loading = true;
        Error = null;
        ActionError = null;
        Message = null;
        ConfirmingRejectSuggestionId = null;
        Suggestions = [];
        try
        {
            await RefreshAsync();
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task RefreshAsync()
    {
        string escapedId = Uri.EscapeDataString(Id ?? string.Empty);
        string detailsEndpoint = UsesSuggestionNavigation
            ? $"api/review/suggestion-faces/{escapedId}?{BuildScopeQuery()}"
            : $"api/review/faces/{escapedId}?{BuildScopeQuery()}";
        Details = await Http.GetFromJsonAsync<ReviewFaceDetailsResponse>(detailsEndpoint);
        if (Details is null)
        {
            throw new InvalidOperationException("The face occurrence was not found.");
        }

        Suggestions = await Http.GetFromJsonAsync<ReviewIdentitySuggestionResponse[]>(
            $"api/review/faces/{escapedId}/suggestions") ?? [];
        People = await Http.GetFromJsonAsync<ReviewPersonResponse[]>("api/review/people") ?? [];

        if (Details.Face.Person is not null)
        {
            SelectedPersonId = Details.Face.Person.Id;
        }
        else if (People.All(person => person.Id != SelectedPersonId))
        {
            SelectedPersonId = "";
        }
    }

    private async Task ToggleSelectedFavoriteAsync()
    {
        if (SelectedPerson is not ReviewPersonResponse person)
        {
            return;
        }

        bool favorite = !person.IsFavorite;
        ActionBusy = true;
        ActionError = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PutAsJsonAsync(
                $"api/review/people/{Uri.EscapeDataString(person.Id)}/favorite",
                new SetPersonFavoriteRequest(favorite));
            await RequireSuccessAsync(response);
            People = await Http.GetFromJsonAsync<ReviewPersonResponse[]>("api/review/people") ?? [];
            Message = favorite
                ? $"Added {person.DisplayName} to favorites."
                : $"Removed {person.DisplayName} from favorites.";
        }
        catch (Exception exception)
        {
            ActionError = exception.Message;
        }
        finally
        {
            ActionBusy = false;
        }
    }

    private async Task MarkUnknownAsync() =>
        await RecordFaceDecisionAsync(
            "unknown",
            "Face marked as an unknown person.");

    private async Task RejectFaceAsync() =>
        await RecordFaceDecisionAsync(
            "reject",
            "False detection saved.");

    private async Task UndoFaceDecisionAsync() =>
        await RecordFaceDecisionAsync(
            "undo",
            "Latest face decision undone.");

    private async Task RecordFaceDecisionAsync(string action, string successMessage)
    {
        bool shouldAdvance = Details?.Navigation is not null;
        string? nextFaceId = Details?.Navigation?.NextFaceId;
        ActionBusy = true;
        ActionError = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/review/faces/{Uri.EscapeDataString(Id)}/{action}",
                new ReviewFaceActionRequest(Actor));
            await RequireSuccessAsync(response);

            if (shouldAdvance)
            {
                NavigateAfterQueueMutation(nextFaceId);
                return;
            }

            await RefreshAsync();
            Message = successMessage;
        }
        catch (Exception exception)
        {
            ActionError = exception.Message;
        }
        finally
        {
            ActionBusy = false;
        }
    }

    private async Task AssignSelectedPersonAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedPersonId))
        {
            return;
        }

        await AssignPersonAsync(SelectedPersonId, "Face assignment saved.");
    }

    private async Task AssignPersonAsync(string personId, string successMessage)
    {
        bool shouldAdvance = Details?.Navigation is not null;
        string? nextFaceId = Details?.Navigation?.NextFaceId;
        ActionBusy = true;
        ActionError = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/review/faces/{Uri.EscapeDataString(Id)}/assign",
                new AssignFaceRequest(personId, Actor));
            await RequireSuccessAsync(response);

            if (shouldAdvance)
            {
                NavigateAfterQueueMutation(nextFaceId);
                return;
            }

            await RefreshAsync();
            Message = successMessage;
        }
        catch (Exception exception)
        {
            ActionError = exception.Message;
        }
        finally
        {
            ActionBusy = false;
        }
    }

    private async Task CreateAndAssignPersonAsync()
    {
        if (ActionBusy || string.IsNullOrWhiteSpace(NewPersonName))
        {
            return;
        }

        bool shouldAdvance = Details?.Navigation is not null;
        string? nextFaceId = Details?.Navigation?.NextFaceId;
        ActionBusy = true;
        ActionError = null;
        Message = null;
        string displayName = NewPersonName.Trim();
        try
        {
            using HttpResponseMessage createResponse = await Http.PostAsJsonAsync(
                "api/review/people",
                new CreatePersonRequest(displayName));
            await RequireSuccessAsync(createResponse);
            ReviewPersonResponse created = await createResponse.Content.ReadFromJsonAsync<ReviewPersonResponse>()
                ?? throw new InvalidOperationException("The person creation response was empty.");

            People = People
                .Append(created)
                .OrderByDescending(person => person.IsFavorite)
                .ThenBy(person => person.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(person => person.Id, StringComparer.Ordinal)
                .ToArray();
            SelectedPersonId = created.Id;
            NewPersonName = "";
            Message = $"Created {created.DisplayName}";

            using HttpResponseMessage assignResponse = await Http.PostAsJsonAsync(
                $"api/review/faces/{Uri.EscapeDataString(Id)}/assign",
                new AssignFaceRequest(created.Id, Actor));
            await RequireSuccessAsync(assignResponse);

            if (shouldAdvance)
            {
                NavigateAfterQueueMutation(nextFaceId);
                return;
            }

            await RefreshAsync();
            Message = $"Created {created.DisplayName}";
        }
        catch (Exception exception)
        {
            ActionError = exception.Message;
        }
        finally
        {
            ActionBusy = false;
        }
    }

    private async Task AcceptSuggestionAsync(long suggestionId, string displayName)
    {
        bool shouldAdvance = Details?.Navigation is not null;
        string? nextFaceId = Details?.Navigation?.NextFaceId;
        ActionBusy = true;
        ActionError = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/review/faces/{Uri.EscapeDataString(Id)}/suggestions/{suggestionId}/accept",
                new ReviewSuggestionActionRequest(Actor));
            await RequireSuccessAsync(response);

            if (shouldAdvance)
            {
                NavigateAfterQueueMutation(nextFaceId);
                return;
            }

            await RefreshAsync();
            Message = $"Assigned this face to {displayName}.";
        }
        catch (Exception exception)
        {
            ActionError = exception.Message;
        }
        finally
        {
            ActionBusy = false;
            ConfirmingRejectSuggestionId = null;
        }
    }

    private void NavigateAfterQueueMutation(string? nextFaceId)
    {
        Navigation.NavigateTo(
            nextFaceId is null ? SafeReturnUrl : BuildFaceUrl(nextFaceId),
            replace: true);
    }

    private void ConfirmReject(long suggestionId)
    {
        ActionError = null;
        Message = null;
        ConfirmingRejectSuggestionId = suggestionId;
    }

    private void CancelRejectConfirmation()
    {
        ConfirmingRejectSuggestionId = null;
    }

    private async Task RejectSuggestionAsync(long suggestionId)
    {
        ActionBusy = true;
        ActionError = null;
        Message = null;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"api/review/faces/{Uri.EscapeDataString(Id)}/suggestions/{suggestionId}/reject",
                new ReviewSuggestionActionRequest(Actor));
            await RequireSuccessAsync(response);
            await RefreshAsync();
            Message = "Rejected face-person pair saved and excluded from future matcher regeneration.";
        }
        catch (Exception exception)
        {
            ActionError = exception.Message;
        }
        finally
        {
            ActionBusy = false;
            ConfirmingRejectSuggestionId = null;
        }
    }

    private string BuildFaceUrl(string faceId)
    {
        List<string> query = BuildScopeParts();
        if (UsesSuggestionNavigation)
        {
            query.Add("suggestionQueue=true");
        }
        query.Add($"returnUrl={Uri.EscapeDataString(SafeReturnUrl)}");
        return $"/faces/{Uri.EscapeDataString(faceId)}?{string.Join("&", query)}";
    }

    private string BuildScopeQuery() => string.Join("&", BuildScopeParts());

    private List<string> BuildScopeParts()
    {
        List<string> query =
        [
            $"state={Uri.EscapeDataString(NormalizedQueueState)}",
            $"sort={Uri.EscapeDataString(NormalizedSort)}",
        ];
        if (!string.IsNullOrWhiteSpace(NormalizedProcessingRunId))
        {
            query.Add($"processingRunId={Uri.EscapeDataString(NormalizedProcessingRunId)}");
        }
        if (!string.IsNullOrWhiteSpace(NormalizedModelId) && !string.IsNullOrWhiteSpace(NormalizedModelHash))
        {
            query.Add($"modelId={Uri.EscapeDataString(NormalizedModelId)}");
            query.Add($"modelHash={Uri.EscapeDataString(NormalizedModelHash)}");
        }
        return query;
    }

    private static bool IsSafeRelativeUrl(string? value) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.StartsWith("/", StringComparison.Ordinal) &&
        !value.StartsWith("//", StringComparison.Ordinal);

    private static string HashPrefix(string hash) =>
        string.IsNullOrEmpty(hash) ? "—" : hash[..Math.Min(12, hash.Length)];

    private static string PersonLabel(ReviewPersonResponse person) =>
        person.IsFavorite ? $"★ {person.DisplayName}" : person.DisplayName;

    private static async Task RequireSuccessAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            return;
        }

        string detail = await response.Content.ReadAsStringAsync();
        throw new InvalidOperationException(
            string.IsNullOrWhiteSpace(detail)
                ? $"The review action failed with status {(int)response.StatusCode}."
                : detail);
    }

    private static string ActionLabel(ReviewActionResponse action) => action.Kind switch
    {
        "assign" when action.Person is not null => $"Assigned to {action.Person.DisplayName}",
        "unknown" => "Marked as unknown person",
        "reject" => "Marked as false detection",
        "undo" when action.ReversesActionId is long id => $"Undid action #{id}",
        _ => action.Kind,
    };

    private static string SuggestionActionLabel(ReviewSuggestionActionResponse action) => action.Kind switch
    {
        "accept" => "Accepted suggestion",
        "reject" => "Rejected match",
        _ => action.Kind,
    };

    private static string SuggestionStatusLabel(string status) => status switch
    {
        "pending" => "Pending review",
        "rejected" => "Rejected",
        "accepted" => "Accepted",
        _ => status,
    };

    private static string MarginLabel(double? margin) => margin is double value
        ? value.ToString("F4")
        : "—";
}
