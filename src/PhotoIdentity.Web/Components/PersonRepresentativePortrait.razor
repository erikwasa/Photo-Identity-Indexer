@inject HttpClient Http

<div class="person-portrait @(Representative is { ImageUrl: not null, FaceId: not null } ? "image-only" : null)" aria-live="polite">
    @if (Loading)
    {
        <div class="portrait-placeholder" aria-hidden="true">…</div>
        <div class="portrait-copy">
            <strong>Loading portrait</strong>
            <span>Resolving representative face…</span>
        </div>
    }
    else if (Representative is { ImageUrl: string imageUrl, FaceId: string faceId })
    {
        <a class="portrait-link"
           href="@BuildFaceUrl(faceId)"
           title="Open representative face details">
            <img src="@imageUrl" alt="Representative face for @DisplayName" />
        </a>
    }
    else if (LoadFailed)
    {
        <div class="portrait-placeholder" aria-hidden="true">!</div>
        <div class="portrait-copy">
            <strong>Portrait unavailable</strong>
            <span>Representative face could not be loaded.</span>
        </div>
    }
    else
    {
        <div class="portrait-placeholder" aria-hidden="true">@Initial</div>
        <div class="portrait-copy">
            <strong>No representative photo</strong>
            <span>No assigned face is available yet.</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string PersonId { get; set; } = "";

    [Parameter, EditorRequired]
    public string DisplayName { get; set; } = "";

    private PersonRepresentativeFaceResponse? Representative { get; set; }
    private bool Loading { get; set; }
    private bool LoadFailed { get; set; }
    private string Initial => string.IsNullOrWhiteSpace(DisplayName)
        ? "?"
        : DisplayName.Trim()[0].ToString().ToUpperInvariant();

    protected override async Task OnParametersSetAsync()
    {
        Representative = null;
        LoadFailed = false;
        if (string.IsNullOrWhiteSpace(PersonId))
        {
            return;
        }

        Loading = true;
        try
        {
            Representative = await Http.GetFromJsonAsync<PersonRepresentativeFaceResponse>(
                $"api/review/people/{Uri.EscapeDataString(PersonId)}/representative-face");
        }
        catch
        {
            Representative = null;
            LoadFailed = true;
        }
        finally
        {
            Loading = false;
        }
    }

    private static string BuildFaceUrl(string faceId) =>
        $"/faces/{Uri.EscapeDataString(faceId)}?returnUrl={Uri.EscapeDataString("/people")}";
}
