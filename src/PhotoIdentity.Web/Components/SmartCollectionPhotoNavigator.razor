@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (Visible)
{
    <section class="smart-photo-navigator" aria-label="Smart Collection photo navigation">
        @if (Loading)
        {
            <span class="smart-photo-nav-status">Restoring Smart Collection navigation…</span>
        }
        else if (Resolved is SmartCollectionPhotoNavigationResolution navigation)
        {
            <div class="smart-photo-nav-controls">
                @if (navigation.PreviousRevisionId is string previousRevisionId)
                {
                    <a class="button secondary"
                       href="@BuildNeighborHref(previousRevisionId, navigation.Index - 1)"
                       rel="prev">
                        Previous
                    </a>
                }
                else
                {
                    <button type="button" class="button secondary" disabled>Previous</button>
                }

                <span class="smart-photo-nav-status">
                    Smart Collection photo @(navigation.Index + 1) of @navigation.Total
                </span>

                @if (navigation.NextRevisionId is string nextRevisionId)
                {
                    <a class="button secondary"
                       href="@BuildNeighborHref(nextRevisionId, navigation.Index + 1)"
                       rel="next">
                        Next
                    </a>
                }
                else
                {
                    <button type="button" class="button secondary" disabled>Next</button>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(Notice))
        {
            <span class="smart-photo-nav-status" role="status">@Notice</span>
        }
    </section>
}

@code {
    private bool Visible { get; set; }
    private bool Loading { get; set; }
    private string? Notice { get; set; }
    private SmartCollectionWorkspaceContext? WorkspaceContext { get; set; }
    private SmartCollectionPhotoNavigationResolution? Resolved { get; set; }
    private readonly Dictionary<int, SmartCollectionPageResponse> CachedPages = new();
    private readonly Dictionary<int, Task<SmartCollectionPageResponse?>> PendingPrefetches = new();
    private string? CachedContextKey;
    private int CacheEpoch;
    private long NavigationGeneration;
    private IJSObjectReference? KeyboardModule;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            KeyboardModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/smart-photo-navigation.js");
            await KeyboardModule.InvokeVoidAsync("installSmartCollectionArrows");
        }
        catch (JSException)
        {
            // Navigation buttons remain usable when browser shortcut support is unavailable.
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task ReloadAsync()
    {
        long generation = ++NavigationGeneration;
        Visible = false;
        Loading = false;
        Notice = null;
        WorkspaceContext = null;
        Resolved = null;

        if (!SmartCollectionNavigation.TryParsePhotoUrl(
                Navigation.Uri,
                out string? revisionId,
                out string? returnUrl))
        {
            ClearNavigationCache();
            return;
        }

        string? normalizedReturnUrl = PhotoReturnContext.NormalizeLocalReturnUrl(returnUrl);
        if (!SmartCollectionNavigation.TryParseWorkspaceContext(
                normalizedReturnUrl,
                out SmartCollectionWorkspaceContext? context) ||
            context is null)
        {
            CachedPages.Clear();
            CachedContextKey = null;
            return;
        }

        string contextKey = $"{context.Mode}:{context.CollectionId}:{context.PreviewKey}";
        if (!string.Equals(CachedContextKey, contextKey, StringComparison.Ordinal))
        {
            ClearNavigationCache();
            CachedContextKey = contextKey;
        }

        Visible = true;
        Loading = true;
        WorkspaceContext = context;

        try
        {
            SmartCollectionPageResponse? page;
            if (!CachedPages.TryGetValue(context.Offset, out page))
            {
                // A boundary crossing can await an in-flight prefetch instead of
                // issuing another identical database query.
                if (PendingPrefetches.TryGetValue(context.Offset, out Task<SmartCollectionPageResponse?>? pending))
                {
                    page = await pending;
                    if (generation != NavigationGeneration)
                    {
                        return;
                    }
                }

                if (page is null)
                {
                    SmartCollectionTransientNavigationState? transientState = null;
                    if (string.Equals(context.Mode, "transient", StringComparison.Ordinal))
                    {
                        transientState = await LoadTransientStateAsync(context);
                        if (generation != NavigationGeneration || transientState is null)
                        {
                            return;
                        }
                    }

                    (int offset, int limit) = SmartCollectionNavigation.NavigationWindowForOffset(context.Offset);
                    page = await QueryPageAsync(context, transientState, offset, limit, generation);
                    if (generation != NavigationGeneration || page is null)
                    {
                        return;
                    }
                }

                CacheWindow(context.Offset, page);
            }

            if (generation != NavigationGeneration)
            {
                return;
            }

            int localIndex = Array.FindIndex(
                page.Items,
                item => string.Equals(item.RevisionId, revisionId, StringComparison.Ordinal));
            int globalIndex = page.Offset + localIndex;
            if (localIndex < 0 ||
                globalIndex < context.Offset ||
                globalIndex >= context.Offset + SmartCollectionNavigation.ResultPageSize)
            {
                Notice = "Smart Collection results changed or this photo is no longer in the active result set. Return to Smart Collections to refresh the results.";
                return;
            }

            if (SmartCollectionNavigation.TryResolvePhotoNavigation(
                    page,
                    revisionId!,
                    globalIndex,
                    out SmartCollectionPhotoNavigationResolution? navigation))
            {
                Resolved = navigation;
                QueueNeighborPrefetches(context, navigation);
                return;
            }

            Notice = "Smart Collection results changed while this photo was open. Previous/next navigation is disabled until the collection is refreshed.";
        }
        catch (Exception exception)
        {
            if (generation == NavigationGeneration)
            {
                Notice = $"Smart Collection navigation could not be loaded: {exception.Message}";
            }
        }
        finally
        {
            if (generation == NavigationGeneration)
            {
                Loading = false;
            }
        }
    }

    private void ClearNavigationCache()
    {
        ++CacheEpoch;
        CachedContextKey = null;
        CachedPages.Clear();
        PendingPrefetches.Clear();
    }

    private void CacheWindow(int offset, SmartCollectionPageResponse page)
    {
        if (!CachedPages.ContainsKey(offset) && CachedPages.Count >= 4)
        {
            CachedPages.Remove(CachedPages.Keys.First());
        }

        CachedPages[offset] = page;
    }

    private void QueueNeighborPrefetches(
        SmartCollectionWorkspaceContext context,
        SmartCollectionPhotoNavigationResolution navigation)
    {
        (int? previousOffset, int? nextOffset) =
            SmartCollectionNavigation.PrefetchOffsetsForIndex(
                context.Offset, navigation.Index, navigation.Total);

        if (previousOffset is int previous)
        {
            QueuePrefetch(context, previous);
        }

        if (nextOffset is int next)
        {
            QueuePrefetch(context, next);
        }
    }

    private void QueuePrefetch(SmartCollectionWorkspaceContext context, int offset)
    {
        if (CachedPages.ContainsKey(offset) || PendingPrefetches.ContainsKey(offset))
        {
            return;
        }

        int epoch = CacheEpoch;
        Task<SmartCollectionPageResponse?> pending = PrefetchWindowAsync(context, offset, epoch);
        PendingPrefetches[offset] = pending;
        _ = CompletePrefetchAsync(offset, epoch, pending);
    }

    private async Task<SmartCollectionPageResponse?> PrefetchWindowAsync(
        SmartCollectionWorkspaceContext context,
        int pageOffset,
        int epoch)
    {
        try
        {
            SmartCollectionTransientNavigationState? transientState = null;
            if (string.Equals(context.Mode, "transient", StringComparison.Ordinal))
            {
                transientState = await LoadTransientStateAsync(context, silent: true);
                if (transientState is null)
                {
                    return null;
                }
            }

            if (epoch != CacheEpoch)
            {
                return null;
            }

            (int offset, int limit) = SmartCollectionNavigation.NavigationWindowForOffset(pageOffset);
            SmartCollectionPageResponse? page = await QueryPageAsync(
                context, transientState, offset, limit, NavigationGeneration, silent: true);
            return epoch == CacheEpoch ? page : null;
        }
        catch (Exception)
        {
            // Speculative reads must never interrupt normal navigation.
            // A failed prefetch is retried by the normal foreground query.
            return null;
        }
    }

    private async Task CompletePrefetchAsync(
        int offset,
        int epoch,
        Task<SmartCollectionPageResponse?> pending)
    {
        SmartCollectionPageResponse? page = await pending;
        if (epoch != CacheEpoch ||
            !PendingPrefetches.TryGetValue(offset, out Task<SmartCollectionPageResponse?>? current) ||
            !ReferenceEquals(current, pending))
        {
            return;
        }

        PendingPrefetches.Remove(offset);
        if (page is not null)
        {
            CacheWindow(offset, page);
        }
    }

    private async Task<SmartCollectionTransientNavigationState?> LoadTransientStateAsync(
        SmartCollectionWorkspaceContext context, bool silent = false)
    {
        if (string.IsNullOrWhiteSpace(context.PreviewKey))
        {
            if (!silent)
            {
    Notice = "The transient Smart Collection context is incomplete.";
            }
            return null;
        }

        string? json = await JS.InvokeAsync<string?>(
            "sessionStorage.getItem",
            SmartCollectionNavigation.PreviewStorageKey(context.PreviewKey));
        if (string.IsNullOrWhiteSpace(json))
        {
            if (!silent)
            {
    Notice = "This unsaved Smart Collection preview is no longer available in this browser tab.";
            }
            return null;
        }

        SmartCollectionTransientNavigationState? state =
            SmartCollectionNavigation.DeserializeTransientState(json);
        if (state is null)
        {
            if (!silent)
            {
    Notice = "This unsaved Smart Collection preview could not be restored.";
            }
            return null;
        }

        return state;
    }

    private async Task<SmartCollectionPageResponse?> QueryPageAsync(
        SmartCollectionWorkspaceContext context,
        SmartCollectionTransientNavigationState? transientState,
        int offset,
        int limit,
        long generation,
        bool silent = false)
    {
        using HttpResponseMessage response = string.Equals(context.Mode, "saved", StringComparison.Ordinal)
            ? await Http.GetAsync(
                $"api/smart-collections/{Uri.EscapeDataString(context.CollectionId!)}/query?offset={offset}&limit={limit}")
            : await QueryTransientAsync(transientState, offset, limit, silent);

        if (!silent && generation != NavigationGeneration)
        {
            return null;
        }

        if (!response.IsSuccessStatusCode)
        {
            if (!silent)
            {
                Notice = response.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "The saved Smart Collection is no longer available."
                    : $"Smart Collection navigation query failed with HTTP {(int)response.StatusCode}.";
            }

            return null;
        }

        return await response.Content.ReadFromJsonAsync<SmartCollectionPageResponse>();
    }

    private async Task<HttpResponseMessage> QueryTransientAsync(
        SmartCollectionTransientNavigationState? state,
        int offset,
        int limit,
        bool silent)
    {
        if (state is null ||
            !SmartCollectionNavigation.TryBuildTransientQuery(
                state,
                offset,
                limit,
                out SmartCollectionQueryRequest? request) ||
            request is null)
        {
            if (!silent)
            {
                Notice = "The unsaved Smart Collection filter could not be reconstructed for photo navigation.";
            }

            return new HttpResponseMessage(System.Net.HttpStatusCode.BadRequest);
        }

        return await Http.PostAsJsonAsync("api/smart-collections/query", request);
    }

    private string BuildNeighborHref(string revisionId, int index)
    {
        SmartCollectionWorkspaceContext context = WorkspaceContext
            ?? throw new InvalidOperationException("Smart Collection workspace context is unavailable.");
        int offset = SmartCollectionNavigation.PageOffsetForIndex(index);
        string returnUrl = SmartCollectionNavigation.BuildWorkspaceUrl(context, offset) +
            $"&focus={Uri.EscapeDataString(revisionId)}";
        return SmartCollectionNavigation.BuildPhotoUrl(revisionId, returnUrl);
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        ++NavigationGeneration;
        ClearNavigationCache();
        if (KeyboardModule is not null)
        {
            try
            {
                await KeyboardModule.InvokeVoidAsync("uninstallSmartCollectionArrows");
                await KeyboardModule.DisposeAsync();
            }
            catch (JSException)
            {
                // The browser may already be gone during teardown.
            }
        }
    }
}
