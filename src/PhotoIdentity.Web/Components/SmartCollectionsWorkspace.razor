@page "/smart-collections"

<PageTitle>Smart collections · Photo Identity</PageTitle>

<section class="smart-workspace" aria-labelledby="smart-collections-heading">
    <div class="smart-workspace-heading">
        <div>
            <p class="eyebrow">Saved smart collections</p>
            <h2 id="smart-collections-heading">People, tags, location and taken time</h2>
            <p>Save a filter definition and reopen it later. Results are always evaluated against the current catalogue.</p>
        </div>
        <button type="button" class="button secondary" disabled="@Busy" @onclick="NewCollection">New collection</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice error" role="alert">@Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Notice))
    {
        <div class="notice" role="status">@Notice</div>
    }

    @if (Loading)
    {
        <div class="smart-loading" aria-live="polite">
            <div class="spinner" aria-hidden="true"></div>
            <span>Loading smart collections…</span>
        </div>
    }
    else
    {
        <div class="smart-layout">
            <aside class="smart-saved-list" aria-label="Saved smart collections">
                <div class="smart-subheading">
                    <strong>Saved collections</strong>
                    <span>@Definitions.Count</span>
                </div>

                @if (Definitions.Count == 0)
                {
                    <p class="smart-muted">No saved collections yet.</p>
                }
                else
                {
                    @foreach (SmartCollectionDefinitionResponse definition in Definitions)
                    {
                        <article class="smart-saved-card @(EditingId == definition.Id ? "selected" : "")">
                            <button type="button"
                                    class="smart-open-button"
                                    disabled="@Busy"
                                    @onclick="() => OpenSavedAsync(definition)">
                                <strong>@definition.Name</strong>
                                <span>@PeopleSummary(definition.Filter)</span>
                                <span>@TagsSummary(definition.Filter)</span>
                                <span>@DateSummary(definition.Filter)</span>
                                <span>@LocationSummary(definition.Filter)</span>
                            </button>
                            <button type="button"
                                    class="smart-delete-button"
                                    disabled="@Busy"
                                    @onclick="() => DeleteAsync(definition)">
                                Delete
                            </button>
                        </article>
                    }
                }
            </aside>

            <div class="smart-editor">
                <div class="smart-subheading">
                    <strong>@EditorHeading</strong>
                    @if (EditingId is not null)
                    {
                        <span>Saved definition</span>
                    }
                </div>

                <label class="smart-field">
                    <span class="field-label">Collection name</span>
                    <input type="text"
                           maxlength="120"
                           placeholder="Example: Summer 2025 in Stockholm"
                           @bind="Name"
                           disabled="@Busy" />
                </label>

                <div class="smart-filter-grid">
                    <fieldset class="smart-filter-card">
                        <legend>People</legend>
                        <label class="smart-inline-field">
                            <span>Match</span>
                            <select @bind="PeopleMatch" disabled="@Busy">
                                <option value="all">All selected</option>
                                <option value="any">Any selected</option>
                            </select>
                        </label>

                        <SmartCollectionPeoplePicker People="People"
                                                     SelectedPersonIds="SelectedPeople"
                                                     Disabled="Busy" />
                    </fieldset>

                    <fieldset class="smart-filter-card">
                        <legend>Tags</legend>
                        <label class="smart-inline-field">
                            <span>Match</span>
                            <select @bind="TagMatch" disabled="@Busy">
                                <option value="all">All selected</option>
                                <option value="any">Any selected</option>
                            </select>
                        </label>

                        <div class="smart-option-list" role="group" aria-label="Tag filter">
                            @if (OrderedTags.Count == 0)
                            {
                                <span class="smart-muted">No canonical tags yet.</span>
                            }
                            else
                            {
                                @foreach (PhotoTagDefinitionResponse tag in OrderedTags)
                                {
                                    <label class="smart-check-option">
                                        <input type="checkbox"
                                               checked="@SelectedTags.Contains(tag.Value)"
                                               disabled="@Busy"
                                               @onchange="args => ToggleTag(tag.Value, args)" />
                                        <span>@tag.Value</span>
                                    </label>
                                }
                            }
                        </div>
                    </fieldset>
                </div>

                <div class="smart-filter-grid smart-secondary-grid">
                    <fieldset class="smart-filter-card">
                        <legend>Taken time</legend>

                        <label class="smart-field">
                            <span class="field-label">Date filter</span>
                            <select @bind="TakenMode" disabled="@Busy">
                                <option value="@SmartCollectionDateModes.Any">Any date</option>
                                <option value="@SmartCollectionDateModes.Year">Year</option>
                                <option value="@SmartCollectionDateModes.Month">Month</option>
                                <option value="@SmartCollectionDateModes.Date">Exact date</option>
                                <option value="@SmartCollectionDateModes.Range">Date range</option>
                            </select>
                        </label>

                        @if (TakenMode == SmartCollectionDateModes.Year)
                        {
                            <label class="smart-field">
                                <span class="field-label">Year</span>
                                <input type="number"
                                       min="1"
                                       max="9999"
                                       step="1"
                                       inputmode="numeric"
                                       placeholder="2025"
                                       @bind="TakenYear"
                                       disabled="@Busy" />
                            </label>
                        }
                        else if (TakenMode == SmartCollectionDateModes.Month)
                        {
                            <label class="smart-field">
                                <span class="field-label">Month</span>
                                <input type="month"
                                       value="@TakenMonth"
                                       @onchange="args => TakenMonth = args.Value?.ToString() ?? string.Empty"
                                       disabled="@Busy" />
                            </label>
                        }
                        else if (TakenMode == SmartCollectionDateModes.Date)
                        {
                            <label class="smart-field">
                                <span class="field-label">Date</span>
                                <input type="date"
                                       value="@TakenDate"
                                       @onchange="args => TakenDate = args.Value?.ToString() ?? string.Empty"
                                       disabled="@Busy" />
                            </label>
                        }
                        else if (TakenMode == SmartCollectionDateModes.Range)
                        {
                            <div class="smart-date-range">
                                <label class="smart-field">
                                    <span class="field-label">From</span>
                                    <input type="date"
                                           value="@TakenFrom"
                                           @onchange="args => TakenFrom = args.Value?.ToString() ?? string.Empty"
                                           disabled="@Busy" />
                                </label>
                                <label class="smart-field">
                                    <span class="field-label">To</span>
                                    <input type="date"
                                           value="@TakenTo"
                                           @onchange="args => TakenTo = args.Value?.ToString() ?? string.Empty"
                                           disabled="@Busy" />
                                </label>
                            </div>
                        }

                        <small class="smart-help">
                            Any date applies no date filter, so photos without a capture date remain eligible.
                            Other modes require an effective capture date; missing dates do not match.
                            Imprecise manual dates match when their inclusive range overlaps this filter.
                        </small>
                    </fieldset>

                    <fieldset class="smart-filter-card">
                        <legend>Location</legend>

                        <PlacePicker Label="Add named place"
                                     EmptyLabel="Search named places"
                                     Value="@PendingPlace"
                                     ValueChanged="AddPlaceAsync"
                                     Disabled="@(Busy || SelectedPlaces.Count >= SmartCollectionFilter.MaximumLocationPlaces)" />

                        @if (SelectedPlaces.Count > 0)
                        {
                            <div class="smart-place-selection" aria-label="Selected named places">
                                <div class="smart-place-selection-heading">
                                    <strong>Match any selected place</strong>
                                    <span>@SelectedPlaces.Count / @SmartCollectionFilter.MaximumLocationPlaces</span>
                                </div>
                                <div class="smart-place-chips">
                                    @foreach (string place in SelectedPlaces.OrderBy(value => value, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <span class="smart-place-chip">
                                            <span>@place</span>
                                            <button type="button"
                                                    aria-label="Remove @place"
                                                    disabled="@Busy"
                                                    @onclick="() => RemovePlace(place)">
                                                Remove
                                            </button>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <small class="smart-help">No named place filter. Photos from any named or unnamed location remain eligible.</small>
                        }

                        <small class="smart-help">
                            Named places use OR semantics. Selecting a parent such as Sweden includes all descendants and makes nested selections redundant.
                        </small>

                        <label class="smart-location-toggle">
                            <input type="checkbox" @bind="UseLocation" disabled="@Busy" />
                            <span>Also limit to GPS rectangle</span>
                        </label>

                        <div class="smart-coordinate-grid">
                            <label>
                                <span>South</span>
                                <input type="text" inputmode="decimal" @bind="South" disabled="@(!UseLocation || Busy)" />
                            </label>
                            <label>
                                <span>West</span>
                                <input type="text" inputmode="decimal" @bind="West" disabled="@(!UseLocation || Busy)" />
                            </label>
                            <label>
                                <span>North</span>
                                <input type="text" inputmode="decimal" @bind="North" disabled="@(!UseLocation || Busy)" />
                            </label>
                            <label>
                                <span>East</span>
                                <input type="text" inputmode="decimal" @bind="East" disabled="@(!UseLocation || Busy)" />
                            </label>
                        </div>
                        <small class="smart-help">The named-place group and GPS rectangle are independent. If both are populated, a photo must match any selected place AND the GPS rectangle. Missing GPS metadata will not match a populated rectangle.</small>
                    </fieldset>
                </div>

                <div class="smart-actions">
                    <button type="button" class="button primary" disabled="@Busy" @onclick="SaveAsync">
                        @(Busy ? "Working…" : SaveLabel)
                    </button>
                    <button type="button" class="button secondary" disabled="@Busy" @onclick="PreviewAsync">
                        Preview current filters
                    </button>
                    @if (EditingId is not null)
                    {
                        <button type="button" class="button primary" disabled="@Busy" @onclick="StartSlideshowAsync">
                            Start slideshow
                        </button>
                        <button type="button" class="button secondary" disabled="@Busy" @onclick="() => QuerySavedAsync(0)">
                            Re-evaluate saved definition
                        </button>
                    }
                </div>

                @if (EditingId is not null)
                {
                    <section class="creative-recipe" aria-labelledby="creative-recipe-heading">
                        <div class="smart-workspace-heading compact">
                            <div>
                                <p class="eyebrow">Creative collection</p>
                                <h3 id="creative-recipe-heading">Turn this exact collection into a varied slideshow</h3>
                                <p>
                                    The Smart Collection remains the exact anchor definition. Creative mode can add nearby
                                    same-moment context and curate the result toward a target size.
                                </p>
                            </div>
                            <span class="smart-result-label">@CreativeRecipeStatus</span>
                        </div>

                        <div class="creative-controls">
                            <label class="smart-field">
                                <span class="field-label">Target photos</span>
                                <input type="number"
                                       min="1"
                                       max="1000"
                                       inputmode="numeric"
                                       @bind="CreativeTargetCount"
                                       @bind:after="ClearCreativePreview"
                                       disabled="@Busy" />
                            </label>

                            <label class="smart-field">
                                <span class="field-label">Context</span>
                                <select @bind="CreativeContextStrength"
                                        @bind:after="ClearCreativePreview"
                                        disabled="@Busy">
                                    <option value="focused">Focused</option>
                                    <option value="balanced">Balanced</option>
                                    <option value="broad">Broad</option>
                                </select>
                            </label>

                            <label class="smart-location-toggle">
                                <input type="checkbox"
                                       @bind="CreativeNoveltyEnabled"
                                       @bind:after="ClearCreativePreview"
                                       disabled="@Busy" />
                                <span>Favor photos not shown recently</span>
                            </label>
                        </div>

                        <p class="smart-help">
                            Focused adds at most 2 nearby context photos per anchored moment, Balanced 6, and Broad 12.
                            Freshness is optional and uses recorded slideshow presentations only; it never changes exact
                            Smart Collection membership or photo metadata. The accepted 30-minute moment policy,
                            deterministic diversity policy and chronological playback order stay versioned with the saved recipe.
                        </p>

                        <div class="smart-actions">
                            <button type="button"
                                    class="button secondary"
                                    disabled="@Busy"
                                    @onclick="PreviewCreativeAsync">
                                Preview creative selection
                            </button>
                            <button type="button"
                                    class="button secondary"
                                    disabled="@Busy"
                                    @onclick="SaveCreativeRecipeAsync">
                                Save creative recipe
                            </button>
                            <button type="button"
                                    class="button primary"
                                    disabled="@Busy"
                                    @onclick="StartCreativeSlideshowAsync">
                                Save &amp; start creative slideshow
                            </button>
                        </div>

                        @if (CreativePreview is CreativeCollectionPreviewResponse creative)
                        {
                            <div class="creative-summary" aria-label="Creative collection preview counts">
                                <div class="creative-stat"><strong>@creative.DirectAnchorCount</strong><span>anchors</span></div>
                                <div class="creative-stat"><strong>+@creative.AddedContextCount</strong><span>context</span></div>
                                <div class="creative-stat"><strong>@creative.TotalCandidateCount</strong><span>candidates</span></div>
                                <div class="creative-stat"><strong>@creative.SelectedCount</strong><span>selected</span></div>
                                <div class="creative-stat"><strong>@creative.RepresentedMomentCount</strong><span>moments</span></div>
                                <div class="creative-stat"><strong>@creative.RepresentedTimePeriodCount</strong><span>months</span></div>
                                <div class="creative-stat"><strong>@(creative.NoveltyEnabled ? "On" : "Off")</strong><span>freshness</span></div>
                            </div>

                            @if (creative.NoAnchors)
                            {
                                <div class="empty-state compact">
                                    <p>No photos currently match the exact Smart Collection, so Creative mode stays empty.</p>
                                </div>
                            }
                            else
                            {
                                <div class="creative-preview-grid" aria-label="Selected Creative Collection photos">
                                    @foreach (CreativeCollectionSelectedCandidateResponse photo in creative.SelectedCandidates.Take(60))
                                    {
                                        bool directAnchor = string.Equals(photo.Kind, "direct-anchor", StringComparison.Ordinal);
                                        <article class="creative-preview-card">
                                            <img src="@photo.ThumbnailUrl"
                                                 alt="Creative collection selected photo"
                                                 loading="lazy"
                                                 decoding="async" />
                                            <div>
                                                <span class="creative-kind @(directAnchor ? "anchor" : "context")">
                                                    @(directAnchor ? "Anchor" : "Context")
                                                </span>
                                                <strong>@CreativePhotoDate(photo)</strong>
                                                <span class="smart-muted">@CreativeReasonSummary(photo)</span>
                                                <span class="smart-muted">@CreativeHistorySummary(photo)</span>
                                            </div>
                                        </article>
                                    }
                                </div>

                                @if (creative.SelectedCandidates.Length > 60)
                                {
                                    <p class="smart-help">
                                        Showing the first 60 selected photos. Playback uses the full @creative.SelectedCount-photo snapshot.
                                    </p>
                                }
                            }
                        }
                    </section>
                }
            </div>
        </div>

        @if (Results is SmartCollectionPageResponse resultPage)
        {
            <section class="smart-results" aria-labelledby="smart-results-heading">
                <div class="smart-workspace-heading compact">
                    <div>
                        <p class="eyebrow">Current catalogue</p>
                        <h3 id="smart-results-heading">@resultPage.Total photo@(resultPage.Total == 1 ? "" : "s")</h3>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(resultPage.CollectionName))
                    {
                        <span class="smart-result-label">@resultPage.CollectionName</span>
                    }
                </div>

                @if (resultPage.Items.Length == 0)
                {
                    <div class="empty-state compact">
                        <p>No photos currently match this definition.</p>
                    </div>
                }
                else
                {
                    <div class="smart-photo-grid">
                        @foreach (SmartCollectionPhotoResponse photo in resultPage.Items)
                        {
                            <article class="smart-photo-card">
                                <a href="@PhotoHref(photo)" aria-label="Open photo">
                                    <img src="@photo.ThumbnailUrl" alt="Smart collection photo" loading="lazy" decoding="async" />
                                </a>
                                <div>
                                    <strong>@PhotoDate(photo)</strong>
                                    <span>@PhotoLocation(photo)</span>
                                    @if (photo.Width is int width && photo.Height is int height)
                                    {
                                        <span>@width × @height</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>

                    <nav class="pagination" aria-label="Smart collection pages">
                        <button type="button"
                                class="button secondary"
                                disabled="@(Busy || resultPage.Offset == 0)"
                                @onclick="PreviousPageAsync">
                            Previous
                        </button>
                        <span>Showing @FirstResult–@LastResult</span>
                        <button type="button"
                                class="button secondary"
                                disabled="@(Busy || resultPage.Offset + resultPage.Items.Length >= resultPage.Total)"
                                @onclick="NextPageAsync">
                            Next
                        </button>
                    </nav>
                }
            </section>
        }
    }
</section>
