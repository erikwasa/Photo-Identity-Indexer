@inject HttpClient Http

<section class="review-filter-panel" aria-labelledby="archive-storage-settings-heading">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Bounded storage</p>
            <h2 id="archive-storage-settings-heading">Archive hydration policy</h2>
        </div>
        @if (ArchiveStorage is not null)
        {
            <span class="model-summary">Managed hydration: @(ArchiveStorage.PolicyConfigured ? "enabled" : "disabled")</span>
        }
    </div>

    @if (Loading)
    {
        <div class="empty-state compact" aria-live="polite">
            <div class="spinner" aria-hidden="true"></div>
            <p>Loading archive storage status…</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice error" role="alert">Archive storage status could not be loaded: @Error</div>
    }
    else if (ArchiveStorage is null)
    {
        <div class="empty-state compact">
            <p>No archive storage status is available.</p>
        </div>
    }
    else
    {
        <div class="review-filter-grid">
            <div>
                <span class="field-label">Minimum free-space reserve</span>
                <strong>@FormatByteSetting(ArchiveStorage.MinimumFreeSpaceReserveBytes)</strong>
                <p><code>PhotoIdentity__ArchiveHydration__MinimumFreeSpaceReserveBytes</code></p>
            </div>
            <div>
                <span class="field-label">Maximum Photo Identity-managed hydration</span>
                <strong>@FormatByteSetting(ArchiveStorage.MaximumManagedHydrationBytes)</strong>
                <p><code>PhotoIdentity__ArchiveHydration__MaximumManagedHydrationBytes</code></p>
            </div>
            <div>
                <span class="field-label">Maximum concurrent operations</span>
                <strong>@FormatCountSetting(ArchiveStorage.MaximumConcurrentOperations)</strong>
                <p><code>PhotoIdentity__ArchiveHydration__MaximumConcurrentOperations</code></p>
            </div>
        </div>

        <h3>Current storage use</h3>
        <div class="review-filter-grid">
            <div>
                <span class="field-label">Disk free now</span>
                <strong>@FormatByteSetting(ArchiveStorage.AvailableFreeBytes)</strong>
                <p>Current available free space on the volume containing the configured archive.</p>
            </div>
            <div>
                <span class="field-label">Photo Identity-managed hydration used</span>
                <strong>@FormatByteSetting(ArchiveStorage.ManagedReservedBytes)</strong>
                <p>@ArchiveStorage.ActiveManagedOriginals managed item(s) · @ArchiveStorage.HydrationsInProgress hydration(s) currently downloading.</p>
            </div>
            <div>
                <span class="field-label">Managed budget remaining</span>
                <strong>@FormatByteSetting(RemainingManagedBudget(ArchiveStorage))</strong>
                <p>Maximum managed hydration minus bytes still reserved by Photo Identity.</p>
            </div>
            <div>
                <span class="field-label">Managed local / downloading / releasing</span>
                <strong>@FormatByteSetting(ArchiveStorage.ManagedHydratedBytes)</strong>
                <p>@FormatByteSetting(ArchiveStorage.ManagedDownloadingBytes) downloading · @FormatByteSetting(ArchiveStorage.ManagedReleasingBytes) releasing.</p>
            </div>
            <div>
                <span class="field-label">Durable review proxies</span>
                <strong>@FormatByteSetting(ArchiveStorage.ReviewProxyBytes)</strong>
                <p>Selected profile: @(string.IsNullOrWhiteSpace(ArchiveStorage.ReviewProxyProfileId) ? "not configured" : ArchiveStorage.ReviewProxyProfileId)</p>
            </div>
            <div>
                <span class="field-label">Logical archive source size</span>
                <strong>@FormatByteSetting(ArchiveStorage.LogicalSourceBytes)</strong>
                <p>Aggregate logical bytes in current archive coverage; this is not the amount that must remain local.</p>
            </div>
        </div>

        @if (ArchiveStorage.PolicyConfigured)
        {
            <div class="notice success">
                Managed archive hydration is enabled with all three required limits configured.
            </div>
        }
        else
        {
            <div class="notice warning">
                @(ArchiveStorage.PolicyMessage ?? "Managed archive hydration is disabled because the complete bounded-storage policy is not configured.")
            </div>
        }

        <p class="field-help">
            These are startup configuration values and are read-only while Photo Identity is running. For the packaged Windows application, edit
            <code>%LOCALAPPDATA%\PhotoIdentity\launcher.json</code> and restart Photo Identity for changes to take effect. Refresh this page to update current disk and managed-storage observations.
        </p>
    }
</section>

@code {
    [Parameter]
    public int RefreshVersion { get; set; }

    private ArchiveStorageStatusResponse? ArchiveStorage { get; set; }
    private bool Loading { get; set; } = true;
    private string? Error { get; set; }
    private int LoadedRefreshVersion { get; set; } = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (LoadedRefreshVersion == RefreshVersion)
        {
            return;
        }

        LoadedRefreshVersion = RefreshVersion;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        ArchiveStorage = null;
        try
        {
            ArchiveStorage = await Http.GetFromJsonAsync<ArchiveStorageStatusResponse>("api/archive/storage");
            if (ArchiveStorage is null)
            {
                Error = "The archive storage response was empty.";
            }
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private static long? RemainingManagedBudget(ArchiveStorageStatusResponse storage) =>
        storage.MaximumManagedHydrationBytes is long maximum
            ? Math.Max(0L, maximum - storage.ManagedReservedBytes)
            : null;

    private static string FormatByteSetting(long? value)
    {
        if (value is null)
        {
            return "Not available";
        }

        string[] units = ["bytes", "KiB", "MiB", "GiB", "TiB"];
        double scaled = value.Value;
        int unit = 0;
        while (Math.Abs(scaled) >= 1024d && unit < units.Length - 1)
        {
            scaled /= 1024d;
            unit++;
        }

        string human = unit == 0 ? $"{value.Value} bytes" : $"{scaled:0.##} {units[unit]}";
        return $"{human} ({value.Value} bytes exact)";
    }

    private static string FormatCountSetting(int? value) =>
        value is null ? "Not configured" : $"{value.Value} operation{(value.Value == 1 ? "" : "s")}";
}
