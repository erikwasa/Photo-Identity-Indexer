@inject HttpClient Http

<section class="review-filter-panel" aria-labelledby="geonames-settings-heading">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Location enrichment</p>
            <h2 id="geonames-settings-heading">GeoNames place enrichment</h2>
        </div>
        @if (Status is not null)
        {
            <span class="model-summary">GeoNames: @(Status.AutomaticEnrichmentEnabled ? "automatic" : Status.Configured ? "configured" : "disabled")</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="notice error" role="alert">@Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Warning))
    {
        <div class="notice warning" role="status">@Warning</div>
    }
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="notice success" role="status">@Message</div>
    }

    @if (Loading)
    {
        <div class="empty-state compact" aria-live="polite">
            <div class="spinner" aria-hidden="true"></div>
            <p>Loading GeoNames status…</p>
        </div>
    }
    else if (Status is null)
    {
        <div class="empty-state compact">
            <p>No GeoNames enrichment status is available.</p>
        </div>
    }
    else
    {
        <div class="review-filter-grid">
            <div>
                <span class="field-label">Provider state</span>
                <strong>@(Status.Configured ? "Configured" : "Disabled")</strong>
                <p>The configured GeoNames username is kept server-side and is never returned by this status API.</p>
            </div>
            <div>
                <span class="field-label">Automatic worker</span>
                <strong>@FormatWorkerState(Status.AutomaticState)</strong>
                <p>@Status.AutomaticMessage</p>
            </div>
            <div>
                <span class="field-label">Automatic provider pacing</span>
                <strong>@FormatInterval(Status.AutomaticMinimumRequestIntervalMilliseconds)</strong>
                <p>This is the effective interval between provider requests. The default is 30 seconds; an explicitly configured lower value is honored.</p>
            </div>
            <div>
                <span class="field-label">Next automatic check</span>
                <strong>@FormatTimestamp(Status.NextAutomaticAttemptAtUtc)</strong>
                <p>Newly persisted GPS metadata becomes eligible automatically; archive analysis does not wait for GeoNames.</p>
            </div>
            <div>
                <span class="field-label">Service</span>
                <strong>@Status.ServiceHost</strong>
                <p>Requests use the configured secure GeoNames service contract.</p>
            </div>
            <div>
                <span class="field-label">Place language</span>
                <strong>@Status.Language</strong>
                <p>With the default local policy, Swedish coordinates keep local names and locations outside Sweden are stored using English names.</p>
            </div>
            <div>
                <span class="field-label">Raw provider-client interval</span>
                <strong>@FormatInterval(Status.MinimumRequestIntervalMilliseconds)</strong>
                <p>Every actual GeoNames HTTP request respects this interval, including an English fallback lookup for a non-Swedish coordinate.</p>
            </div>
            <div>
                <span class="field-label">Last automatic activity</span>
                <strong>@FormatTimestamp(Status.LastAutomaticActivityAtUtc)</strong>
                <p>The worker state is in-memory; completed enrichment state remains durable in SQLite and resumes after restart.</p>
            </div>
        </div>

        @if (!Status.Configured)
        {
            <div class="notice warning">
                GeoNames enrichment is disabled. Configure <code>PhotoIdentity__GeoNames__Username</code> in the packaged application's
                <code>%LOCALAPPDATA%\PhotoIdentity\launcher.json</code>, then restart Photo Identity. Once configured, automatic enrichment
                starts without a manual batch. Optional startup settings are <code>PhotoIdentity__GeoNames__BaseUrl</code>,
                <code>PhotoIdentity__GeoNames__Language</code>, <code>PhotoIdentity__GeoNames__MinimumRequestIntervalMilliseconds</code>, and
                <code>PhotoIdentity__GeoNames__AutomaticMinimumRequestIntervalMilliseconds</code>. Lower automatic intervals can consume provider credits faster.
            </div>
        }
        else
        {
            <div class="notice warning">
                <strong>External GPS disclosure:</strong> automatic enrichment sends an eligible photo's persisted latitude and longitude,
                the configured GeoNames username, and the documented service parameters to GeoNames. It does not send photo bytes, filenames,
                source paths, people, tags, or other catalogue metadata. The username remains server-side and is not shown here. For a non-Swedish
                coordinate under the default language policy, the first uncached lookup can require a second provider request to obtain the English name.
            </div>

            @if (!Status.AutomaticEnrichmentEnabled)
            {
                <div class="notice warning">
                    Automatic enrichment is disabled by local configuration. Remove the override or set
                    <code>PhotoIdentity__GeoNames__AutomaticEnrichmentEnabled</code> to <code>true</code>, then restart Photo Identity.
                </div>
            }

            <h3>Maintenance controls</h3>
            <p class="field-help">
                Normal operation does not require these controls. The background worker automatically resumes unattempted, failed and deferred GPS photos.
                Use a small manual batch only for diagnostics, or force refresh when intentionally replacing existing automatic results.
            </p>

            <div class="review-filter-grid">
                <div>
                    <label class="field-label" for="settings-geonames-batch-size">Maximum candidates this maintenance run</label>
                    <input id="settings-geonames-batch-size"
                           type="number"
                           min="1"
                           max="8"
                           step="1"
                           @bind="BatchSize"
                           disabled="@Busy" />
                    <p>Browser maintenance runs are deliberately kept small. Long-running catalogue enrichment belongs to the automatic server-side worker.</p>
                </div>
            </div>

            <div class="card-actions">
                <button type="button"
                        class="button primary"
                        disabled="@(Busy || !ValidBatchSize)"
                        @onclick="RunEnrichmentAsync">
                    @(Busy ? "Running…" : "Run maintenance batch")
                </button>
                <button type="button"
                        class="button secondary"
                        disabled="@(Busy || !ValidBatchSize)"
                        @onclick="RefreshAutomaticPlacesAsync">
                    Force refresh automatic places
                </button>
            </div>

            <p class="field-help">
                A maintenance run reuses cached coordinate results and skips completed revisions. Force refresh bypasses the reverse-geocode cache for eligible automatic
                results and can spend additional provider credits; manual places, explicit manual clears, unresolved migration conflicts, and completed no-result attempts remain protected.
            </p>
        }

        @if (LastReport is PhotoPlaceEnrichmentReportResponse report)
        {
            <h3>Latest maintenance result</h3>
            <div class="review-filter-grid" aria-live="polite">
                <div>
                    <span class="field-label">Candidates</span>
                    <strong>@report.Candidates</strong>
                    <p>@report.ProviderRequests provider request(s) · @report.CachedResults cached result(s)</p>
                </div>
                <div>
                    <span class="field-label">Assignments</span>
                    <strong>@report.Assigned</strong>
                    <p>@report.UnchangedAutomatic automatic result(s) already unchanged</p>
                </div>
                <div>
                    <span class="field-label">Protected / conflicts</span>
                    <strong>@report.SkippedManual / @report.SkippedConflict</strong>
                    <p>Manual history and unresolved migration conflicts are never overwritten automatically.</p>
                </div>
                <div>
                    <span class="field-label">No place / deferred / failed</span>
                    <strong>@report.NoResult / @report.Deferred / @report.Failed</strong>
                    <p>@(report.StoppedEarly ? "The batch stopped after the provider response shown below." : "The bounded maintenance batch reached a normal stopping point.")</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(report.StopReasonMessage))
            {
                <div class="notice @(report.Failed > 0 ? "error" : "warning")" role="status">
                    <strong>Provider result@(string.IsNullOrWhiteSpace(report.StopReasonCode) ? string.Empty : $" ({report.StopReasonCode})")</strong>
                    <p>@report.StopReasonMessage</p>
                    @if (string.Equals(report.StopReasonCode, "10", StringComparison.Ordinal))
                    {
                        <p>
                            GeoNames requires confirmed accounts to enable free web-service access separately.
                            <a href="https://www.geonames.org/manageaccount" target="_blank" rel="noopener noreferrer">Open the GeoNames account page</a>,
                            enable <strong>Free Web Services</strong>, then allow the automatic worker to retry.
                        </p>
                    }
                </div>
            }

            @if (report.Issues is { Count: > 0 })
            {
                <h4>Photo-level provider results</h4>
                <div class="review-filter-grid">
                    @foreach (PhotoPlaceEnrichmentIssueResponse issue in report.Issues)
                    {
                        <div>
                            <span class="field-label">@FormatOutcome(issue.Outcome)@(string.IsNullOrWhiteSpace(issue.ProviderCode) ? string.Empty : $" · code {issue.ProviderCode}")</span>
                            <p>@issue.Message</p>
                            <a class="button secondary" href="@($"/photo/{issue.RevisionId}?returnUrl=%2Fsettings")">Open photo</a>
                        </div>
                    }
                </div>
            }
        }

        <p class="field-help">
            Place data and reverse-geocoding service by <a href="https://www.geonames.org/" target="_blank" rel="noopener noreferrer">GeoNames</a>.
            Provider-derived places remain normal first-class Photo Identity locations and can be corrected manually.
        </p>
    }
</section>

@code {
    private PhotoPlaceEnrichmentStatusResponse? Status { get; set; }
    private PhotoPlaceEnrichmentReportResponse? LastReport { get; set; }
    private int BatchSize { get; set; } = 5;
    private bool Loading { get; set; } = true;
    private bool Busy { get; set; }
    private string? Error { get; set; }
    private string? Warning { get; set; }
    private string? Message { get; set; }

    private bool ValidBatchSize => BatchSize is >= 1 and <= 8;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatusAsync();
    }

    private async Task LoadStatusAsync()
    {
        Loading = true;
        Error = null;
        try
        {
            Status = await Http.GetFromJsonAsync<PhotoPlaceEnrichmentStatusResponse>("api/place-enrichment/status");
            if (Status is null)
            {
                Error = "The GeoNames status response was empty.";
            }
        }
        catch (Exception exception)
        {
            Status = null;
            Error = $"GeoNames status could not be loaded: {exception.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private Task RunEnrichmentAsync() => ExecuteAsync(refresh: false);

    private Task RefreshAutomaticPlacesAsync() => ExecuteAsync(refresh: true);

    private async Task ExecuteAsync(bool refresh)
    {
        if (!ValidBatchSize)
        {
            Error = "GeoNames maintenance batch size must be between 1 and 8.";
            return;
        }

        if (Status is not { Configured: true })
        {
            Error = "GeoNames enrichment is disabled until a private username is configured and Photo Identity is restarted.";
            return;
        }

        Busy = true;
        Error = null;
        Warning = null;
        Message = null;
        try
        {
            string url = $"api/place-enrichment/geonames?limit={BatchSize}&refresh={refresh.ToString().ToLowerInvariant()}";
            using HttpResponseMessage response = await Http.PostAsync(url, content: null);
            if (!response.IsSuccessStatusCode)
            {
                PhotoPlaceEnrichmentErrorResponse? apiError = null;
                try
                {
                    apiError = await response.Content.ReadFromJsonAsync<PhotoPlaceEnrichmentErrorResponse>();
                }
                catch
                {
                    // Fall through to the status-code message when the response is not the API error contract.
                }

                Error = apiError?.Error ?? $"GeoNames enrichment failed with HTTP {(int)response.StatusCode}.";
                return;
            }

            LastReport = await response.Content.ReadFromJsonAsync<PhotoPlaceEnrichmentReportResponse>();
            if (LastReport is null)
            {
                Error = "The GeoNames enrichment response was empty.";
                return;
            }

            if (LastReport.Failed > 0)
            {
                Error = $"GeoNames enrichment completed with {LastReport.Failed} failed provider request(s). See Photo-level provider results for details.";
            }
            else if (LastReport.Deferred > 0)
            {
                Warning = $"GeoNames enrichment paused or completed with {LastReport.Deferred} deferred request(s). The automatic worker will retry eligible deferred work.";
            }
            else if (LastReport.NoResult > 0)
            {
                Warning = $"GeoNames enrichment finished with {LastReport.Assigned} assignment(s) and {LastReport.NoResult} photo(s) where no nearby populated place was found.";
            }
            else
            {
                Message = refresh
                    ? $"GeoNames refresh finished: {LastReport.Assigned} automatic place assignment(s)."
                    : $"GeoNames maintenance run finished: {LastReport.Assigned} place assignment(s), {LastReport.CachedResults} cached result(s).";
            }
        }
        catch (Exception exception)
        {
            Error = exception.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private static string FormatOutcome(string outcome) => outcome switch
    {
        "no-result" => "No nearby populated place",
        "deferred" => "Deferred",
        "failed" => "Failed",
        _ => outcome,
    };

    private static string FormatWorkerState(string state) => state switch
    {
        "starting" => "Starting",
        "running" => "Running",
        "waiting" => "Waiting",
        "idle" => "Idle",
        "disabled" => "Disabled",
        _ => state,
    };

    private static string FormatTimestamp(DateTimeOffset? value) =>
        value is null
            ? "Not yet"
            : value.Value.ToLocalTime().ToString("g");

    private static string FormatInterval(int milliseconds) =>
        milliseconds == 0
            ? "No client delay configured"
            : milliseconds % 1000 == 0
                ? $"{milliseconds / 1000} second{(milliseconds == 1000 ? "" : "s")}"
                : $"{milliseconds} ms";
}
