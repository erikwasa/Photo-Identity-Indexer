@inject HttpClient Http

<section class="review-filter-panel" aria-labelledby="video-processing-settings-heading">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Photo-first archive</p>
            <h2 id="video-processing-settings-heading">Video processing</h2>
            <p>Run eligible videos after the photo archive has no pending work.
               The usual Advance archive and Pause archive buttons control the session.</p>
        </div>
    </div>

    @if (Loading)
    {
        <div class="empty-state compact">Loading video settings…</div>
    }
    else if (Status is null)
    {
        <div class="notice error">Video processing status is unavailable.</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="notice error" role="alert">@Error</div>
        }
        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="notice success" role="status">@Message</div>
        }

        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <div class="review-filter-grid">
                <div>
                    <label class="field-label" for="video-processing-enabled">
                        <input id="video-processing-enabled" type="checkbox"
                               @bind="Enabled" disabled="@Saving" />
                        Process videos
                    </label>
                    <p>Off by default. When on, eligible videos run one at a time
                       after photo processing. No parallel video jobs.</p>
                </div>
                <div>
                    <label class="field-label" for="video-processing-online">
                        <input id="video-processing-online" type="checkbox"
                               @bind="IncludeOnlineOnly" disabled="@(Saving || !Enabled)" />
                        Include online-only videos
                    </label>
                    <p>Off by default. Allows bounded OneDrive downloads for video
                       processing and requests online-only again afterwards.
                       Videos already stored locally are left as they were.</p>
                </div>
            </div>
            <fieldset class="review-filter-panel">
                <legend class="field-label">Bounded video verification</legend>
                <label class="field-label" for="video-processing-one-step">
                    <input id="video-processing-one-step" type="checkbox"
                           @bind="StopAfterOneVideoStepPerAdvance"
                           disabled="@Saving" />
                    Stop each Archive advance after one video step
                </label>
                <p class="field-help">
                    Optional. After the normal photo-first processing completes,
                    a video step may inspect one new video or attempt one queued
                    proxy. This setting ends that Archive advance after its
                    first such step instead of continuing through the remaining
                    videos. It does not change video eligibility, start a run,
                    recall online-only files, or delete old proxies. Leave it
                    enabled during a small acceptance test.
                </p>
            </fieldset>
            <fieldset class="review-filter-panel">
                <legend class="field-label">Video proxy encoding</legend>
                <label class="field-label" for="video-processing-encoding-profile">
                    Output quality and size
                </label>
                <select id="video-processing-encoding-profile"
                        @bind="EncodingProfile" disabled="@Saving">
                    <option value="standard-720p">Standard 720p — current default</option>
                    <option value="compact-540p">Compact 540p — smaller picture / lower bitrate</option>
                </select>
                <p class="field-help">
                    Both are bounded SDR H.264/AAC MP4 presets with fast-start
                    seeking and automatic orientation. The compact preset may
                    reduce file size and detail; actual quality and encoding
                    time will be measured on local videos. Selecting a different
                    preset creates a distinct durable job for that source
                    revision; it never rewrites existing proxies or starts
                    processing on its own. Pause active video processing
                    before changing profiles.
                </p>
            </fieldset>
            <fieldset class="review-filter-panel">
                <legend class="field-label">Manual proxy retention</legend>
                <label class="field-label" for="video-processing-retention-age">
                    Protect valid generated proxies for at least
                </label>
                <select id="video-processing-retention-age"
                        @bind="RetentionAgeHours" disabled="@Saving">
                    <option value="48">48 hours</option>
                    <option value="168">7 days</option>
                    <option value="720">30 days</option>
                </select>
                <p class="field-help">
                    This applies only when you explicitly preview and confirm
                    proxy cleanup after stopping video processing. Invalid
                    or excluded registered copies may be removed earlier
                    for privacy and integrity. Nothing is deleted on Save.
                </p>
            </fieldset>
            <fieldset class="review-filter-panel">
                <legend class="field-label">Local video proxy storage</legend>
                <label class="field-label" for="video-processing-quota-override">
                    <input id="video-processing-quota-override" type="checkbox"
                           @bind="OverrideProxyLimits" disabled="@Saving" />
                    Override launcher proxy limits
                </label>
                <p class="field-help">
                    Optional. When unchecked, the application uses its existing
                    launcher configuration, if any. Quotas affect newly published
                    video proxies only; they do not delete existing proxies,
                    measure temporary files, or change original photos/videos.
                </p>
                <div class="review-filter-grid">
                    <div>
                        <label class="field-label" for="video-processing-cache-mib">
                            Total registered proxies (MiB, 64–16384)
                        </label>
                        <input id="video-processing-cache-mib" type="number"
                               min="64" max="16384" step="1"
                               @bind="MaximumCacheMiB"
                               disabled="@(Saving || !OverrideProxyLimits)"
                               required="@OverrideProxyLimits" />
                    </div>
                    <div>
                        <label class="field-label" for="video-processing-proxy-mib">
                            Maximum single proxy (MiB, 1–256)
                        </label>
                        <input id="video-processing-proxy-mib" type="number"
                               min="1" max="256" step="1"
                               @bind="MaximumProxyMiB"
                               disabled="@(Saving || !OverrideProxyLimits)"
                               required="@OverrideProxyLimits" />
                    </div>
                </div>
                <p class="field-help">
                    These limits take effect for the next video attempt.
                    If the configured space is unavailable, publication is
                    rejected; automatic eviction is not enabled. Pause the
                    Archive run before changing the limits.
                </p>
            </fieldset>
            <div class="card-actions">
                <button class="button primary" type="submit" disabled="@Saving">
                    @(Saving ? "Saving…" : "Save video settings")
                </button>
            </div>
            <p class="field-help">
                These preferences are saved immediately. Use Advance archive
                to start processing; use Pause archive to interrupt it.
                An interrupted video restarts from scratch when retried.
            </p>
        </form>

        @if (!Status.ToolsConfigured)
        {
            <div class="notice warning">
                Video execution is not configured. Add approved FFmpeg/FFprobe
                executable paths and SHA-256 hashes in application configuration.
                No video runs until those tools are configured.
            </div>
        }

        <section class="review-filter-panel" aria-labelledby="video-retention-heading">
            <h3 id="video-retention-heading">Review local proxy cleanup</h3>
            <p class="field-help">
                Only app-generated, registered video proxy copies are eligible.
                The review checks up to 8 registered entries using their
                stored SHA-256 hashes. Copies younger than 48 hours are
                protected unless they are already invalid. Originals are
                never deleted. The video lane must be fully disabled and
                paused, with no running jobs. Cleanup never runs automatically.
            </p>
            <button class="button secondary" type="button"
                    disabled="@(Saving || Enabled || Status.Enabled || Status.Processing)"
                    @onclick="PreviewRetentionAsync">
                Preview proxy cleanup
            </button>
            @if (RetentionPreview is { } plan)
            {
                <div class="field-help" role="status">
                    Review: @plan.Planned registered copies eligible,
                    @plan.QuotaSelected due to the configured quota,
                    @plan.Invalid invalid, @plan.Missing missing and
                    @plan.Corrupt corrupt; estimated registered bytes after:
                    @plan.ProjectedBytesAfter.
                    @(plan.MoreCandidates ? "Additional records may need another bounded review." : "")
                </div>
                @if (plan.Planned > 0 && plan.PlanFingerprint is not null)
                {
                    <label class="field-label" for="video-retention-confirm">
                        <input id="video-retention-confirm" type="checkbox"
                               @bind="ConfirmRetention" disabled="@Saving" />
                        I understand that these generated proxy copies will be
                        revoked and removed, and regeneration may be required.
                    </label>
                    <button type="button" class="button secondary"
                            disabled="@(Saving || !ConfirmRetention || Enabled || Status.Enabled || Status.Processing)"
                            @onclick="ApplyRetentionAsync">
                        Confirm removal of @plan.Planned generated copies
                    </button>
                }
                else
                {
                    <p class="field-help">No eligible registered copies in this bounded review.</p>
                }
                <p class="field-help">A preview expires after at most five minutes,
                   and any changed plan must be previewed again.</p>
            }
            @if (RetentionApplied is { } completed)
            {
                <p class="field-help" role="status">
                    Revoked @completed.Revoked registered receipts;
                    deleted @completed.FilesDeleted private files;
                    @completed.DeleteFailures deletions require recovery review.
                    Originals were not selected for deletion.
                </p>
            }
        </section>

        <p class="field-help">Last processing result: <code>@Status.LastResult</code></p>
        <h3>Video queue</h3>
        <div class="review-filter-grid">
            <div><span class="field-label">Pending</span><strong>@Status.Queued</strong></div>
            <div><span class="field-label">Processing</span><strong>@(Status.Processing ? "Yes" : "No")</strong></div>
            <div><span class="field-label">Completed</span><strong>@Status.Succeeded</strong></div>
            <div><span class="field-label">Failed</span><strong>@Status.Failed</strong></div>
            <div><span class="field-label">Cancelled</span><strong>@Status.Cancelled</strong></div>
            <div><span class="field-label">Recovery needed</span><strong>@Status.ExpiredLeases</strong></div>
        </div>
        @if (Status.Recent is { Count: > 0 })
        {
            <h3>Recent video jobs</h3>
            <div class="archive-table-wrap">
                <table class="archive-table">
                    <thead>
                        <tr><th>Job</th><th>Status</th><th>Attempts</th>
                            <th>Progress</th><th>Failure</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach (VideoJobRow job in Status.Recent)
                        {
                            <tr>
                                <td><code>@job.JobId.ToString("N")[..8]</code></td>
                                <td>@job.Status</td>
                                <td>@job.Attempts</td>
                                <td>@job.ProgressPercent%</td>
                                <td>@(job.FailureCode ?? "—")</td>
                                <td>
                                    @if (job.Status is "failed" or "cancelled")
                                    {
                                        <button class="button secondary" disabled="@Saving"
                                                @onclick="() => RetryAsync(job.JobId)">
                                            Retry
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <button class="button secondary" disabled="@Saving" @onclick="LoadAsync">
            Refresh video status
        </button>
    }
</section>

@code {
    [Parameter] public int RefreshVersion { get; set; }

    private sealed record VideoJobRow(
        Guid JobId, string Status, int Attempts, int ProgressPercent,
        bool CancellationRequested, string? FailureCode);
    private sealed record VideoSettingsResponse(
        bool Enabled, bool IncludeOnlineOnly,
        int? MaximumCacheMiB, int? MaximumProxyMiB,
        string EncodingProfile, int RetentionAgeHours,
        bool StopAfterOneVideoStepPerAdvance,
        bool Processing, bool ToolsConfigured,
        long Queued, long Running, long Succeeded,
        long Failed, long Cancelled, long ExpiredLeases,
        string LastResult, IReadOnlyList<VideoJobRow> Recent);
    private sealed record VideoRetentionReport(
        bool DryRun, int Inspected, int Planned, int Invalid, int Missing,
        int Corrupt, int QuotaSelected, int Revoked, int FilesDeleted,
        int DeleteFailures, long RegisteredBytesBefore,
        long ProjectedBytesAfter, bool MoreCandidates, string? PlanFingerprint);
    private sealed record VideoRetentionApplyRequest(string ConfirmationFingerprint);

    private sealed record VideoSettingsUpdate(
        bool Enabled, bool IncludeOnlineOnly,
        int? MaximumCacheMiB, int? MaximumProxyMiB,
        bool OverrideProxyLimits, string EncodingProfile,
        int RetentionAgeHours, bool StopAfterOneVideoStepPerAdvance);
    private sealed record ErrorResponse(string Error);

    private VideoSettingsResponse? Status;
    private VideoRetentionReport? RetentionPreview;
    private VideoRetentionReport? RetentionApplied;
    private bool ConfirmRetention;
    private bool Enabled;
    private bool IncludeOnlineOnly;
    private bool OverrideProxyLimits;
    private string EncodingProfile = "standard-720p";
    private int RetentionAgeHours = 48;
    private bool StopAfterOneVideoStepPerAdvance;
    private int? MaximumCacheMiB = 1024;
    private int? MaximumProxyMiB = 256;
    private bool Loading = true;
    private bool Saving;
    private string? Error;
    private string? Message;
    private int LoadedVersion = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (LoadedVersion == RefreshVersion) return;
        LoadedVersion = RefreshVersion;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        Error = null;
        RetentionPreview = null;
        ConfirmRetention = false;
        try
        {
            Status = await Http.GetFromJsonAsync<VideoSettingsResponse>(
                "api/video-processing/settings");
            if (Status is not null)
            {
                Enabled = Status.Enabled;
                IncludeOnlineOnly = Status.IncludeOnlineOnly;
                EncodingProfile = Status.EncodingProfile;
                RetentionAgeHours = Status.RetentionAgeHours;
                StopAfterOneVideoStepPerAdvance =
                    Status.StopAfterOneVideoStepPerAdvance;
                OverrideProxyLimits = Status.MaximumCacheMiB.HasValue &&
                                      Status.MaximumProxyMiB.HasValue;
                MaximumCacheMiB = Status.MaximumCacheMiB ?? 1024;
                MaximumProxyMiB = Status.MaximumProxyMiB ?? 256;
            }
        }
        catch (Exception)
        {
            Error = "Video settings could not be loaded.";
        }
        finally { Loading = false; }
    }

    private async Task RetryAsync(Guid jobId)
    {
        Error = null;
        Message = null;
        Saving = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsync(
                $"api/video-processing/jobs/{jobId:D}/retry", null);
            if (!response.IsSuccessStatusCode)
            {
                Error = "This job cannot be restarted. It may have changed, been excluded, or already completed.";
                return;
            }
            Message = "Video queued for a fresh attempt. Start Advance archive to process it.";
            await LoadAsync();
        }
        catch (Exception)
        {
            Error = "Video retry request failed.";
        }
        finally { Saving = false; }
    }

    private async Task PreviewRetentionAsync()
    {
        Error = null;
        Message = null;
        RetentionPreview = null;
        RetentionApplied = null;
        ConfirmRetention = false;
        Saving = true;
        try
        {
            using HttpResponseMessage response = await Http.PostAsync(
                "api/video-processing/retention/preview", null);
            if (!response.IsSuccessStatusCode)
            {
                Error = "Proxy cleanup needs configured limits and a fully stopped, disabled video lane. Verify that the private cache is valid.";
                return;
            }
            RetentionPreview = await response.Content.ReadFromJsonAsync<VideoRetentionReport>();
            if (RetentionPreview is null || !RetentionPreview.DryRun)
            {
                RetentionPreview = null;
                Error = "The retention preview returned unexpected data.";
            }
        }
        catch (Exception)
        {
            Error = "Video proxy retention preview failed. No removal was requested.";
        }
        finally { Saving = false; }
    }

    private async Task ApplyRetentionAsync()
    {
        string? fingerprint = RetentionPreview?.PlanFingerprint;
        if (!ConfirmRetention || Enabled || Status?.Enabled != false ||
            Status.Processing || RetentionPreview?.Planned is not > 0 ||
            fingerprint is null)
            return;

        Saving = true;
        Error = null;
        Message = null;
        // A confirmation is never silently reusable after an API failure.
        RetentionPreview = null;
        ConfirmRetention = false;
        try
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                "api/video-processing/retention/apply",
                new VideoRetentionApplyRequest(fingerprint));
            if (!response.IsSuccessStatusCode)
            {
                Error = "Cleanup was refused or could not fully complete. Review the stopped lane and run a new preview before retrying.";
                return;
            }
            VideoRetentionReport? applied =
                await response.Content.ReadFromJsonAsync<VideoRetentionReport>();
            if (applied is null || applied.DryRun)
            {
                Error = "Cleanup did not return a final report. Review private cache maintenance before retrying.";
                return;
            }
            await LoadAsync();
            RetentionApplied = applied;
            Message = "Generated proxy cleanup finished. Existing originals were not modified.";
        }
        catch (Exception)
        {
            Error = "Cleanup status is uncertain. Recheck the current cache before another attempt.";
        }
        finally { Saving = false; }
    }

    private async Task SaveAsync()
    {
        // A previous reviewed plan is never valid after a Settings submit.
        RetentionPreview = null;
        ConfirmRetention = false;
        RetentionApplied = null;
        Error = null;
        Message = null;
        Saving = true;
        try
        {
            using HttpResponseMessage response = await Http.PutAsJsonAsync(
                "api/video-processing/settings",
                new VideoSettingsUpdate(Enabled, IncludeOnlineOnly,
                    OverrideProxyLimits ? MaximumCacheMiB : null,
                    OverrideProxyLimits ? MaximumProxyMiB : null,
                    OverrideProxyLimits, EncodingProfile,
                    RetentionAgeHours, StopAfterOneVideoStepPerAdvance));
            if (!response.IsSuccessStatusCode)
            {
                ErrorResponse? failure = null;
                try { failure = await response.Content.ReadFromJsonAsync<ErrorResponse>(); }
                catch { }
                Error = failure?.Error ?? "Video settings could not be saved.";
                return;
            }
            Status = await response.Content.ReadFromJsonAsync<VideoSettingsResponse>();
            if (Status is not null)
            {
                Enabled = Status.Enabled;
                IncludeOnlineOnly = Status.IncludeOnlineOnly;
                EncodingProfile = Status.EncodingProfile;
                RetentionAgeHours = Status.RetentionAgeHours;
                StopAfterOneVideoStepPerAdvance =
                    Status.StopAfterOneVideoStepPerAdvance;
                OverrideProxyLimits = Status.MaximumCacheMiB.HasValue &&
                                      Status.MaximumProxyMiB.HasValue;
                MaximumCacheMiB = Status.MaximumCacheMiB ?? 1024;
                MaximumProxyMiB = Status.MaximumProxyMiB ?? 256;
            }
            Message = "Video settings saved.";
        }
        catch (Exception)
        {
            Error = "Video settings could not be saved.";
        }
        finally { Saving = false; }
    }
}
