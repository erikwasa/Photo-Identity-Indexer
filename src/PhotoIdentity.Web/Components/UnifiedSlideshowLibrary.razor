@using System.Net.Http.Json
@using PhotoIdentity.Web.Contracts
@inject HttpClient Http
@inject SlideshowLibrarySessionState Session
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

@if (HasPartialFailure)
{
    <div class="notice" role="status">
        Some slideshows are temporarily unavailable. Showing the ones that are available.
    </div>
}

@if ((CatalogueLoading || _loadingCreative) && Items.Count == 0)
{
    <section class="slideshow-library-state" role="status">
        <div class="spinner" aria-hidden="true"></div>
        <p>Finding your slideshows…</p>
    </section>
}
else if (HasFailure && Items.Count == 0)
{
    <section class="slideshow-library-state" role="alert">
        <strong>Slideshows could not be loaded</strong>
        <p>They are temporarily unavailable.</p>
        <button type="button" class="button secondary" disabled="@_refreshing" @onclick="RefreshAsync">
            @(_refreshing ? "Checking…" : "Try again")
        </button>
    </section>
}
else if (Items.Count == 0)
{
    <section class="slideshow-library-state">
        <h2>No slideshows yet</h2>
        <p>Saved slideshows will appear here when they are available.</p>
    </section>
}
else
{
    <section class="slideshow-library-grid" aria-label="Slideshows">
        @foreach (SlideshowLibraryItem item in Items)
        {
            SlideshowOriginalPreparationResponse? preparation = PreparationFor(item);
            bool preparing = preparation?.State == "preparing";
            bool needsAttention = item.SupportsPreparation && SlideshowPreparationExperience.NeedsParentAttention(preparation);
            bool starting = IsStarting(item);
            bool busy = IsBusy(item);
            bool prepared = item.SupportsPreparation && SlideshowLibraryPresentation.ShowPreparedIndicator(preparation?.State, busy);
            string? quantityLabel = QuantityLabel(item);

            <article @key="item.Key" class="slideshow-library-card">
                <button type="button"
                        class="slideshow-library-primary"
                        disabled="@busy"
                        aria-label="@SlideshowLibraryPresentation.PlayAriaLabel(item.Name, quantityLabel, prepared)"
                        @onclick="() => StartAsync(item)">
                    <SlideshowLibraryCover CollectionId="@item.CoverCollectionId"
                                           Manual="@item.Manual"
                                           CoverRevisionId="@item.CoverRevisionId"
                                           PhotoCountChanged="@(count => SetSmartPhotoCountAsync(item, count))" />
                    <span class="slideshow-library-card-shade" aria-hidden="true"></span>
                    <span class="slideshow-library-card-copy">
                        @if (!string.IsNullOrWhiteSpace(quantityLabel) || prepared)
                        {
                            <span class="slideshow-library-card-meta">
                                @if (!string.IsNullOrWhiteSpace(quantityLabel))
                                {
                                    <span class="slideshow-library-card-badge">@quantityLabel</span>
                                }
                                @if (prepared)
                                {
                                    <span class="slideshow-library-card-badge slideshow-library-card-badge-prepared">
                                        <span aria-hidden="true">✓</span>
                                        <span>Prepared</span>
                                    </span>
                                }
                            </span>
                        }
                        <span class="slideshow-library-card-title">@item.Name</span>
                        @if (!string.IsNullOrWhiteSpace(item.SourceCollectionName))
                        {
                            <span class="slideshow-library-card-kind">From @item.SourceCollectionName</span>
                        }
                        <span class="slideshow-library-card-cue">
                            <span class="slideshow-library-play-mark" aria-hidden="true">▶</span>
                            @if (starting)
                            {
                                <span>Starting…</span>
                            }
                            else if (needsAttention)
                            {
                                <span>Parent attention needed</span>
                            }
                            else if (preparing)
                            {
                                <span>Getting originals ready…</span>
                            }
                            else
                            {
                                <span>Play slideshow</span>
                            }
                        </span>
                    </span>
                </button>
            </article>
        }
    </section>
}

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly Dictionary<string, int> _smartPhotoCounts = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _launching = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<SlideshowLibraryItem> Items { get; set; } = [];
    private bool _loadingCreative;
    private bool _creativeRefreshFailed;
    private bool _refreshing;

    [Parameter]
    public bool CatalogueLoading { get; set; }

    [Parameter]
    public string? CatalogueError { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public Func<string, SlideshowOriginalPreparationResponse?>? PreparationLookup { get; set; }

    [Parameter]
    public Func<string, bool>? BusyLookup { get; set; }

    [Parameter]
    public Func<string, bool>? StartingLookup { get; set; }

    private bool HasFailure => !string.IsNullOrWhiteSpace(CatalogueError) || _creativeRefreshFailed;
    private bool HasPartialFailure => HasFailure && Items.Count > 0 && !CatalogueLoading && !_loadingCreative;

    protected override async Task OnInitializedAsync()
    {
        RefreshItems();
        await LoadCreativeAsync();
    }

    protected override void OnParametersSet()
    {
        RefreshItems();
    }

    private async Task LoadCreativeAsync()
    {
        _loadingCreative = Session.CreativeCollections is null;
        _creativeRefreshFailed = false;
        RefreshItems();

        try
        {
            CreativeCollectionRecipeResponse[] fresh =
                await Http.GetFromJsonAsync<CreativeCollectionRecipeResponse[]>(
                    "api/creative-collections",
                    _lifetime.Token)
                ?? [];
            Session.CreativeCollections = fresh;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            return;
        }
        catch
        {
            _creativeRefreshFailed = true;
        }
        finally
        {
            _loadingCreative = false;
            RefreshItems();
        }
    }

    private void RefreshItems()
    {
        Items = SlideshowLibraryCatalogue.Combine(
            Session.SmartCollections ?? [],
            Session.ManualCollections ?? [],
            Session.CreativeCollections ?? []);
    }

    private async Task RefreshAsync()
    {
        if (_refreshing || _lifetime.IsCancellationRequested)
        {
            return;
        }

        _refreshing = true;
        try
        {
            if (RefreshRequested.HasDelegate)
            {
                await RefreshRequested.InvokeAsync();
            }

            await LoadCreativeAsync();
            RefreshItems();
        }
        finally
        {
            _refreshing = false;
        }
    }

    private SlideshowOriginalPreparationResponse? PreparationFor(SlideshowLibraryItem item) =>
        item.SupportsPreparation ? PreparationLookup?.Invoke(item.Id) : null;

    private bool IsBusy(SlideshowLibraryItem item) =>
        _launching.Contains(item.Key) ||
        (item.SupportsPreparation && BusyLookup?.Invoke(item.Id) == true);

    private bool IsStarting(SlideshowLibraryItem item) =>
        _launching.Contains(item.Key) ||
        (item.SupportsPreparation && StartingLookup?.Invoke(item.Id) == true);

    private string? QuantityLabel(SlideshowLibraryItem item)
    {
        if (item.Creative)
        {
            return item.CreativeTargetCount is > 0
                ? SlideshowLibraryPresentation.CreativeTargetLabel(item.CreativeTargetCount.Value)
                : null;
        }

        int? count = item.Manual
            ? item.PhotoCount
            : _smartPhotoCounts.GetValueOrDefault(item.Id);
        return count.HasValue
            ? SlideshowLibraryPresentation.PhotoCountLabel(count.Value)
            : null;
    }

    private Task SetSmartPhotoCountAsync(SlideshowLibraryItem item, int? count)
    {
        if (item.Kind != SlideshowLibraryItemKind.Smart)
        {
            return Task.CompletedTask;
        }

        if (count.HasValue)
        {
            _smartPhotoCounts[item.Id] = count.Value;
        }
        else
        {
            _smartPhotoCounts.Remove(item.Id);
        }

        return Task.CompletedTask;
    }

    private async Task StartAsync(SlideshowLibraryItem item)
    {
        if (IsBusy(item) || !_launching.Add(item.Key))
        {
            return;
        }

        try
        {
            _ = await SlideshowLibraryLaunch.RequestFullscreenAndNavigateAsync(
                JS,
                Navigation,
                item.Id,
                "/slideshows",
                manual: item.Manual,
                creative: item.Creative);
        }
        finally
        {
            _launching.Remove(item.Key);
        }
    }

    public ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
