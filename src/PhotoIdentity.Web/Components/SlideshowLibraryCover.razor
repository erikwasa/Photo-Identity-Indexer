@using System.Net.Http.Json
@using PhotoIdentity.Web.Contracts
@inject HttpClient Http
@implements IAsyncDisposable

<div class="slideshow-library-cover" aria-hidden="true">
    @if (!string.IsNullOrWhiteSpace(_coverUrl))
    {
        <img class="slideshow-library-cover-image"
             src="@_coverUrl"
             alt=""
             loading="lazy"
             decoding="async"
             @onerror="OnImageError" />
    }
    else
    {
        <div class="slideshow-library-cover-fallback">
            <span class="slideshow-library-cover-mark">PI</span>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private string? _loadedCollectionId;
    private string? _coverUrl;

    [Parameter, EditorRequired]
    public string CollectionId { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(CollectionId) ||
            string.Equals(_loadedCollectionId, CollectionId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _loadedCollectionId = CollectionId;
        _coverUrl = null;

        try
        {
            SmartCollectionPageResponse? page = await Http.GetFromJsonAsync<SmartCollectionPageResponse>(
                $"api/smart-collections/{Uri.EscapeDataString(CollectionId)}/query?offset=0&limit=1",
                _lifetime.Token);
            _coverUrl = SlideshowLibraryPresentation.SelectCoverThumbnailUrl(page);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch
        {
            // Covers are decorative. A failed or empty query keeps the stable neutral fallback.
        }
    }

    private void OnImageError()
    {
        _coverUrl = null;
    }

    public ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
