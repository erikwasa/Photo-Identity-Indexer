@using System.Net.Http.Json
@using PhotoIdentity.Web.Contracts
@inject SlideshowLibrarySessionState Session
@implements IAsyncDisposable

<div class="slideshow-library-cover" aria-hidden="true">
    @if (!string.IsNullOrWhiteSpace(_coverUrl))
    {
        <img class="slideshow-library-cover-image"
             src="@_coverUrl"
             alt=""
             loading="lazy"
             decoding="async"
             @onerror="OnImageError" />
    }
    else
    {
        <div class="slideshow-library-cover-fallback">
            <span class="slideshow-library-cover-mark">PI</span>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private string? _loadedKey;
    private string? _coverUrl;

    [Parameter, EditorRequired]
    public string CollectionId { get; set; } = string.Empty;

    [Parameter]
    public bool Manual { get; set; }

    [Parameter]
    public string? CoverRevisionId { get; set; }

    [Parameter]
    public EventCallback<int?> PhotoCountChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        string key = $"{CollectionId}|{Manual}|{CoverRevisionId}";
        if (string.IsNullOrWhiteSpace(CollectionId) ||
            string.Equals(_loadedKey, key, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _loadedKey = key;
        _coverUrl = null;

        if (Manual)
        {
            if (!string.IsNullOrWhiteSpace(CoverRevisionId))
            {
                _coverUrl =
                    $"/api/collections/photos/{Uri.EscapeDataString(CoverRevisionId)}/thumbnail";
            }

            return;
        }

        try
        {
            SmartCollectionPageResponse? cached = Session.CachedCover(CollectionId);
            if (cached is not null)
            {
                _coverUrl = SlideshowLibraryPresentation.SelectCoverThumbnailUrl(cached);
                await PhotoCountChanged.InvokeAsync(SlideshowLibraryPresentation.SmartPhotoCount(cached));
            }
            SmartCollectionPageResponse? page = await Session.GetCoverAsync(CollectionId, _lifetime.Token);
            _coverUrl = SlideshowLibraryPresentation.SelectCoverThumbnailUrl(page);
            await PhotoCountChanged.InvokeAsync(SlideshowLibraryPresentation.SmartPhotoCount(page));
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch
        {
            if (_coverUrl is null)
            {
                await PhotoCountChanged.InvokeAsync(null);
            }
            // Covers and counts are decorative. A failed query keeps the card playable and the
            // stable neutral cover fallback.
        }
    }

    private void OnImageError()
    {
        _coverUrl = null;
    }

    public ValueTask DisposeAsync()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
