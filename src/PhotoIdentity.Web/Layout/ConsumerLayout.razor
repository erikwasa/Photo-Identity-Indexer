@inherits LayoutComponentBase

<div class="consumer-shell">
    <header class="consumer-topbar">
        <div class="consumer-brand" aria-label="Photo Identity slideshows">
            <span class="consumer-brand-mark">PI</span>
            <span>
                <strong>Photo Identity</strong>
                <small>Slideshows</small>
            </span>
        </div>

        <a class="consumer-app-link"
           href="@AppSurfaceNavigation.FullAppPath"
           aria-label="Open the full Photo Identity application">
            Full app
        </a>
    </header>

    <main class="consumer-content">
        @Body
    </main>

    <footer class="consumer-footer">
        Read-only slideshow surface on the trusted private network.
    </footer>
</div>
