<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- WI-0148: integration tests must not regain retired provider assemblies through app-project transitivity. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PhotoIdentity.Api/PhotoIdentity.Api.csproj" />
    <ProjectReference Include="../../src/PhotoIdentity.Cli/PhotoIdentity.Cli.csproj" />
    <ProjectReference Include="../../src/PhotoIdentity.Core/PhotoIdentity.Core.csproj" />
    <ProjectReference Include="../../src/PhotoIdentity.Imaging.OpenCv/PhotoIdentity.Imaging.OpenCv.csproj" />
    <ProjectReference Include="../../src/PhotoIdentity.Persistence.Postgres/PhotoIdentity.Persistence.Postgres.csproj" />
    <ProjectReference Include="../PhotoIdentity.TestSupport.Postgres/PhotoIdentity.TestSupport.Postgres.csproj" />
    <ProjectReference Include="../../src/PhotoIdentity.Source.Local/PhotoIdentity.Source.Local.csproj" />
    <ProjectReference Include="../../src/PhotoIdentity.Source.OneDriveSync/PhotoIdentity.Source.OneDriveSync.csproj" />
    <ProjectReference Include="../../src/PhotoIdentity.Transfer.Bundles/PhotoIdentity.Transfer.Bundles.csproj" />
    <ProjectReference Include="../../src/PhotoIdentity.Web/PhotoIdentity.Web.csproj" />
    <ProjectReference Include="../../src/PhotoIdentity.Worker/PhotoIdentity.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- WI-0148 retires provider-specific coverage that is superseded by PostgreSQL persistence tests. -->
    <Compile Remove="SqliteCatalogueDatabaseTests.cs" />
    <Compile Remove="SqliteProcessingMigrationTests.cs" />
    <Compile Remove="SqliteIdentityMatcherMigrationTests.cs" />
    <Compile Remove="SqliteDetectorRolloutRepositoryTests.cs" />
    <Compile Remove="SqliteDetectorRolloutReviewRepositoryTests.cs" />
    <Compile Remove="SqliteDetectorRolloutApplicationRepositoryTests.cs" />
    <Compile Remove="SqliteIdentityCatalogueRepositoryTests.cs" />
    <Compile Remove="SqliteIdentityMatcherTests.cs" />
    <Compile Remove="SqliteIdentityAutoAssignmentServiceTests.cs" />
    <Compile Remove="IdentityMatchRegenerationTests.cs" />
    <Compile Remove="SqliteProcessingRepositoryTests.cs" />
    <!-- Face inspection current behavior is covered by PostgresFaceInspectionRepositoryTests; the old suite also asserted SQLite exception codes and an inconsistent graph shape that FaceInspectionWrite no longer permits. -->
    <Compile Remove="SqliteFaceCatalogueRepositoryTests.cs" />
    <!-- The retired file-database match command was a SQLite-only normal-operation surface. -->
    <Compile Remove="MatchCommandTests.cs" />
    <!-- The stopped-source .db/PRAGMA backup path is migration-era SQLite tooling, not supported PostgreSQL behavior. -->
    <Compile Remove="CatalogueBackupCommandTests.cs" />
  </ItemGroup>
</Project>
